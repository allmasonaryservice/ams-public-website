  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.wcu-btn-primary {
  display: inline-flex;
  align-items: center;
  height: 44px;
  padding: 0 24px;
  background: #D4A931;
  color: #1A1A1A;
  font-family: 'Satoshi', sans-serif;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
  border: 2px solid #D4A931;
  transition: background 200ms ease, border-color 200ms ease;
}
.wcu-btn-primary:hover {
  background: #B8932A;
  border-color: #B8932A;
}
.wcu-btn-primary:focus-visible {
  outline: 2px solid #D4A931;
  outline-offset: 2px;
}

.wcu-btn-outline {
  display: inline-flex;
  align-items: center;
  height: 44px;
  padding: 0 24px;
  background: transparent;
  color: #1A1A1A;
  font-family: 'Satoshi', sans-serif;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
  border: 2px solid #1A1A1A;
  transition: background 200ms ease, color 200ms ease;
}
.wcu-btn-outline:hover {
  background: #1A1A1A;
  color: #D4A931;
}
.wcu-btn-outline:focus-visible {
  outline: 2px solid #D4A931;
  outline-offset: 2px;
}

/* Mobile image slot — hidden on desktop */
.wcu-mobile-img { display: none; }

/* ── RIGHT: Zigzag Split-Frame Engine ── */
.wcu-right {
  flex: 0 0 500px;
  max-width: 500px;
  display: flex;
  justify-content: flex-end;
}

.wcu-engine {
  position: relative;
  width: 90%;
  aspect-ratio: 4/3;
  cursor: pointer;
  margin: 40px 40px 40px 0;
  overflow: visible;
}

/* Core (inner image) */
.wcu-core {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background: #1A1A1A;
  z-index: 0;
}
.wcu-core-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.3;
  transform: scale(1);
  transition: opacity 1.2s ease, transform 2.5s ease;
  display: block;
}
.wcu-engine.is-open .wcu-core-img {
  opacity: 1;
  transform: scale(1.08);
}

.wcu-core-veil {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.4);
  transition: opacity 1s ease;
}
.wcu-engine.is-open .wcu-core-veil {
  opacity: 0;
}

/* Zigzag panels */
.wcu-panel {
  position: absolute;
  inset: 0;
  overflow: hidden;
  transition: transform 1s cubic-bezier(0.25, 1, 0.5, 1),
              filter 1s ease;
}
.wcu-panel-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.wcu-panel-shade {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0);
  transition: background 1s ease;
}

.wcu-panel-tl {
  clip-path: polygon(0 0, 100% 0, 100% 20%, 80% 20%, 80% 40%, 60% 40%, 60% 60%, 40% 60%, 40% 80%, 20% 80%, 20% 100%, 0 100%);
  z-index: 2;
  filter: drop-shadow(0px 0px 0px rgba(0,0,0,0));
}
.wcu-engine.is-open .wcu-panel-tl {
  transform: translate(-60px, -60px);
  filter: drop-shadow(15px 15px 25px rgba(0,0,0,0.7));
}
.wcu-engine.is-open .wcu-panel-tl .wcu-panel-shade {
  background: rgba(0,0,0,0.3);
}

.wcu-panel-br {
  clip-path: polygon(100% 20%, 100% 100%, 20% 100%, 20% 80%, 40% 80%, 40% 60%, 60% 60%, 60% 40%, 80% 40%, 80% 20%);
  z-index: 1;
  filter: drop-shadow(0px 0px 0px rgba(0,0,0,0));
}
.wcu-engine.is-open .wcu-panel-br {
  transform: translate(60px, 60px);
  filter: drop-shadow(-15px -15px 25px rgba(0,0,0,0.7));
}
.wcu-engine.is-open .wcu-panel-br .wcu-panel-shade {
  background: rgba(0,0,0,0.5);
}

/* Trust stack overlay */
.wcu-trust-stack {
  position: absolute;
  top: 16px;
  left: 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  z-index: 5;
  pointer-events: none;
  opacity: 0;
  transform: translateY(8px);
  transition: opacity 0.6s ease 0.4s, transform 0.6s ease 0.4s;
}
.wcu-engine.is-open .wcu-trust-stack {
  opacity: 1;
  transform: translateY(0);
}
.wcu-trust-chip {
  background: rgba(26,26,26,0.88);
  border-left: 3px solid #D4A931;
  color: #F5F3EF;
  font-family: 'Satoshi', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 5px 10px;
  white-space: nowrap;
}

/* Floating badge */
.wcu-badge {
  position: absolute;
  bottom: -36px;
  right: -36px;
  background: #1A1A1A;
  border: 2px solid #D4A931;
  padding: 16px 20px;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  transition: transform 1s cubic-bezier(0.25, 1, 0.5, 1);
}
.wcu-engine.is-open .wcu-badge {
  transform: translate(8px, 8px);
}
.wcu-badge-num {
  font-family: 'Fraunces', serif;
  font-size: 32px;
  font-weight: 900;
  color: #D4A931;
  line-height: 1;
}
.wcu-badge-label {
  font-family: 'Satoshi', sans-serif;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #8B8070;
  margin-top: 4px;
  line-height: 1.4;
}

/* scroll animations handled by GSAP section-transitions.ts */

/* ── RESPONSIVE ── */
@media (max-width: 1100px) {
  .wcu-container { padding: 0 40px; gap: 48px; }
  .wcu-right { flex: 0 0 420px; max-width: 420px; }
}

@media (max-width: 900px) {
  .wcu-section { padding: 72px 0; }
  .wcu-container {
    flex-direction: column;
    padding: 0 40px;
    gap: 0;
  }
  .wcu-right { display: none; }
  .wcu-body { margin-bottom: 0; }
  .wcu-mobile-img {
    display: block;
    padding: 0 32px 80px;
    margin-top: 56px;
  }
  .wcu-engine--mobile {
    width: 100%;
    margin: 0 auto;
    overflow: visible;
  }
}

@media (max-width: 640px) {
  .wcu-section { padding: 56px 0; }
  .wcu-container { padding: 0 20px; }
  .wcu-features { grid-template-columns: 1fr; gap: 20px; }
  .wcu-heading { font-size: 28px; }
  .wcu-engine { width: 95%; }
  .wcu-badge { bottom: -24px; right: -8px; padding: 12px 14px; }
  .wcu-badge-num { font-size: 24px; }
  .wcu-stats { flex-direction: column; gap: 16px; }
  .wcu-stat-divider { width: 100%; height: 1px; }
  .wcu-stat { padding: 0; }
  .wcu-cta-row { flex-direction: column; align-items: flex-start; }
}
</style>

<script is:inline>
(function() {
  if (!document.getElementById('why-choose-us')) return;

  // All DOM lookups live — closure refs go stale after ViewTransition
  function getEngine() { return document.getElementById('wcu-engine'); }
  function getEngMobile() { return document.getElementById('wcu-engine-mobile'); }
  function getActiveEngine() {
    var m = getEngMobile();
    return (m && m.offsetParent !== null) ? m : getEngine();
  }

  function setOpen(val) {
    var e = getActiveEngine();
    if (!e) return;
    if (val) { e.classList.add('is-open'); } else { e.classList.remove('is-open'); }
  }

  function onScroll(currentY) {
    var e = getActiveEngine();
    if (!e) return;
    var rect = e.getBoundingClientRect();
    var inView = rect.top < window.innerHeight && rect.bottom > 0;
    if (inView) {
      if (currentY - window.__wcuLastY > 4)      { window.__wcuScrolledOpen = true; }
      else if (window.__wcuLastY - currentY > 4) { window.__wcuScrolledOpen = false; }
      if (!window.__wcuHovered) setOpen(window.__wcuScrolledOpen);
    }
    window.__wcuLastY = currentY;
  }

  // Init persistent state on first load only
  if (window.__wcuLastY === undefined) window.__wcuLastY = window.scrollY;
  if (window.__wcuScrolledOpen === undefined) window.__wcuScrolledOpen = false;
  if (window.__wcuHovered === undefined) window.__wcuHovered = false;

  // Native scroll — register only once, uses live DOM + global state
  if (!window.__wcuScrollRegistered) {
    window.__wcuScrollRegistered = true;
    window.addEventListener('scroll', function() {
      if (!document.getElementById('wcu-engine') && !document.getElementById('wcu-engine-mobile')) return;
      onScroll(window.scrollY);
    }, { passive: true });
  }

  // Lenis hook — replace handler on every navigation (new Lenis instance)
  function hookLenis() {
    var lenis = window.__lenis;
    if (!lenis) return;
    if (window.__wcuLenisHandler) {
      try { lenis.off('scroll', window.__wcuLenisHandler); } catch(e) {}
    }
    window.__wcuLenisHandler = function(ev) { onScroll(ev.scroll); };
    lenis.on('scroll', window.__wcuLenisHandler);
  }

  window.removeEventListener('animations:ready', window.__wcuAnimReady);
  window.__wcuAnimReady = hookLenis;
  window.addEventListener('animations:ready', window.__wcuAnimReady);
  if (window.__lenis) hookLenis();

  // Hover — re-register on every navigation (new DOM elements each time)
  var eng = getEngine();
  var engM = getEngMobile();
  [eng, engM].forEach(function(e) {
    if (!e) return;
    e.addEventListener('mouseenter', function() { window.__wcuHovered = true; setOpen(true); });
    e.addEventListener('mouseleave', function() { window.__wcuHovered = false; setOpen(window.__wcuScrolledOpen); });
  });
})();
</script>
