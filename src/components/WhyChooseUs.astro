  padding: 0 80px;
  display: flex;
  align-items: center;
  gap: 80px;
}

/* ── LEFT ── */
.wcu-left {
  flex: 1;
  min-width: 0;
}

.wcu-label {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 20px;
  font-family: 'Satoshi', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #D4A931;
}

.wcu-heading {
  font-family: 'Fraunces', serif;
  font-size: clamp(30px, 3.8vw, 48px);
  line-height: 1.15;
  color: #1A1A1A;
  font-weight: 700;
  margin: 0 0 24px 0;
}
.wcu-heading-italic {
  font-style: italic;
  font-weight: 400;
  color: #1A1A1A;
}
.wcu-heading-gold {
  color: #D4A931;
  font-weight: 900;
}

.wcu-body {
  font-family: 'Satoshi', sans-serif;
  font-size: 15px;
  font-weight: 400;
  color: #4A4A4A;
  line-height: 1.75;
  margin: 0 0 32px 0;
  max-width: 500px;
}

/* Stats row */
.wcu-stats {
  display: flex;
  align-items: center;
  gap: 0;
  margin-bottom: 36px;
  padding: 20px 0;
  border-top: 1px solid #D8D2C8;
  border-bottom: 1px solid #D8D2C8;
}

.wcu-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 0 20px;
}
.wcu-stat:first-child { padding-left: 0; }

.wcu-stat-num {
  font-family: 'Fraunces', serif;
  font-size: clamp(28px, 3vw, 38px);
  font-weight: 900;
  color: #D4A931;
  line-height: 1;
}
.wcu-stat-desc {
  font-family: 'Satoshi', sans-serif;
  font-size: 11px;
  font-weight: 600;
  color: #8B8070;
  line-height: 1.4;
