  margin-bottom: 32px;
}

.wcu-feature {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}

.wcu-icon-wrap {
  width: 40px;
  height: 40px;
  background: #D4A931;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.wcu-feature-title {
  display: block;
  font-family: 'Satoshi', sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.4;
}
.wcu-feature-sub {
  display: block;
  font-family: 'Satoshi', sans-serif;
  font-size: 11px;
  font-weight: 400;
  color: #8B8070;
  line-height: 1.4;
  margin-top: 2px;
}

/* Testimonial */
.wcu-testimonial {
  display: flex;
  gap: 16px;
  margin-bottom: 36px;
  background: #FFFFFF;
  border: 1px solid #D8D2C8;
  padding: 20px 20px 20px 0;
}

.wcu-testimonial-bar {
