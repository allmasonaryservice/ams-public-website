---
// AboutSection — All Masonry Services Inc
// Left: vault-door image animation (scroll + hover triggered)
// Right: heading + 3 stat cards
// AMS Design System: Charcoal #1A1A1A · Gold #D4A931 · border-radius: 0px
---

<section class="about-section" id="about-section">
  <div class="about-container">

    <!-- LEFT: Vault Image Engine -->
    <div class="about-left">
      <div class="about-vault-wrap" id="about-vault">

        <!-- Gold corner accent -->
        <div class="about-corner-tl"></div>
        <div class="about-corner-br"></div>

        <!-- Core image (revealed behind vault doors) -->
        <div class="about-core">
          <picture>
            <source srcset="/images/about-masonry-work-mobile.webp" media="(max-width: 767px)" />
            <img
              src="/images/about-masonry-work.webp"
              alt="All Masonry Services — masonry repair built to last in Chicagoland since 2007"
              width="560"
              height="700"
              loading="eager"
              decoding="async"
              class="about-core-img"
            />
          </picture>
          <!-- fallback -->
          <div class="about-core-fallback">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="1.2" aria-hidden="true">
              <rect x="2" y="3" width="20" height="18"/>
              <path d="M2 8h20M8 3v18M14 3v18" stroke-width="0.8"/>
            </svg>
            <span>Masonry Work</span>
          </div>
          <!-- Dark veil that lifts when vault opens -->
          <div class="about-core-veil" id="about-veil"></div>
          <!-- Gold flash on open -->
          <div class="about-core-flash" aria-hidden="true"></div>
          <!-- Gold border appears when open -->
          <div class="about-core-border" aria-hidden="true"></div>
        </div>

        <!-- Vault Door LEFT -->
        <div class="about-door about-door-left" id="about-door-left">
          <picture>
            <source srcset="/images/about-door-texture-mobile.webp" media="(max-width: 767px)" />
            <img
              src="/images/about-door-texture.webp"
              alt=""
              aria-hidden="true"
              width="560"
              height="700"
              class="about-door-img"
              loading="eager"
            />
          </picture>
          <div class="about-door-light about-door-light-l"></div>
        </div>

        <!-- Vault Door RIGHT -->
        <div class="about-door about-door-right" id="about-door-right">
          <picture>
            <source srcset="/images/about-door-texture-mobile.webp" media="(max-width: 767px)" />
            <img
              src="/images/about-door-texture.webp"
              alt=""
              aria-hidden="true"
              width="560"
              height="700"
              class="about-door-img"
              loading="eager"
            />
          </picture>
          <div class="about-door-light about-door-light-r"></div>
        </div>

      </div>

      <!-- Floating experience badge -->
      <div class="about-exp-badge">
        <span class="about-exp-num">19+</span>
        <span class="about-exp-label">Years of<br>Excellence</span>
      </div>
    </div>

    <!-- RIGHT: Content -->
    <div class="about-right">

      <div class="about-label">
        <span class="about-label-dot">✦</span>
        <span>About Us</span>
      </div>

      <h2 class="about-heading">
        Illinois homeowners trust us when the repair <strong>has to last</strong> —
        <span class="about-heading-sub"> not just survive one more winter.</span>
      </h2>

      <p class="about-body">
        Chicagoland freeze-thaw cycles destroy cheap repairs in 2–3 seasons. Since 2007, All Masonry Services has matched mortar composition, joint depth, and brick color to your original masonry — so the work holds for decades. No shortcuts. No callbacks.
      </p>

      <!-- Stat Cards -->
      <div class="about-stats">

        <div class="about-stat-card">
          <p class="about-stat-label">Serving IL Since</p>
          <p class="about-stat-num">2007</p>
          <p class="about-stat-desc">19+ years in Chicagoland</p>
        </div>

        <div class="about-stat-card">
          <p class="about-stat-label">Homes Restored</p>
          <p class="about-stat-num">500+</p>
          <p class="about-stat-desc">Zero callbacks on record</p>
        </div>

        <div class="about-stat-card">
          <p class="about-stat-label">Google Reviews</p>
          <p class="about-stat-num">4.8★</p>
          <p class="about-stat-desc">92 verified IL homeowners</p>
        </div>

      </div>

      <!-- CTA -->
      <a href="/about" class="about-cta-btn">Our Story</a>

    </div>

  </div>
</section>

<style>
/* ══════════════════════════════════════════
   ABOUT SECTION
══════════════════════════════════════════ */
.about-section {
  background: #E8E4DC;
  padding: 100px 0;
  overflow: hidden;
}

.about-container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 80px;
  display: flex;
  align-items: center;
  gap: 80px;
}

/* ── LEFT: Vault ── */
.about-left {
  flex: 0 0 460px;
  max-width: 460px;
  position: relative;
}

.about-vault-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 4/5;
  cursor: pointer;
  overflow: hidden;
}

/* Gold corner accents */
.about-corner-tl,
.about-corner-br {
  position: absolute;
  width: 64px;
  height: 64px;
  z-index: 4;
  pointer-events: none;
}
.about-corner-tl {
  top: -10px;
  left: -10px;
  border-top: 3px solid #D4A931;
  border-left: 3px solid #D4A931;
}
.about-corner-br {
  bottom: -10px;
  right: -10px;
  border-bottom: 3px solid #D4A931;
  border-right: 3px solid #D4A931;
}

/* Core image */
.about-core {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background: #1A1A1A;
}
.about-core-img {
  width: 100%;
  height: 110%;
  object-fit: cover;
  transform: scale(1) translateY(0px);
  display: block;
}
.about-vault-wrap.vault-open .about-core-img {
  /* parallax JS handles the translateY; scale handled separately via class */
}

.about-core-fallback {
  display: none;
  width: 100%;
  height: 100%;
  background: #2D2D2D;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 12px;
  color: #8B8070;
  font-family: 'Satoshi', sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* Dark veil that lifts on open */
.about-core-veil {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.65);
  transition: background 1.4s ease;
  pointer-events: none;
}
.about-vault-wrap.vault-open .about-core-veil {
  background: rgba(0,0,0,0);
}

/* White flash */
.about-core-flash {
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.15);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s ease;
  mix-blend-mode: overlay;
}
.about-vault-wrap.vault-open .about-core-flash {
  opacity: 1;
  transition: opacity 0.4s ease;
  animation: about-flash 1s ease-out forwards;
}

/* Gold border on open */
.about-core-border {
  position: absolute;
  inset: 0;
  border: 2px solid rgba(212,169,49,0);
  pointer-events: none;
  transition: border-color 1.8s ease 0.4s;
}
.about-vault-wrap.vault-open .about-core-border {
  border-color: rgba(212,169,49,0.55);
}

@keyframes about-flash {
  0%   { opacity: 1; }
  100% { opacity: 0; }
}

/* Vault Doors */
.about-door {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  overflow: hidden;
  transition: transform 1.2s cubic-bezier(0.76, 0, 0.24, 1);
}
.about-door-left {
  clip-path: polygon(0% 0%, 50% 0%, 40% 16.6%, 50% 33.3%, 40% 50%, 50% 66.6%, 40% 83.3%, 50% 100%, 0% 100%);
}
.about-door-right {
  clip-path: polygon(100% 0%, 100% 100%, 50% 100%, 40% 83.3%, 50% 66.6%, 40% 50%, 50% 33.3%, 40% 16.6%, 50% 0%);
}

.about-vault-wrap.vault-open .about-door-left  { transform: translateX(-100%); }
.about-vault-wrap.vault-open .about-door-right { transform: translateX(100%); }

.about-door-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Charcoal brick fallback for doors */
.about-door-fallback {
  display: none;
}

/* Edge lighting on doors */
.about-door-light {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.about-door-light-l {
  background: linear-gradient(to right, transparent 60%, rgba(0,0,0,0.55));
}
.about-door-light-r {
  background: linear-gradient(to left, transparent 60%, rgba(0,0,0,0.75));
}

/* "Click to reveal" label on vault */
.about-vault-wrap::after {
  content: 'Hover to Reveal';
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(26,26,26,0.85);
  border: 1px solid rgba(212,169,49,0.4);
  color: #D4A931;
  font-family: 'Satoshi', sans-serif;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 6px 14px;
  z-index: 5;
  pointer-events: none;
  opacity: 1;
  transition: opacity 0.5s ease;
  white-space: nowrap;
}
.about-vault-wrap.vault-open::after {
  opacity: 0;
}

/* Floating badge */
.about-exp-badge {
  position: absolute;
  bottom: -8px;
  right: -8px;
  background: #1A1A1A;
  border: 2px solid #D4A931;
  padding: 14px 18px;
  z-index: 6;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.about-exp-num {
  font-family: 'Fraunces', serif;
  font-size: 28px;
  font-weight: 900;
  color: #D4A931;
  line-height: 1;
}
.about-exp-label {
  font-family: 'Satoshi', sans-serif;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #8B8070;
  margin-top: 4px;
  line-height: 1.4;
}

/* ── RIGHT ── */
.about-right {
  flex: 1;
  min-width: 0;
}

.about-label {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 20px;
  font-family: 'Satoshi', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #D4A931;
}
.about-label-dot { font-size: 14px; line-height: 1; }

.about-heading {
  font-family: 'Fraunces', serif;
  font-size: clamp(24px, 2.8vw, 36px);
  line-height: 1.25;
  color: #1A1A1A;
  font-weight: 700;
  margin: 0 0 20px 0;
}
.about-heading-brand {
  color: #D4A931;
  font-weight: 700;
}
.about-heading strong { font-weight: 700; }
.about-heading-sub {
  font-weight: 400;
  color: #4A4A4A;
}

.about-body {
  font-family: 'Satoshi', sans-serif;
  font-size: 16px;
  color: #4A4A4A;
  line-height: 1.75;
  margin: 0 0 36px 0;
  max-width: 520px;
}

/* Stat Cards */
.about-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 36px;
}

.about-stat-card {
  background: #FFFFFF;
  border: 1px solid #D8D2C8;
  padding: 20px 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  transition: border-color 200ms ease, box-shadow 200ms ease;
  position: relative;
  overflow: hidden;
}
.about-stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 3px;
  height: 28px;
  background: #D4A931;
}
.about-stat-card:hover {
  border-color: #D4A931;
  box-shadow: 0 4px 24px rgba(0,0,0,0.08);
}

.about-stat-label {
  font-family: 'Satoshi', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #8B8070;
}
.about-stat-num {
  font-family: 'Fraunces', serif;
  font-size: clamp(28px, 3vw, 40px);
  font-weight: 900;
  color: #1A1A1A;
  line-height: 1;
}
.about-stat-desc {
  font-family: 'Satoshi', sans-serif;
  font-size: 12px;
  font-weight: 400;
  color: #8B8070;
}

/* CTA */
.about-cta-btn {
  display: inline-flex;
  align-items: center;
  height: 44px;
  padding: 0 24px;
  background: transparent;
  color: #1A1A1A;
  font-family: 'Satoshi', sans-serif;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
  border: 2px solid #1A1A1A;
  transition: background 200ms ease, color 200ms ease;
}
.about-cta-btn:hover {
  background: #1A1A1A;
  color: #D4A931;
}
.about-cta-btn:focus-visible {
  outline: 2px solid #D4A931;
  outline-offset: 2px;
}

/* scroll animations handled by GSAP section-transitions.ts */
/* stat card hover only — no initial hide */
.about-stat-card {
  transition: border-color 200ms ease, box-shadow 200ms ease;
}

/* ── RESPONSIVE ── */
@media (max-width: 1100px) {
  .about-container { padding: 0 40px; gap: 48px; }
  .about-left { flex: 0 0 380px; max-width: 380px; }
}
@media (max-width: 900px) {
  .about-section { padding: 72px 0; }
  .about-container { flex-direction: column; padding: 0 40px; gap: 56px; }
  .about-left { flex: none; width: 100%; max-width: 480px; margin: 0 auto; }
}
@media (max-width: 640px) {
  .about-section { padding: 56px 0; }
  .about-container { padding: 0 20px; }
  .about-stats { grid-template-columns: 1fr 1fr; }
  .about-stats .about-stat-card:last-child { grid-column: 1 / -1; }
  .about-heading { font-size: 24px; }
  .about-corner-tl, .about-corner-br { display: none; }
}
</style>

<script is:inline>
(function() {
  if (!document.getElementById('about-section')) return;

  // All DOM lookups live — closure refs go stale after ViewTransition
  function getVault() { return document.getElementById('about-vault'); }

  function setOpen(val) {
    var v = getVault();
    if (!v) return;
    if (val) { v.classList.add('vault-open'); } else { v.classList.remove('vault-open'); }
  }

  // Init persistent state on first load only
  if (window.__aboutLastY === undefined) window.__aboutLastY = window.scrollY;
  if (window.__aboutScrolledOpen === undefined) window.__aboutScrolledOpen = false;
  if (window.__aboutHovered === undefined) window.__aboutHovered = false;
  if (window.__aboutRafId === undefined) window.__aboutRafId = null;

  function updateParallax() {
    var v = getVault();
    var img = v ? v.querySelector('.about-core-img') : null;
    if (!img) return;
    var rect = v.getBoundingClientRect();
    var vh = window.innerHeight;
    var progress = 1 - (rect.bottom / (vh + rect.height));
    var clampedProgress = Math.max(0, Math.min(1, progress));
    img.style.transform = 'translateY(-' + (clampedProgress * 3) + '%)';
    window.__aboutRafId = null;
  }

  function onScroll(currentY) {
    var v = getVault();
    if (!v) return;
    var rect = v.getBoundingClientRect();
    var inView = rect.top < window.innerHeight && rect.bottom > 0;
    if (inView) {
      if (currentY - window.__aboutLastY > 4)      { window.__aboutScrolledOpen = true; }
      else if (window.__aboutLastY - currentY > 4) { window.__aboutScrolledOpen = false; }
      if (!window.__aboutHovered) setOpen(window.__aboutScrolledOpen);
      if (!window.__aboutRafId) { window.__aboutRafId = requestAnimationFrame(updateParallax); }
    }
    window.__aboutLastY = currentY;
  }

  // Native scroll — register only once, uses live DOM + global state
  if (!window.__aboutScrollRegistered) {
    window.__aboutScrollRegistered = true;
    window.addEventListener('scroll', function() {
      if (!document.getElementById('about-vault')) return;
      onScroll(window.scrollY);
    }, { passive: true });
  }

  // Lenis hook — replace handler on every navigation (new Lenis instance)
  function hookLenis() {
    var lenis = window.__lenis;
    if (!lenis) return;
    if (window.__aboutLenisHandler) {
      try { lenis.off('scroll', window.__aboutLenisHandler); } catch(e) {}
    }
    window.__aboutLenisHandler = function(ev) { onScroll(ev.scroll); };
    lenis.on('scroll', window.__aboutLenisHandler);
  }

  window.removeEventListener('animations:ready', window.__aboutAnimReady);
  window.__aboutAnimReady = hookLenis;
  window.addEventListener('animations:ready', window.__aboutAnimReady);
  if (window.__lenis) hookLenis();

  updateParallax();

  // Hover — re-register on every navigation (new DOM elements each time)
  var vault = getVault();
  if (vault) {
    vault.addEventListener('mouseenter', function() { window.__aboutHovered = true; setOpen(true); });
    vault.addEventListener('mouseleave', function() { window.__aboutHovered = false; setOpen(window.__aboutScrolledOpen); });
  }
})();
</script>
