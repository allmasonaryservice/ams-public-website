<style>
.ft {
  background: #1A1A1A;
  padding-top: 80px;
  border-top: 2px solid #2D2D2D;
}

.ft-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 80px 60px;
}

/* GRID */
.ft-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr;
  gap: 48px;
  align-items: start;
}

/* COL SHARED */
.ft-col-heading {
  font-family: 'Satoshi', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #D4A931;
  margin: 0 0 18px 0;
  padding-bottom: 10px;
  border-bottom: 1px solid #2D2D2D;
}
.ft-col-heading--mt {
  margin-top: 28px;
}

/* COL 1 — BRAND */
.ft-logo {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 16px;
}
.ft-logo-mark {
  font-family: 'Fraunces', serif;
  font-size: 22px;
  font-weight: 700;
  color: #D4A931;
  line-height: 1;
  padding-top: 2px;
  flex-shrink: 0;
}
.ft-logo-text {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.ft-logo-name {
  font-family: 'Fraunces', serif;
  font-size: 14px;
  font-weight: 700;
  color: #D4A931;
  line-height: 1.2;
}
.ft-logo-tagline {
  font-family: 'Satoshi', sans-serif;
  font-size: 11px;
  color: #8B8070;
  line-height: 1.4;
}
.ft-brand-desc {
  font-family: 'Satoshi', sans-serif;
  font-size: 13px;
  color: #CCCCCC;
  line-height: 1.7;
  margin: 0 0 20px 0;
}

/* SOCIAL */
.ft-social {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}
.ft-social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  color: #D4A931;
  border: 2px solid #2D2D2D;
  transition: color 200ms ease, border-color 200ms ease, background 200ms ease;
}
.ft-social-link:hover {
  color: #fff;
  border-color: #D4A931;
  background: #D4A931;
}
.ft-social-link:focus-visible {
  outline: 2px solid #D4A931;
  outline-offset: 2px;
}

/* TRUST BADGES */
.ft-trust-badges {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.ft-badge {
  font-family: 'Satoshi', sans-serif;
  font-size: 11px;
  font-weight: 600;
  color: #8B8070;
  letter-spacing: 0.03em;
}

/* COL 2 & 3 — LINKS */
.ft-links {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.ft-link {
  display: block;
  font-family: 'Satoshi', sans-serif;
  font-size: 13px;
  font-weight: 500;
  color: #CCCCCC;
  text-decoration: none;
  padding: 7px 0;
  border-bottom: 1px solid #2D2D2D;
  transition: color 200ms ease, padding-left 200ms ease;
}
.ft-links li:last-child .ft-link {
  border-bottom: none;
}
.ft-link:hover {
  color: #D4A931;
  padding-left: 6px;
}

/* COL 4 — CONTACT */
.ft-contact {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 0;
}
.ft-phone {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'Satoshi', sans-serif;
  font-size: 16px;
  font-weight: 700;
  color: #D4A931;
  text-decoration: none;
  transition: color 200ms ease;
}
.ft-phone:hover { color: #B8932A; }
.ft-email {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'Satoshi', sans-serif;
  font-size: 12px;
  font-weight: 400;
  color: #CCCCCC;
  text-decoration: none;
  word-break: break-all;
  transition: color 200ms ease;
}
.ft-email:hover { color: #D4A931; }
.ft-email svg, .ft-phone svg {
  flex-shrink: 0;
  color: #D4A931;
}

.ft-areas {
  font-family: 'Satoshi', sans-serif;
  font-size: 12px;
  color: #8B8070;
  line-height: 1.7;
  margin: 0 0 20px 0;
}

.ft-cta {
  display: inline-block;
  font-family: 'Satoshi', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #1A1A1A;
  background: #D4A931;
  padding: 10px 18px;
  text-decoration: none;
  transition: background 200ms ease;
}
.ft-cta:hover { background: #B8932A; }
.ft-link:focus-visible,
.ft-phone:focus-visible,
.ft-email:focus-visible,
.ft-cta:focus-visible,
.ft-bottom-link:focus-visible {
  outline: 2px solid #D4A931;
  outline-offset: 2px;
}

/* CITIES */
.ft-cities {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 8px;
}
.ft-city {
  font-family: 'Satoshi', sans-serif;
  font-size: 11px;
  font-weight: 500;
  color: #8B8070;
  text-decoration: none;
  transition: color 200ms ease;
  white-space: nowrap;
}
.ft-city::after {
  content: '·';
  margin-left: 8px;
  color: #2D2D2D;
}
.ft-city:last-child::after {
  content: '';
  margin: 0;
}
.ft-city:hover { color: #D4A931; }
.ft-city:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }

/* BOTTOM BAR */
.ft-bottom {
  border-top: 1px solid #2D2D2D;
}
.ft-bottom-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 20px 80px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.ft-copyright {
  font-family: 'Satoshi', sans-serif;
  font-size: 12px;
  color: #8B8070;
}
.ft-bottom-links {
  display: flex;
  align-items: center;
  gap: 10px;
}
.ft-bottom-link {
  font-family: 'Satoshi', sans-serif;
  font-size: 12px;
  color: #8B8070;
  text-decoration: none;
  transition: color 200ms ease;
}
.ft-bottom-link:hover { color: #D4A931; }
.ft-bottom-sep {
  color: #2D2D2D;
  font-size: 12px;
}

/* TABLET */
@media (max-width: 1100px) {
  .ft-inner { padding: 0 40px 48px; }
  .ft-bottom-inner { padding: 20px 40px; }
  .ft-grid { grid-template-columns: 1fr 1fr; gap: 40px; }
}
@media (max-width: 640px) {
  .ft-inner { padding: 0 20px 40px; }
  .ft-bottom-inner { padding: 20px; flex-direction: column; align-items: flex-start; gap: 10px; }
  .ft-grid { grid-template-columns: 1fr; gap: 32px; }
  .ft { padding-top: 56px; }
}
</style>
