---
const projects = [
  {
    id: 1,
    title: "Brick Installation — Hinsdale Estate",
    location: "Hinsdale, IL",
    scope: "Full brick facade installation on a 1,200 sq ft estate exterior — custom clay brick matched to existing architecture, color-blended mortar joints, and sealed finish.",
    tags: ["Brick Installation", "Custom Masonry"],
    year: "2026",
    sqft: "1,200 sq ft",
    duration: "1–3 weeks",
    image: "/images/projects/hinsdale-brick-installation-desktop.webp",
    href: "/projects/hinsdale-brick-installation",
    featured: true,
  },
  {
    id: 2,
    title: "Natural Stone & Limestone — Winnetka",
    location: "Winnetka, IL",
    scope: "Indiana limestone restoration and custom stonework on a North Shore estate — hand-cut stone, tuck-pointed joints, and structural re-bedding.",
    tags: ["Natural Stone", "Limestone"],
    year: "2026",
    sqft: "600 sq ft",
    duration: "1–2 weeks",
    image: "/images/projects/winnetka-natural-stone-limestone-desktop.webp",
    href: "/projects/winnetka-natural-stone-limestone",
    featured: false,
  },
  {
    id: 3,
    title: "Chimney Repair & Rebuilding — Northbrook",
    location: "Northbrook, IL",
    scope: "Full chimney crown replacement, flashing repair, and tuckpointing from roofline to cap on a 1950s colonial.",
    tags: ["Chimney Repair", "Rebuilding"],
    year: "2026",
    sqft: null,
    duration: "1–5 days",
    image: "/images/projects/northbrook-chimney-repair-rebuilding-desktop.webp",
    href: "/projects/northbrook-chimney-repair-rebuilding",
    featured: false,
  },
  {
    id: 4,
    title: "Tuckpointing & Repointing — Chicago",
    location: "Chicago, IL",
    scope: "Full exterior mortar joint raking and repointing across 800 sq ft of historic Chicago brick — color-matched mortar, hand-tooled joints.",
    tags: ["Tuckpointing", "Repointing"],
    year: "2026",
    sqft: "800 sq ft",
    duration: "2–4 days",
    image: "/images/projects/chicago-tuckpointing-repointing-desktop.webp",
    href: "/projects/chicago-tuckpointing-repointing",
    featured: false,
  },
];

const featured = projects.find(p => p.featured);
const rest = projects.filter(p => !p.featured);
---

<section class="rp" id="recent-projects">
  <div class="rp-inner">

    <!-- Header -->
    <div class="rp-header">
      <div class="rp-header-left">
        <span class="rp-label"><svg width="10" height="10" viewBox="0 0 24 24" fill="#D4A931" aria-hidden="true" style="margin-right:6px;vertical-align:middle"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>Recent Work</span>
        <h2 class="rp-heading">Real Jobs.<br><em>Real Results.</em></h2>
      </div>
      <p class="rp-sub">Every project below was completed on time, on budget, by our own crew — no stock photos, no subcontractors, built to survive Illinois winters.</p>
    </div>

    <!-- Featured project -->
    <div class="rp-featured">
      <div class="rp-featured-image">
        <img src={featured.image} alt={featured.title} loading="lazy" decoding="async" width="880" height="480" />
        <div class="rp-featured-overlay">
          <span class="rp-year-badge">{featured.year}</span>
        </div>
      </div>
      <div class="rp-featured-details">
        <div class="rp-tags">
          {featured.tags.map(tag => <span class="rp-tag">{tag}</span>)}
        </div>
        <h3 class="rp-featured-title">{featured.title}</h3>
        <div class="rp-location">
          <span class="rp-location-dot"></span>
          {featured.location}
        </div>
        <p class="rp-scope">{featured.scope}</p>
        <div class="rp-stats">
          {featured.sqft && (
            <div class="rp-stat">
              <p class="rp-stat-value">{featured.sqft}</p>
              <p class="rp-stat-label">Project Area</p>
            </div>
          )}
          <div class="rp-stat">
            <p class="rp-stat-value">{featured.duration}</p>
            <p class="rp-stat-label">Completion Time</p>
          </div>
          <div class="rp-stat">
            <p class="rp-stat-value">{featured.year}</p>
            <p class="rp-stat-label">Year Completed</p>
          </div>
        </div>
        <a href={featured.href} class="rp-view-btn">VIEW PROJECT</a>
      </div>
    </div>

    <!-- Rest of projects grid -->
    <div class="rp-grid">
      {rest.map(p => (
        <a href={p.href} class="rp-card">
          <div class="rp-card-image">
            <img src={p.image} alt={p.title} loading="lazy" decoding="async" width="400" height="240" />
            <span class="rp-card-year">{p.year}</span>
          </div>
          <div class="rp-card-body">
            <div class="rp-tags">
              {p.tags.map(tag => <span class="rp-tag">{tag}</span>)}
            </div>
            <h4 class="rp-card-title">{p.title}</h4>
            <div class="rp-location">
              <span class="rp-location-dot"></span>
              {p.location}
            </div>
            <p class="rp-card-scope">{p.scope}</p>
            <div class="rp-card-meta">
              {p.sqft && <span class="rp-meta-item">{p.sqft}</span>}
              <span class="rp-meta-item">{p.duration}</span>
            </div>
            <span class="rp-card-cta">View Project</span>
          </div>
        </a>
      ))}
    </div>

    <!-- See All Projects -->
    <div class="rp-all-wrap">
      <a href="/projects" class="rp-all-btn">SEE ALL 25 PROJECTS</a>
    </div>

  </div>
</section>


<style>
.rp {
  background: #F5F3EF;
  padding: 100px 0;
  border-top: 1px solid #D8D2C8;
}
.rp-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 80px;
}

/* HEADER */
.rp-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 48px;
  margin-bottom: 56px;
  flex-wrap: wrap;
}
.rp-label {
  display: inline-block;
  font-family: 'Satoshi', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #D4A931;
  margin-bottom: 16px;
}
.rp-heading {
  font-family: 'Fraunces', serif;
  font-size: clamp(32px, 3.5vw, 36px);
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.2;
  margin: 0;
}
.rp-heading em {
  font-style: italic;
  font-weight: 400;
  color: #D4A931;
}
.rp-sub {
  font-family: 'Satoshi', sans-serif;
  font-size: 16px;
  color: #4A4A4A;
  line-height: 1.75;
  margin: 0;
  max-width: 400px;
  padding-bottom: 6px;
}

/* FEATURED */
.rp-featured {
  display: grid;
  grid-template-columns: 1fr 400px;
  gap: 0;
  margin-bottom: 2px;
  background: #fff;
  border: 2px solid #D8D2C8;
  border-top: 3px solid #D4A931;
}
.rp-featured-image {
  position: relative;
  overflow: hidden;
  height: 480px;
}
.rp-featured-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 600ms ease;
}
.rp-featured:hover .rp-featured-image img {
  transform: scale(1.03);
}
.rp-featured-overlay {
  position: absolute;
  bottom: 16px;
  left: 16px;
}
.rp-year-badge {
  font-family: 'Satoshi', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #1A1A1A;
  background: #D4A931;
  padding: 4px 10px;
}
.rp-featured-details {
  padding: 40px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  justify-content: center;
  border-left: 1px solid #D8D2C8;
}
.rp-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.rp-tag {
  font-family: 'Satoshi', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #D4A931;
  border: 1px solid #D4A931;
  padding: 3px 8px;
}
.rp-featured-title {
  font-family: 'Fraunces', serif;
  font-size: clamp(22px, 2vw, 28px);
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.2;
  margin: 0;
}
.rp-location {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'Satoshi', sans-serif;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: #8B8070;
}
.rp-location-dot {
  width: 6px;
  height: 6px;
  background: #D4A931;
  flex-shrink: 0;
}
.rp-scope {
  font-family: 'Satoshi', sans-serif;
  font-size: 15px;
  color: #4A4A4A;
  line-height: 1.75;
  margin: 0;
}
.rp-stats {
  display: flex;
  gap: 0;
  border-top: 1px solid #D8D2C8;
  padding-top: 20px;
}
.rp-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-right: 16px;
  border-right: 1px solid #D8D2C8;
}
.rp-stat:last-child {
  border-right: none;
  padding-right: 0;
  padding-left: 16px;
  flex: none;
}
.rp-stat:not(:first-child):not(:last-child) {
  padding-left: 16px;
}
.rp-stat-value {
  font-family: 'Fraunces', serif;
  font-size: 18px;
  font-weight: 700;
  color: #1A1A1A;
}
.rp-stat-label {
  font-family: 'Satoshi', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #8B8070;
}

/* GRID */
.rp-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2px;
}
.rp-card {
  background: #fff;
  border: 2px solid #D8D2C8;
  border-top: 3px solid #D4A931;
  display: flex;
  flex-direction: column;
  transition: border-color 250ms ease, box-shadow 250ms ease;
}
.rp-card:hover {
  border-color: #D4A931;
  box-shadow: 0 4px 24px rgba(0,0,0,0.08);
}
.rp-card-image {
  position: relative;
  height: 180px;
  overflow: hidden;
}
.rp-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 500ms ease;
}
.rp-card:hover .rp-card-image img {
  transform: scale(1.05);
}
.rp-card-year {
  position: absolute;
  bottom: 8px;
  left: 8px;
  font-family: 'Satoshi', sans-serif;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #1A1A1A;
  background: #D4A931;
  padding: 3px 7px;
}
.rp-card-body {
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
}
.rp-card-title {
  font-family: 'Fraunces', serif;
  font-size: 16px;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.25;
  margin: 0;
}
.rp-card-scope {
  font-family: 'Satoshi', sans-serif;
  font-size: 12px;
  color: #4A4A4A;
  line-height: 1.65;
  margin: 0;
  flex: 1;
}
.rp-card-meta {
  display: flex;
  gap: 12px;
  padding-top: 10px;
  border-top: 1px solid #D8D2C8;
  flex-wrap: wrap;
}
.rp-meta-item {
  font-family: 'Satoshi', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: #8B8070;
}

/* VIEW PROJECT button on featured */
.rp-view-btn {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: 10px 20px;
  background: #D4A931;
  color: #1A1A1A;
  font-family: 'Satoshi', sans-serif;
  font-weight: 700;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  text-decoration: none;
  border: 2px solid #D4A931;
  transition: background 200ms ease, border-color 200ms ease;
  align-self: flex-start;
  margin-top: 4px;
}
.rp-view-btn:hover { background: #B8932A; border-color: #B8932A; }
.rp-view-btn:active { background: #9A7A22; border-color: #9A7A22; }
.rp-view-btn:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }

/* CTA text on cards */
.rp-card-cta {
  display: inline-block;
  font-family: 'Satoshi', sans-serif;
  font-weight: 700;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #D4A931;
  border-bottom: 1px solid #D4A931;
  padding-bottom: 2px;
  margin-top: 4px;
  align-self: flex-start;
  transition: color 200ms ease, border-color 200ms ease;
}
.rp-card:hover .rp-card-cta { color: #B8932A; border-color: #B8932A; }

/* See All Projects */
.rp-all-wrap {
  margin-top: 48px;
  display: flex;
  justify-content: center;
}
.rp-all-btn {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: 10px 28px;
  background: transparent;
  color: #1A1A1A;
  font-family: 'Satoshi', sans-serif;
  font-weight: 700;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  text-decoration: none;
  border: 2px solid #1A1A1A;
  transition: background 200ms ease, color 200ms ease;
}
.rp-all-btn:hover { background: #1A1A1A; color: #D4A931; }
.rp-all-btn:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }

/* card as link */
.rp-card {
  text-decoration: none;
  color: inherit;
}

/* scroll animations handled by GSAP section-transitions.ts */

/* TABLET */
@media (max-width: 1100px) {
  .rp-inner { padding: 0 40px; }
}
@media (max-width: 900px) {
  .rp { padding: 72px 0; }
  .rp-featured { grid-template-columns: 1fr; }
  .rp-featured-image { height: 320px; }
  .rp-featured-details { border-left: none; border-top: 1px solid #D8D2C8; }
  .rp-grid { grid-template-columns: repeat(2, 1fr); }
  .rp-header { flex-direction: column; align-items: flex-start; gap: 16px; }
}
@media (max-width: 640px) {
  .rp { padding: 56px 0; }
  .rp-inner { padding: 0 20px; }
  .rp-grid { grid-template-columns: 1fr; }
  .rp-featured-image { height: 260px; }
  .rp-stats { flex-wrap: wrap; gap: 16px; }
  .rp-stat { border-right: none; padding: 0; flex: none; width: 45%; }
  .rp-stat:last-child { padding-left: 0; }
}
</style>

