---
---

<div class="cmu-wrap" id="cmu-root">
  <div class="cmu-header">
    <span class="cmu-badge">COMMERCIAL TOOL</span>
    <h2 class="cmu-title">CMU Block Installation — <em>Quantity Calculator</em></h2>
    <p class="cmu-sub">Input your commercial wall specs — get CMU block count, mortar estimate, and a project complexity assessment from our AI.</p>
    <div class="cmu-progress"><div class="cmu-progress-fill" id="cmu-progress-fill"></div></div>
  </div>

  <!-- STEP 1: Tool Inputs -->
  <div class="step active" id="cmu-step1">
    <p class="step-label">Step 1 of 3 — Wall Specifications</p>
    <div class="input-grid">
      <div class="field-group">
        <label class="field-label" for="cmu-length">Wall Length (ft)</label>
        <input class="cmu-input" type="number" id="cmu-length" placeholder="e.g. 120" min="0" />
      </div>
      <div class="field-group">
        <label class="field-label" for="cmu-height">Wall Height (ft)</label>
        <input class="cmu-input" type="number" id="cmu-height" placeholder="e.g. 16" min="0" />
      </div>
      <div class="field-group">
        <label class="field-label" for="cmu-block-size">CMU Block Size</label>
        <select class="cmu-input cmu-select" id="cmu-block-size">
          <option value="8x8x16 Standard">8×8×16 Standard</option>
          <option value="8x4x16 Partition">8×4×16 Partition</option>
          <option value="8x12x16 Load-Bearing">8×12×16 Load-Bearing</option>
          <option value="8x6x16">8×6×16</option>
        </select>
      </div>
      <div class="field-group">
        <label class="field-label" for="cmu-app-type">Application Type</label>
        <select class="cmu-input cmu-select" id="cmu-app-type">
          <option value="Exterior Load-Bearing">Exterior Load-Bearing</option>
          <option value="Interior Partition">Interior Partition</option>
          <option value="Retaining/Foundation">Retaining / Foundation</option>
          <option value="Fire Wall">Fire Wall</option>
        </select>
      </div>
      <div class="field-group">
        <label class="field-label" for="cmu-stories">Number of Stories</label>
        <select class="cmu-input cmu-select" id="cmu-stories">
          <option value="1">1 Story</option>
          <option value="2">2 Stories</option>
          <option value="3+">3+ Stories</option>
        </select>
      </div>
      <div class="field-group">
        <label class="field-label" for="cmu-openings">Openings / Deductions (sq ft)</label>
        <input class="cmu-input" type="number" id="cmu-openings" placeholder="e.g. 200" min="0" />
      </div>
      <div class="field-group field-full">
        <label class="field-label" for="cmu-project-name">Project / Company Name</label>
        <input class="cmu-input" type="text" id="cmu-project-name" placeholder="e.g. Northside Warehouse — ABC Construction" />
      </div>
      <div class="field-group field-full">
        <label class="field-label" for="cmu-notes">Additional Notes</label>
        <textarea class="cmu-input cmu-textarea" id="cmu-notes" placeholder="Reinforcement requirements, soil conditions, design constraints, etc."></textarea>
      </div>
    </div>
    <button class="cmu-btn cmu-btn-primary" id="cmu-to-step2">Next — Your Information →</button>
  </div>

  <!-- STEP 2: Contact Form -->
  <div class="step" id="cmu-step2">
    <p class="step-label">Step 2 of 3 — Your Contact Information</p>
    <p class="step-desc">We'll include your details in the personalized commercial estimate report.</p>
    <div class="contact-grid">
      <div class="field-group">
        <label class="field-label" for="cmu-name">Full Name <span class="req">*</span></label>
        <input class="cmu-input" type="text" id="cmu-name" placeholder="John Contractor" required />
      </div>
      <div class="field-group">
        <label class="field-label" for="cmu-phone">Phone <span class="req">*</span></label>
        <input class="cmu-input" type="tel" id="cmu-phone" placeholder="(773) 555-0100" required />
      </div>
      <div class="field-group">
        <label class="field-label" for="cmu-email">Email <span class="req">*</span></label>
        <input class="cmu-input" type="email" id="cmu-email" placeholder="john@contractor.com" required />
      </div>
      <div class="field-group field-full">
        <label class="field-label" for="cmu-address">Property Address <span class="req">*</span></label>
        <input class="cmu-input" type="text" id="cmu-address" placeholder="456 Industrial Ave, Chicago, IL" required />
      </div>
      <div class="field-group">
        <label class="field-label" for="cmu-zip">Zip Code <span class="req">*</span></label>
        <input class="cmu-input" type="text" id="cmu-zip" placeholder="60608" required />
      </div>
    </div>
    <div class="nav-row">
      <button class="cmu-btn cmu-btn-outline" id="cmu-back-to-step1">← Back</button>
      <button class="cmu-btn cmu-btn-primary" id="cmu-submit">Generate Quantity Report →</button>
    </div>
  </div>

  <!-- STEP 3: Result -->
  <div class="step" id="cmu-step3">
    <div class="spinner-wrap" id="cmu-spinner">
      <div class="spinner"></div>
      <p class="spinner-text">Calculating CMU quantities and commercial estimate…</p>
    </div>
    <div class="result-wrap" id="cmu-result" style="display:none">
      <div class="success-icon">✓</div>
      <h3 class="result-title">Your CMU Report Is Ready</h3>
      <p class="result-sub">Your personalized CMU Quantity & Cost Analysis is ready — click the button below to download your PDF.</p>
      <div class="disclaimer-box">
        <strong>Important Disclaimer:</strong> This AI-generated commercial estimate is based on the specifications you provided and is not a substitute for a professional site inspection or formal engineering review. Actual block counts, structural requirements, and costs may differ based on site conditions, soil type, local code requirements, and engineering specifications. Contact All Masonry Services Inc. for a formal commercial bid — 773-656-2107.
      </div>
      <div class="result-actions">
        <button class="cmu-btn cmu-btn-primary" id="cmu-pdf-btn">Download PDF Report</button>
        <a class="cmu-btn cmu-btn-outline" href="/contact#form">Request a Formal Bid</a>
      </div>
    </div>
    <div class="error-wrap" id="cmu-error" style="display:none">
      <p class="error-msg" id="cmu-error-msg"></p>
      <button class="cmu-btn cmu-btn-outline" id="cmu-retry">← Try Again</button>
    </div>
  </div>
</div>

<script>
  (async () => {
    const GEMINI_KEY = import.meta.env.PUBLIC_GEMINI_KEY ?? '';
    const GEMINI_URL = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${GEMINI_KEY}`;

    let cmu_reportText = "";
    let cmu_contactData: Record<string, string> = {};

    function cmu_getVal(id: string): string {
      const el = document.getElementById(id) as HTMLInputElement | null;
      return el ? el.value.trim() : "";
    }

    function cmu_setProgress(pct: number) {
      const bar = document.getElementById("cmu-progress-fill") as HTMLElement | null;
      if (bar) bar.style.width = pct + "%";
    }

    function cmu_showStep(n: number) {
      [1, 2, 3].forEach(i => {
        const el = document.getElementById(`cmu-step${i}`);
        if (el) el.classList.toggle("active", i === n);
      });
      cmu_setProgress(n === 1 ? 10 : n === 2 ? 50 : 100);
    }

    async function cmu_generate() {
      const length = parseFloat(cmu_getVal("cmu-length")) || 0;
      const height = parseFloat(cmu_getVal("cmu-height")) || 0;
      const blockSize = cmu_getVal("cmu-block-size");
      const appType = cmu_getVal("cmu-app-type");
      const stories = cmu_getVal("cmu-stories");
      const openings = parseFloat(cmu_getVal("cmu-openings")) || 0;
      const projectName = cmu_getVal("cmu-project-name");
      const notes = cmu_getVal("cmu-notes");
      const zip = cmu_contactData.zip;
      const grossArea = length * height;
      const netArea = Math.max(0, grossArea - openings);
      const blocksNeeded = Math.ceil(netArea * 1.125 * 1.05);
      const mortarBags = Math.ceil(netArea / 25);

      const prompt = `You are a senior commercial masonry estimator at All Masonry Services Inc., Chicago's leading masonry contractor since 2007. You are writing a PERSONALIZED CMU quantity report for a specific contractor/developer at zip code ${zip}.

PROJECT PROFILE:
- Project/Company: ${projectName || "Not specified"}
- Contact: ${cmu_contactData.name}
- Property: ${cmu_contactData.address}, IL ${zip}
- Wall Length: ${length} ft
- Wall Height: ${height} ft
- Gross Wall Area: ${grossArea} sq ft
- Openings/Deductions: ${openings} sq ft
- NET CMU AREA: ${netArea} sq ft
- CMU Block Size: ${blockSize}
- Application Type: ${appType}
- Number of Stories: ${stories}
- Pre-Calculated Block Count (1.125 blocks/sqft + 5% waste): ${blocksNeeded} blocks
- Pre-Calculated Mortar Bags (1 bag per 25 sqft): ${mortarBags} bags
- Additional Notes: ${notes || "None provided"}

TASK: Write a SPECIFIC, PERSONALIZED CMU quantity and cost report for THIS project at THIS property. Reference the exact dimensions (${length}ft × ${height}ft = ${grossArea} sqft gross, ${netArea} sqft net) in every calculation section. Do NOT give generic CMU advice — use their actual numbers.

Use exactly these ALL CAPS headings:

PROJECT OVERVIEW — ${netArea} SQ FT ${blockSize} ${appType.toUpperCase()}
(Describe this specific commercial project: ${projectName || "unnamed project"} at ${cmu_contactData.address}. Explain what ${netArea} sq ft of ${appType} using ${blockSize} CMU blocks means in scope — is this a full building, single wall, fire separation? Identify the key structural and code considerations for ${stories} story ${appType}.)

CMU QUANTITY CALCULATION — PRECISE BREAKDOWN
(Show the exact math:
- Net CMU area: ${netArea} sq ft
- Block coverage rate for ${blockSize}: 1.125 blocks per sq ft
- Blocks before waste: ${Math.ceil(netArea * 1.125)} blocks
- With 5% waste factor: ${blocksNeeded} blocks TOTAL
- Pallets needed (72 blocks per pallet for ${blockSize}): ${Math.ceil(blocksNeeded / 72)} pallets
- Mortar bags (1 bag covers 25 sq ft): ${mortarBags} bags
- Grout fill (if cores filled, calculate for ${netArea} sq ft at 1/3 core fill): [calculate cubic yards]
- Rebar (if required for ${appType}): [calculate linear feet]
Verify each number against industry standards.)

COST ESTIMATE — CHICAGO COMMERCIAL 2026
(Break down every cost line:
- ${blockSize} CMU blocks: $X.XX – $X.XX per block × ${blocksNeeded} blocks = $X,XXX – $X,XXX
- Mortar and supplies: $X per bag × ${mortarBags} bags = $XXX – $XXX
- Rebar and grout (if ${appType} requires): $XXX – $XXX
- Labor for ${appType}: $X.XX – $X.XX per block installed × ${blocksNeeded} blocks = $X,XXX – $X,XXX
- Equipment/scaffold for ${stories} stories: $XXX – $X,XXX
- TOTAL ESTIMATED PROJECT COST: $X,XXX – $XX,XXX
Use real Chicago Metro commercial contractor pricing for 2026. Give contractor-grade numbers.)

STRUCTURAL & ENGINEERING REQUIREMENTS FOR ${appType.toUpperCase()}
(Explain the specific structural requirements for ${appType} in ${stories} story construction. Address: minimum wall thickness for ${blockSize}, bearing capacity, lateral load requirements, lintel specs over openings (${openings} sq ft), control joint spacing for ${length} ft wall. Flag any engineering review triggers.)

REBAR & GROUTING SPECIFICATION
(Based on ${appType} and ${stories} stories, specify: vertical rebar spacing and size, horizontal bond beam requirements, grout fill percentage, cleanout requirements. Reference ACI 530 or applicable masonry code. Explain what happens structurally if rebar/grout specs are not met for ${appType}.)

CHICAGO BUILDING CODE COMPLIANCE
(Address Chicago-specific requirements for ${appType}: permit requirements for ${grossArea} sq ft commercial masonry, required inspections, wind load requirements for ${stories} stories, fire rating requirements if applicable, weather protection requirements for ${new Date().getMonth() >= 10 || new Date().getMonth() <= 2 ? "winter" : "upcoming season"} work.)

TIMELINE & CREW FOR THIS PROJECT
(Specific timeline for ${netArea} sq ft of ${blockSize} ${appType}: crew size, blocks per day production rate, total calendar days, schedule for ${stories} story work including scaffold setup/breakdown, quality control inspection points.)

YOUR NEXT STEP
(Recommend contacting All Masonry Services Inc. for a formal commercial bid at 773-656-2107 or allmasonryservices.com. Mention AMS has completed 500+ commercial CMU projects in Chicagoland since 2007 and can provide a certified written estimate with material and labor breakdown within 48 hours.)

Write in contractor-grade professional language. Every number must be specific and calculated from the actual project inputs.`;

      const resp = await fetch(GEMINI_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          contents: [{ parts: [{ text: prompt }] }],
          generationConfig: { temperature: 0.7, maxOutputTokens: 2048 }
        })
      });
      if (!resp.ok) throw new Error(`API error: ${resp.status}`);
      const data = await resp.json();
      cmu_reportText = data.candidates?.[0]?.content?.parts?.[0]?.text || "No report generated.";
    }

    function cmu_renderReport() {
      const spinner = document.getElementById("cmu-spinner");
      const result = document.getElementById("cmu-result");
      if (spinner) spinner.style.display = "none";
      if (result) result.style.display = "block";
    }

    async function cmu_downloadPDF() {
      const { jsPDF } = await import("https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" as any);
      const doc = new jsPDF({ unit: "pt", format: "letter" });
      const pageW = doc.internal.pageSize.getWidth();
      const pageH = doc.internal.pageSize.getHeight();
      const margin = 48;
      let y = 0;

      function cmu_checkPage(needed: number) {
        if (y + needed > pageH - 48) { doc.addPage(); y = 48; }
      }

      doc.setFillColor(26, 26, 26);
      doc.rect(0, 0, pageW, 72, "F");
      doc.setTextColor(212, 169, 49);
      doc.setFontSize(13);
      doc.setFont("helvetica", "bold");
      doc.text("ALL MASONRY SERVICES INC", margin, 26);
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(15);
      doc.text("CMU Block Installation — Quantity Calculator Report", margin, 52);
      y = 96;

      doc.setTextColor(74, 74, 74);
      doc.setFontSize(10);
      doc.setFont("helvetica", "normal");
      doc.text(`Prepared for: ${cmu_contactData.name}  |  ${cmu_contactData.phone}  |  ${cmu_contactData.email}`, margin, y);
      y += 14;
      doc.text(`Property: ${cmu_contactData.address}, ${cmu_contactData.zip}`, margin, y);
      y += 14;
      doc.text(`Date: ${new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}`, margin, y);
      y += 24;

      const lines = cmu_reportText.split("\n");
      for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed) { y += 6; continue; }
        const isHeading = trimmed === trimmed.toUpperCase() && trimmed.length > 4 && trimmed.length < 90 && !trimmed.includes("•") && !trimmed.match(/^\d/) && !trimmed.match(/^\$/);
        if (isHeading) {
          cmu_checkPage(36);
          doc.setFillColor(212, 169, 49);
          doc.rect(margin, y, 3, 16, "F");
          doc.setTextColor(26, 26, 26);
          doc.setFontSize(11);
          doc.setFont("helvetica", "bold");
          doc.text(trimmed, margin + 10, y + 12);
          y += 24;
        } else {
          cmu_checkPage(18);
          doc.setTextColor(74, 74, 74);
          doc.setFontSize(9.5);
          doc.setFont("helvetica", "normal");
          const cleaned = trimmed.replace(/\*\*(.+?)\*\*/g, "$1").replace(/\*(.+?)\*/g, "$1").replace(/^[-•]\s+/, "• ");
          const wrapped = doc.splitTextToSize(cleaned, pageW - margin * 2);
          doc.text(wrapped, margin, y);
          y += wrapped.length * 13;
        }
      }

      // Disclaimer
      cmu_checkPage(80);
      doc.setDrawColor(212, 169, 49);
      doc.setLineWidth(0.5);
      doc.line(margin, y, pageW - margin, y);
      y += 12;
      doc.setTextColor(140, 128, 112);
      doc.setFontSize(8);
      doc.setFont("helvetica", "bolditalic");
      doc.text("DISCLAIMER", margin, y);
      y += 12;
      doc.setFont("helvetica", "normal");
      const cmuDisc = "This report is an AI-generated commercial estimate based on specifications provided through an online self-assessment tool. It is not a substitute for a professional site inspection, formal engineering review, or licensed contractor bid. Actual CMU quantities, structural requirements, local code compliance, and costs may differ significantly. All Masonry Services Inc. does not warrant the accuracy of this AI-generated report. For a certified commercial estimate, contact All Masonry Services Inc. at 773-656-2107 or allmasonryservices.com.";
      const cmuDiscWrapped = doc.splitTextToSize(cmuDisc, pageW - margin * 2);
      doc.text(cmuDiscWrapped, margin, y);

      const totalPages = (doc.internal as any).getNumberOfPages();
      for (let p = 1; p <= totalPages; p++) {
        doc.setPage(p);
        doc.saveGraphicsState();
        doc.setGState(new (doc as any).GState({ opacity: 0.07 }));
        doc.setTextColor(212, 169, 49);
        doc.setFontSize(52);
        doc.setFont("helvetica", "bold");
        doc.text("ALL MASONRY SERVICES", pageW / 2, pageH / 2, { align: "center", angle: 45 });
        doc.restoreGraphicsState();
        doc.setFillColor(26, 26, 26);
        doc.rect(0, pageH - 36, pageW, 36, "F");
        doc.setTextColor(212, 169, 49);
        doc.setFontSize(8);
        doc.setFont("helvetica", "bold");
        doc.text("© All Masonry Services Inc  ·  allmasonryservices.com  ·  773-656-2107", margin, pageH - 14);
        doc.setTextColor(180, 180, 180);
        doc.text(`Page ${p} of ${totalPages}`, pageW - margin - 40, pageH - 14);
      }
      doc.save(`CMUReport-${cmu_contactData.name.replace(/\s+/g, "-")}.pdf`);
    }

    document.getElementById("cmu-to-step2")?.addEventListener("click", () => cmu_showStep(2));
    document.getElementById("cmu-back-to-step1")?.addEventListener("click", () => cmu_showStep(1));

    document.getElementById("cmu-submit")?.addEventListener("click", async () => {
      const name = cmu_getVal("cmu-name");
      const phone = cmu_getVal("cmu-phone");
      const email = cmu_getVal("cmu-email");
      const address = cmu_getVal("cmu-address");
      const zip = cmu_getVal("cmu-zip");
      if (!name || !phone || !email || !address || !zip) {
        alert("Please fill in all required fields.");
        return;
      }
      cmu_contactData = { name, phone, email, address, zip };
      cmu_showStep(3);
      const spinner = document.getElementById("cmu-spinner");
      const result = document.getElementById("cmu-result");
      const errWrap = document.getElementById("cmu-error");
      if (spinner) spinner.style.display = "flex";
      if (result) result.style.display = "none";
      if (errWrap) errWrap.style.display = "none";
      try {
        await cmu_generate();
        cmu_renderReport();
      } catch (e: any) {
        if (spinner) spinner.style.display = "none";
        if (errWrap) errWrap.style.display = "block";
        const msg = document.getElementById("cmu-error-msg");
        if (msg) msg.textContent = "Error generating report: " + (e.message || "Please try again.");
      }
    });

    document.getElementById("cmu-pdf-btn")?.addEventListener("click", cmu_downloadPDF);
    document.getElementById("cmu-retry")?.addEventListener("click", () => cmu_showStep(1));
  })();
</script>

<style>
  .cmu-wrap { font-family: 'Satoshi', sans-serif; background: #F5F3EF; color: #1A1A1A; max-width: 720px; margin: 0 auto; }
  .cmu-header { background: #1A1A1A; padding: 32px 36px 0; }
  .cmu-badge { display: inline-block; background: #D4A931; color: #1A1A1A; font-size: 11px; font-weight: 700; letter-spacing: .1em; padding: 4px 10px; margin-bottom: 14px; }
  .cmu-title { font-family: 'Fraunces', serif; color: #F5F3EF; font-size: 26px; font-weight: 700; margin: 0 0 10px; line-height: 1.25; }
  .cmu-title em { color: #D4A931; font-style: normal; }
  .cmu-sub { color: #8B8070; font-size: 14px; margin: 0 0 24px; line-height: 1.5; }
  .cmu-progress { height: 3px; background: #2A2A2A; }
  .cmu-progress-fill { height: 3px; background: #D4A931; width: 10%; transition: width .4s ease; }
  .step { display: none; padding: 32px 36px; }
  .step.active { display: block; }
  .step-label { font-size: 12px; font-weight: 700; letter-spacing: .08em; color: #8B8070; text-transform: uppercase; margin: 0 0 20px; }
  .step-desc { font-size: 14px; color: #4A4A4A; margin: -12px 0 20px; }
  .input-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 4px; }
  .field-group { margin-bottom: 4px; }
  .field-full { grid-column: 1 / -1; }
  .field-label { display: block; font-size: 13px; font-weight: 600; color: #1A1A1A; margin-bottom: 6px; }
  .req { color: #D4A931; }
  .cmu-input { width: 100%; height: 44px; border: 2px solid #1A1A1A; background: #fff; color: #1A1A1A; font-family: 'Satoshi', sans-serif; font-size: 14px; padding: 0 12px; box-sizing: border-box; outline: none; border-radius: 0; appearance: none; }
  .cmu-input:focus { border-color: #D4A931; }
  .cmu-select { cursor: pointer; }
  .cmu-textarea { height: 80px; resize: vertical; padding: 10px 12px; }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .cmu-btn { display: inline-flex; align-items: center; justify-content: center; height: 48px; padding: 0 24px; font-family: 'Satoshi', sans-serif; font-size: 14px; font-weight: 700; cursor: pointer; border: none; border-radius: 0; letter-spacing: .04em; text-decoration: none; transition: opacity .2s; }
  .cmu-btn:hover { opacity: .85; }
  .cmu-btn-primary { background: #D4A931; color: #1A1A1A; }
  .cmu-btn-outline { background: transparent; color: #1A1A1A; border: 2px solid #1A1A1A; }
  .nav-row { display: flex; gap: 12px; margin-top: 16px; }
  #cmu-to-step2 { width: 100%; margin-top: 20px; }
  .spinner-wrap { display: flex; flex-direction: column; align-items: center; padding: 48px 0; gap: 16px; }
  .spinner { width: 44px; height: 44px; border: 3px solid #E0DDD8; border-top-color: #D4A931; border-radius: 50%; animation: cmu-spin .8s linear infinite; }
  @keyframes cmu-spin { to { transform: rotate(360deg); } }
  .spinner-text { color: #8B8070; font-size: 14px; }
  .result-wrap { text-align: center; padding: 8px 0; }
  .success-icon { width: 56px; height: 56px; background: #D4A931; color: #1A1A1A; font-size: 28px; font-weight: 900; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
  .result-title { font-family: 'Fraunces', serif; font-size: 22px; color: #1A1A1A; margin: 0 0 8px; }
  .result-sub { font-size: 14px; color: #4A4A4A; margin: 0 0 20px; line-height: 1.5; }
  .disclaimer-box { background: #FFF9EC; border: 1px solid #D4A931; border-left: 4px solid #D4A931; padding: 14px 16px; font-size: 12px; color: #5A4A20; line-height: 1.6; text-align: left; margin-bottom: 20px; }
  .disclaimer-box strong { color: #1A1A1A; display: block; margin-bottom: 4px; font-size: 11px; letter-spacing: .05em; text-transform: uppercase; }
  .result-actions { display: flex; gap: 12px; margin-top: 24px; flex-wrap: wrap; justify-content: center; }
  .error-wrap { padding: 32px; text-align: center; }
  .error-msg { color: #c0392b; font-size: 14px; margin-bottom: 16px; }
  @media (max-width: 600px) {
    .cmu-header, .step { padding: 24px 20px; }
    .input-grid, .contact-grid { grid-template-columns: 1fr; }
    .cmu-title { font-size: 20px; }
    .field-full { grid-column: 1; }
  }
</style>
