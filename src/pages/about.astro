        <div class="ab-trust-card">
          <div class="ab-trust-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <rect x="4" y="12" width="20" height="12" stroke="#D4A931" stroke-width="1.5"/>
              <path d="M4 12L14 4L24 12" stroke="#D4A931" stroke-width="1.5" stroke-linecap="square"/>
