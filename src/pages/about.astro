  <!-- ═══════════════════════════════════════════════
       TRUST SIGNALS / WHY US
  ═══════════════════════════════════════════════ -->
  <section class="ab-trust" aria-labelledby="ab-trust-h2">
    <div class="ab-trust-inner">
      <div class="ab-section-label ab-section-label--gold">
        <span class="ab-label-dot">✦</span>
