---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Get a Free Masonry Estimate in Chicagoland — All Masonry Services"
  description="Request a free on-site masonry inspection and written estimate. Serving Hinsdale, Winnetka, Oak Brook, Naperville, Evanston, and 19+ Chicagoland cities. Same-day response. No spam."
  canonical="https://allmasonryservices.com/contact"
>

  <!-- ═══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <section class="ct-hero" aria-label="Contact All Masonry Services">
    <div class="ct-hero-inner">
      <div class="ct-hero-badge">
        <span>Free Inspection · Written Estimate · No Obligation</span>
      </div>
      <h1 class="ct-hero-h1">Get a Free Masonry Estimate in Chicagoland</h1>
      <p class="ct-hero-sub">
        We inspect your property, diagnose the issue, and give you a written estimate — before any work starts. No verbal guesses. No surprise invoices. Same-day response on weekdays.
      </p>
      <div class="ct-hero-trust">
        <div class="ct-trust-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8L6 11.5L13.5 4" stroke="#D4A931" stroke-width="1.5" stroke-linecap="square"/></svg>
          <span>4.8★ — 92 Google Reviews</span>
        </div>
        <div class="ct-trust-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8L6 11.5L13.5 4" stroke="#D4A931" stroke-width="1.5" stroke-linecap="square"/></svg>
          <span>Licensed &amp; Insured in Illinois</span>
        </div>
        <div class="ct-trust-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8L6 11.5L13.5 4" stroke="#D4A931" stroke-width="1.5" stroke-linecap="square"/></svg>
          <span>No Subcontractors — Ever</span>
        </div>
        <div class="ct-trust-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8L6 11.5L13.5 4" stroke="#D4A931" stroke-width="1.5" stroke-linecap="square"/></svg>
          <span>Serving Chicagoland Since 2007</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       MAIN: FORM + INFO
  ═══════════════════════════════════════════════ -->
  <section class="ct-main" id="form" aria-labelledby="ct-form-h2">
    <div class="ct-main-inner">

      <!-- LEFT: Form -->
      <div class="ct-form-wrap">
        <h2 class="ct-form-h2" id="ct-form-h2">Request Your Free Inspection</h2>
        <p class="ct-form-sub">Fill out the form and we'll contact you within one business day to schedule your on-site visit. No spam. No sales pressure.</p>

        <form class="ct-form" id="ct-contact-form" novalidate aria-label="Contact form">
          <div class="ct-field-row">
            <div class="ct-field">
              <label class="ct-label" for="ct-name">Full Name <span class="ct-required" aria-hidden="true">*</span></label>
              <input
                class="ct-input"
                type="text"
                id="ct-name"
                name="name"
                placeholder="e.g. Sarah Johnson"
                autocomplete="name"
                required
                aria-required="true"
                aria-describedby="ct-name-err"
              />
              <span class="ct-err" id="ct-name-err" role="alert" aria-live="polite"></span>
            </div>
            <div class="ct-field">
              <label class="ct-label" for="ct-phone">Phone Number <span class="ct-required" aria-hidden="true">*</span></label>
              <input
                class="ct-input"
                type="tel"
                id="ct-phone"
                name="phone"
                placeholder="(773) 000-0000"
                autocomplete="tel"
                required
                aria-required="true"
                aria-describedby="ct-phone-err"
              />
              <span class="ct-err" id="ct-phone-err" role="alert" aria-live="polite"></span>
            </div>
          </div>

          <div class="ct-field">
            <label class="ct-label" for="ct-email">Email Address</label>
            <input
              class="ct-input"
              type="email"
              id="ct-email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              aria-describedby="ct-email-note"
            />
            <span class="ct-field-note" id="ct-email-note">Optional — we'll use phone as primary contact</span>
          </div>

          <div class="ct-field">
            <label class="ct-label" for="ct-address">Property Address</label>
            <input
              class="ct-input"
              type="text"
              id="ct-address"
              name="address"
              placeholder="123 Main St, Hinsdale, IL"
              autocomplete="street-address"
              aria-describedby="ct-address-note"
            />
            <span class="ct-field-note" id="ct-address-note">Helps us prepare for the inspection</span>
          </div>

          <div class="ct-field">
            <label class="ct-label" for="ct-service">Service Needed <span class="ct-required" aria-hidden="true">*</span></label>
            <select
              class="ct-select"
              id="ct-service"
              name="service"
              required
              aria-required="true"
              aria-describedby="ct-service-err"
            >
              <option value="" disabled selected>Select a service</option>
              <option value="tuckpointing">Tuckpointing &amp; Repointing</option>
              <option value="brick-repair">Damaged Brick Replacement</option>
              <option value="chimney-repair">Chimney Repair &amp; Rebuilding</option>
              <option value="chimney-fireplace">Chimney &amp; Fireplace Inspection</option>
              <option value="brick-installation">Brick Installation</option>
              <option value="natural-stone">Natural Stone &amp; Limestone</option>
              <option value="veneers">Brick &amp; Stone Veneers</option>
              <option value="custom-home">Custom Home Masonry</option>
              <option value="cmu-block">CMU Block Installation</option>
              <option value="commercial">Commercial Masonry</option>
              <option value="commercial-veneers">Commercial Masonry Veneers</option>
              <option value="not-sure">Not Sure — Need Inspection First</option>
            </select>
            <span class="ct-err" id="ct-service-err" role="alert" aria-live="polite"></span>
          </div>

          <div class="ct-field">
            <label class="ct-label" for="ct-message">Describe the Issue</label>
            <textarea
              class="ct-textarea"
              id="ct-message"
              name="message"
              rows="4"
              placeholder="e.g. Cracked mortar joints on the north chimney face, a few spalled bricks on the front facade, not sure if it's urgent..."
              aria-describedby="ct-message-note"
            ></textarea>
            <span class="ct-field-note" id="ct-message-note">The more detail you give us, the better we can prepare for your inspection</span>
          </div>

          <!-- Honeypot — hidden from real users -->
          <div class="ct-honeypot" aria-hidden="true">
            <label for="ct-website">Website</label>
            <input type="text" id="ct-website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <button class="ct-submit-btn" type="submit" id="ct-submit" aria-label="Submit free inspection request">
            <span id="ct-btn-text">Request Free Inspection</span>
            <span class="ct-btn-spinner" id="ct-spinner" aria-hidden="true" style="display:none">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="ct-spin"><circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="2" stroke-dasharray="22 22" opacity="0.4"/><path d="M9 2A7 7 0 0 1 16 9" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg>
              Sending...
            </span>
          </button>
          <p class="ct-form-privacy">No spam. We use your info only to contact you about your inspection request.</p>

          <!-- Success -->
          <div class="ct-success" id="ct-success" role="alert" aria-live="polite" style="display:none">
            <div class="ct-success-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M5 14L11 20L23 8" stroke="#27AE60" stroke-width="2" stroke-linecap="square"/></svg>
            </div>
            <div>
              <p class="ct-success-title">Request received — we'll be in touch.</p>
              <p class="ct-success-body">We typically respond within one business day to schedule your free on-site inspection. Check your phone for a call or text from us.</p>
            </div>
          </div>

          <!-- Error -->
          <div class="ct-form-error" id="ct-form-error" role="alert" aria-live="polite" style="display:none">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="7" stroke="#C0392B" stroke-width="1.5"/><path d="M9 5V9M9 12V13" stroke="#C0392B" stroke-width="1.5" stroke-linecap="square"/></svg>
            <span>Something went wrong. Please call us directly at <a href="tel:7736562107">773-656-2107</a>.</span>
          </div>
        </form>
      </div>

      <!-- RIGHT: Contact Info -->
      <div class="ct-info">

        <div class="ct-info-block">
          <h3 class="ct-info-h3">Call or Text Us</h3>
          <a href="tel:7736562107" class="ct-phone" aria-label="Call All Masonry Services at 773-656-2107">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M18 13.44v2.25a1.5 1.5 0 0 1-1.635 1.5A14.85 14.85 0 0 1 9.9 14.82a14.625 14.625 0 0 1-4.5-4.5 14.85 14.85 0 0 1-2.37-6.525A1.5 1.5 0 0 1 4.515 2.25h2.25a1.5 1.5 0 0 1 1.5 1.29c.094.712.27 1.411.525 2.085a1.5 1.5 0 0 1-.337 1.582L7.34 8.32a12 12 0 0 0 4.5 4.5l1.113-1.113a1.5 1.5 0 0 1 1.582-.338c.674.255 1.373.432 2.085.525A1.5 1.5 0 0 1 18 13.44z" stroke="#D4A931" stroke-width="1.5" stroke-linecap="square"/>
            </svg>
            773-656-2107
          </a>
          <p class="ct-info-note">Mon–Fri 7am–6pm · Sat 8am–2pm · Sun Closed</p>
        </div>

        <div class="ct-info-block">
          <h3 class="ct-info-h3">Email</h3>
          <a href="mailto:contact.allmasonryservices@gmail.com" class="ct-email">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <rect x="2" y="4" width="14" height="11" rx="0" stroke="#D4A931" stroke-width="1.5"/>
              <path d="M2 5L9 10.5L16 5" stroke="#D4A931" stroke-width="1.5" stroke-linecap="square"/>
            </svg>
            contact.allmasonryservices@gmail.com
          </a>
        </div>

        <div class="ct-info-block">
          <h3 class="ct-info-h3">Service Area</h3>
          <p class="ct-info-areas">
            Hinsdale · Oak Brook · Winnetka · Wilmette · Evanston · Naperville · Elmhurst · Western Springs · Arlington Heights · Schaumburg · Barrington · Lake Forest · Highland Park · Glencoe · Kenilworth · Downers Grove · Palatine · Libertyville · Chicago
          </p>
          <a href="/service-areas" class="ct-areas-link">View full service area map</a>
        </div>

        <div class="ct-info-block">
          <h3 class="ct-info-h3">Licensed &amp; Insured</h3>
          <p class="ct-info-body">Licensed masonry contractor in Illinois. $2M general liability coverage. Certificate of Insurance available on request — before any work starts.</p>
          <div class="ct-badges">
            <span class="ct-badge">✓ IL Licensed</span>
            <span class="ct-badge">✓ $2M Insured</span>
            <span class="ct-badge">✓ 19+ Years</span>
          </div>
        </div>

        <!-- Why Not to Wait -->
        <div class="ct-urgency">
          <div class="ct-urgency-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
              <path d="M11 3L20 18H2L11 3Z" stroke="#D4A931" stroke-width="1.5" stroke-linejoin="miter"/>
              <path d="M11 9V13" stroke="#D4A931" stroke-width="1.5" stroke-linecap="square"/>
              <circle cx="11" cy="16" r="0.75" fill="#D4A931"/>
            </svg>
          </div>
          <div>
            <p class="ct-urgency-title">Don't wait until spring.</p>
            <p class="ct-urgency-body">Every freeze-thaw cycle widens existing cracks. A $300 repair in fall becomes a $3,000 structural fix by March. Fall slots fill fast — we're usually booked 2–3 weeks out by October.</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       FAQ
  ═══════════════════════════════════════════════ -->
  <section class="ct-faq" aria-labelledby="ct-faq-h2">
    <div class="ct-faq-inner">
      <div class="ct-section-label">
        <span class="ct-label-dot">✦</span>
        <span>Before You Reach Out</span>
      </div>
      <h2 class="ct-faq-h2" id="ct-faq-h2">Common questions about getting an estimate</h2>
      <div class="ct-faq-grid">
        <details class="ct-faq-item">
          <summary class="ct-faq-q">Is the inspection really free?</summary>
          <p class="ct-faq-a">Yes. We inspect your property and give you a written estimate at no cost. No obligation to proceed. We do this because we'd rather you make an informed decision than feel pressured.</p>
        </details>
        <details class="ct-faq-item">
          <summary class="ct-faq-q">How fast will you respond?</summary>
          <p class="ct-faq-a">Weekday requests receive a call or text within one business day. We typically schedule the on-site inspection within 3–5 business days, depending on our current booking.</p>
        </details>
        <details class="ct-faq-item">
          <summary class="ct-faq-q">What if I don't know what service I need?</summary>
          <p class="ct-faq-a">Choose "Not Sure — Need Inspection First" in the form. We'll inspect and tell you exactly what the issue is, how urgent it is, and what it will cost. No upselling.</p>
        </details>
        <details class="ct-faq-item">
          <summary class="ct-faq-q">Do you work on commercial properties?</summary>
          <p class="ct-faq-a">Yes. We handle commercial masonry including CMU block installation, facade work, commercial brick and stone, and full masonry veneer coverage for commercial buildings across Chicagoland.</p>
        </details>
        <details class="ct-faq-item">
          <summary class="ct-faq-q">Do you use subcontractors?</summary>
          <p class="ct-faq-a">Never. Every person who works on your property is part of our own licensed, trained crew. The quality you see in our estimate is the quality delivered on-site — not handed off to a sub.</p>
        </details>
        <details class="ct-faq-item">
          <summary class="ct-faq-q">What's included in the written estimate?</summary>
          <p class="ct-faq-a">Scope of work, materials (including mortar type and brick specification), method, timeline, and total price. Everything in writing before we touch your property. No verbal promises.</p>
        </details>
      </div>
    </div>
  </section>

  <Footer />

  <!-- ═══════════════════════════════════════════════
       SCHEMA — ContactPage + FAQPage + LocalBusiness
  ═══════════════════════════════════════════════ -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ContactPage",
        "@id": "https://allmasonryservices.com/contact#webpage",
        "url": "https://allmasonryservices.com/contact",
        "name": "Get a Free Masonry Estimate in Chicagoland — All Masonry Services",
        "description": "Request a free on-site masonry inspection and written estimate. Serving 19+ Chicagoland cities. Same-day response.",
        "isPartOf": { "@id": "https://allmasonryservices.com/#website" },
        "about": { "@id": "https://allmasonryservices.com/#business" },
        "breadcrumb": {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://allmasonryservices.com/" },
            { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://allmasonryservices.com/contact" }
          ]
        }
      },
      {
        "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
        "@id": "https://allmasonryservices.com/#business",
        "name": "All Masonry Services",
        "url": "https://allmasonryservices.com",
        "telephone": "+17736562107",
        "email": "contact.allmasonryservices@gmail.com",
        "foundingDate": "2007",
        "description": "Licensed masonry contractor serving Chicagoland since 2007. Tuckpointing, brick repair, chimney repair, custom home masonry, and commercial masonry. ASTM-compliant. No subcontractors. Free estimates.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Chicago",
          "addressRegion": "IL",
          "addressCountry": "US"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 41.8781,
          "longitude": -87.6298
        },
        "areaServed": [
          "Chicago", "Hinsdale", "Winnetka", "Oak Brook", "Naperville", "Evanston",
          "Wilmette", "Kenilworth", "Glencoe", "Highland Park", "Elmhurst",
          "Western Springs", "Downers Grove", "Schaumburg", "Arlington Heights",
          "Palatine", "Barrington", "Libertyville", "Lake Forest"
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.8",
          "reviewCount": "92",
          "bestRating": "5"
        },
        "openingHoursSpecification": [
          { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "07:00", "closes": "18:00" },
          { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "08:00", "closes": "14:00" }
        ],
        "priceRange": "$$",
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+17736562107",
          "contactType": "customer service",
          "areaServed": "US-IL",
          "availableLanguage": "English",
          "hoursAvailable": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
            "opens": "07:00",
            "closes": "18:00"
          }
        }
      },
      {
        "@type": "FAQPage",
        "@id": "https://allmasonryservices.com/contact#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is the masonry inspection really free?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes. All Masonry Services inspects your property and provides a written estimate at no cost. No obligation to proceed. We do this so you can make an informed decision." }
          },
          {
            "@type": "Question",
            "name": "How fast does All Masonry Services respond to estimate requests?",
            "acceptedAnswer": { "@type": "Answer", "text": "Weekday requests receive a call or text within one business day. On-site inspection is typically scheduled within 3–5 business days." }
          },
          {
            "@type": "Question",
            "name": "What if I don't know what masonry service I need?",
            "acceptedAnswer": { "@type": "Answer", "text": "Choose Not Sure on the contact form. We'll inspect and tell you exactly what the issue is, how urgent it is, and what it will cost. No upselling." }
          },
          {
            "@type": "Question",
            "name": "Does All Masonry Services work on commercial properties in Chicagoland?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes. We handle commercial masonry including CMU block installation, facade work, commercial brick and stone, and full masonry veneer coverage for commercial buildings across Chicagoland." }
          },
          {
            "@type": "Question",
            "name": "Does All Masonry Services use subcontractors?",
            "acceptedAnswer": { "@type": "Answer", "text": "Never. Every person who works on your property is part of our own licensed, trained crew. No day-labor, no subcontractors." }
          },
          {
            "@type": "Question",
            "name": "What is included in a masonry estimate from All Masonry Services?",
            "acceptedAnswer": { "@type": "Answer", "text": "Scope of work, materials including mortar type and brick specification, method, timeline, and total price — all in writing before any work begins." }
          }
        ]
      }
    ]
  }
  </script>

</BaseLayout>

<style>
/* ══════════════════════════════════════════
   CONTACT PAGE
══════════════════════════════════════════ */

/* ── HERO ── */
.ct-hero {
  background: #1A1A1A;
  padding: 72px 0 80px;
}
.ct-hero-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 80px;
  text-align: left;
}
.ct-hero-badge {
  display: inline-block;
  background: rgba(212,169,49,0.12);
  border: 1px solid rgba(212,169,49,0.35);
  color: #D4A931;
  font-family: 'Satoshi', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 6px 14px;
  margin-bottom: 28px;
}
.ct-hero-h1 {
  font-family: 'Fraunces', serif;
  font-size: clamp(28px, 4vw, 52px);
  font-weight: 900;
  line-height: 1.15;
  color: #FFFFFF;
  margin: 0 0 20px 0;
  max-width: 720px;
}
.ct-hero-sub {
  font-family: 'Satoshi', sans-serif;
  font-size: 17px;
  color: #CCCCCC;
  line-height: 1.7;
  max-width: 600px;
  margin: 0 0 40px 0;
}
.ct-hero-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 20px 36px;
}
.ct-trust-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'Satoshi', sans-serif;
  font-size: 13px;
  font-weight: 600;
  color: #CCCCCC;
}

/* ── MAIN ── */
.ct-main {
  background: #F5F3EF;
  padding: 80px 0 100px;
}
.ct-main-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 80px;
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 72px;
  align-items: start;
}

/* Form */
.ct-form-h2 {
  font-family: 'Fraunces', serif;
  font-size: clamp(22px, 2.5vw, 32px);
  font-weight: 700;
  color: #1A1A1A;
  margin: 0 0 10px 0;
}
.ct-form-sub {
  font-family: 'Satoshi', sans-serif;
  font-size: 14px;
  color: #8B8070;
  line-height: 1.65;
  margin: 0 0 36px 0;
}
.ct-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.ct-field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.ct-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.ct-label {
  font-family: 'Satoshi', sans-serif;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #1A1A1A;
}
.ct-required { color: #C0392B; }
.ct-input,
.ct-select,
.ct-textarea {
  font-family: 'Satoshi', sans-serif;
  font-size: 13px;
  color: #1A1A1A;
  background: #FFFFFF;
  border: 2px solid #1A1A1A;
  padding: 0 14px;
  height: 44px;
  width: 100%;
  outline: none;
  transition: border-color 200ms ease;
  appearance: none;
  -webkit-appearance: none;
  border-radius: 0;
}
.ct-input::placeholder,
.ct-textarea::placeholder { color: #8B8070; }
.ct-input:focus,
.ct-select:focus,
.ct-textarea:focus { border-color: #D4A931; }
.ct-input.is-error,
.ct-select.is-error { border-color: #C0392B; }
.ct-textarea {
  height: auto;
  padding: 12px 14px;
  resize: vertical;
  min-height: 120px;
}
