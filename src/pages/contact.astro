<script is:inline>
(function () {
  var form = document.getElementById('ct-contact-form');
  if (!form) return;

  var btnText = document.getElementById('ct-btn-text');
  var spinner = document.getElementById('ct-spinner');
  var submitBtn = document.getElementById('ct-submit');
  var successBox = document.getElementById('ct-success');
  var errorBox = document.getElementById('ct-form-error');

  function showErr(inputId, errId, msg) {
    var inp = document.getElementById(inputId);
    var err = document.getElementById(errId);
    if (inp) inp.classList.add('is-error');
    if (err) err.textContent = msg;
  }
  function clearErr(inputId, errId) {
    var inp = document.getElementById(inputId);
    var err = document.getElementById(errId);
    if (inp) inp.classList.remove('is-error');
    if (err) err.textContent = '';
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();

    var name = document.getElementById('ct-name').value.trim();
    var phone = document.getElementById('ct-phone').value.trim();
    var service = document.getElementById('ct-service').value;
    var honeypot = document.getElementById('ct-website').value;

    var valid = true;
    clearErr('ct-name', 'ct-name-err');
    clearErr('ct-phone', 'ct-phone-err');
    clearErr('ct-service', 'ct-service-err');

    if (honeypot) return; // bot

    if (!name) { showErr('ct-name', 'ct-name-err', 'Please enter your name.'); valid = false; }
    if (!phone || phone.replace(/\D/g, '').length < 10) { showErr('ct-phone', 'ct-phone-err', 'Please enter a valid phone number.'); valid = false; }
    if (!service) { showErr('ct-service', 'ct-service-err', 'Please select a service.'); valid = false; }

    if (!valid) return;

    // Submit state
    submitBtn.disabled = true;
    if (btnText) btnText.style.display = 'none';
    if (spinner) spinner.style.display = 'flex';
    if (errorBox) errorBox.style.display = 'none';

    // Formspree / fetch
    var data = new FormData(form);
    fetch('https://formspree.io/f/xpwzkqdw', { method: 'POST', body: data, headers: { 'Accept': 'application/json' } })
      .then(function (res) {
        if (res.ok) {
          form.style.display = 'none';
          if (successBox) successBox.style.display = 'flex';
        } else {
          throw new Error('server');
        }
      })
      .catch(function () {
        submitBtn.disabled = false;
        if (btnText) btnText.style.display = 'inline';
        if (spinner) spinner.style.display = 'none';
        if (errorBox) errorBox.style.display = 'flex';
      });
  });
})();
</script>
