---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaService from '../../components/SchemaService.astro';
import SchemaFAQ from '../../components/SchemaFAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import Footer from '../../components/Footer.astro';
import CommercialProjectScopeBuilder from '../../components/magnets/CommercialProjectScopeBuilder.astro';

const siteUrl = 'https://allmasonryservices.com';
const pageUrl = `${siteUrl}/services/commercial-brick-stone`;
const phone = '773-656-2107';

const aggregateRatingSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "All Masonry Services",
  "url": siteUrl,
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.8", "reviewCount": "92", "bestRating": "5" }
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Commercial Brick & Stone Project Scope Builder",
  "description": "Free commercial masonry scope builder for developers and GCs in Chicagoland. Define your project scope before your first contractor meeting.",
  "url": `${siteUrl}/services/commercial-brick-stone#scope-builder`,
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How Commercial Brick & Stone Masonry Works: AMS 5-Step Process",
  "description": "How AMS delivers large-scale commercial brick and stone masonry in Chicagoland.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Bid Review & Material Coordination",
      "text": "We review drawings, spec sheets, and material requirements before bidding — and confirm material availability before submitting a bid. No allowance-based surprises."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Pre-Construction Planning",
      "text": "We coordinate with your GC on start date, access, sequencing, and inspection scheduling before mobilization."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Masonry Installation",
      "text": "We install per drawings and spec — joint width, coursing, mortar compressive strength, and drainage systems."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Quality Control & Inspection",
      "text": "We maintain daily logs, photograph progress, and coordinate required inspections with your GC."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Punch List & Closeout",
      "text": "We complete a joint punch list with your GC, resolve all items before final payment, and provide lien waivers, insurance certificates, and as-built documentation."
    }
  ]
};

const faqItems = [
  {
    question: "What types of commercial projects does AMS handle?",
    answer: "Storefronts, retail facades, office buildings, mixed-use developments, multi-unit residential exteriors, and commercial additions and renovations. AMS works with general contractors, developers, and commercial property owners throughout Chicagoland."
  },
  {
    question: "Do you provide prevailing wage work?",
    answer: "Contact us to discuss your project. We have completed public and prevailing wage projects and are familiar with the documentation requirements involved."
  },
  {
    question: "What documentation do you provide at closeout?",
    answer: "Lien waivers, insurance certificates, inspection reports, as-built notes, and warranty documentation — delivered at final payment, not after being asked twice."
  },
  {
    question: "Do you work with architects on material specifications?",
    answer: "Yes — we coordinate on material specs, submittals, and shop drawings, and can provide material samples for specification approval before work begins."
  },
  {
    question: "How far in advance should commercial projects contact AMS?",
    answer: "For large projects ($200K+), we recommend 6–8 weeks minimum lead time. Mid-size projects: 3–4 weeks. Current crew availability is confirmed on your first call."
  },
  {
    question: "Does AMS carry commercial-grade insurance?",
    answer: "$2.5M general liability, workers' compensation, and additional insured endorsements available. Insurance certificates are provided before mobilization, not after you ask."
  },
  {
    question: "Can you work on occupied commercial properties?",
    answer: "Yes — we're experienced with phased work, dust containment, after-hours scheduling, and coordination with property management and building operations."
  },
  {
    question: "Is AMS licensed for commercial masonry in Illinois?",
    answer: "Yes — licensed in Illinois (License #MA-104-018887). We pull all required permits, schedule inspections, and maintain a clean inspection record on every commercial project."
  }
];
---

<BaseLayout
  title="Commercial Brick & Stone Masonry Chicago | All Masonry Services"
  description="Large-scale commercial brick and stone masonry for Chicagoland developers and GCs. Storefronts, office buildings, mixed-use developments. 19+ years. Call 773-656-2107."
  canonical={pageUrl}
  ogImage="/og-image.jpg"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(aggregateRatingSchema)} />
  <SchemaService
    name="Commercial Masonry in Chicago & Chicagoland"
    description="Large-scale commercial brick and stone masonry for Chicagoland developers and GCs. Storefronts, office buildings, mixed-use developments. 19+ years. Call 773-656-2107."
    url={pageUrl}
    provider="All Masonry Services"
    providerUrl={siteUrl}
    areaServed="Chicago, Chicagoland, IL"
    serviceType="Commercial Masonry"
  />
  <SchemaFAQ items={faqItems} />

  <!-- ═══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <section class="sp-hero">
    <div class="sp-hero-inner">
      <div class="sp-hero-copy">
        <div class="sp-hero-badges">
          <span class="sp-badge sp-badge--gold">Commercial Masonry</span>
          <span class="sp-badge sp-badge--outline">Chicagoland</span>
        </div>
        <h1 class="sp-hero-h1">Commercial Brick &amp; Stone<br><em>in Chicago &amp; Chicagoland</em></h1>
        <p class="sp-hero-sub">Large-scale brick and stone masonry for developers, general contractors, and commercial property owners — delivered on schedule, to spec, and built to handle Chicagoland weather for decades.</p>
        <div class="sp-hero-stats">
          <div class="sp-stat">
            <span class="sp-stat-num">4.8★</span>
            <span class="sp-stat-label">Rating</span>
          </div>
          <div class="sp-stat-divider" aria-hidden="true"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">92</span>
            <span class="sp-stat-label">Reviews</span>
          </div>
          <div class="sp-stat-divider" aria-hidden="true"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">19+</span>
            <span class="sp-stat-label">Years</span>
          </div>
          <div class="sp-stat-divider" aria-hidden="true"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">19</span>
            <span class="sp-stat-label">Cities</span>
          </div>
        </div>
        <div class="sp-hero-actions">
          <a href={`tel:${phone}`} class="sp-btn sp-btn--primary">Call {phone}</a>
          <a href="#scope-builder" class="sp-btn sp-btn--ghost">Free Scope Builder</a>
        </div>
      </div>
      <div class="sp-hero-img-wrap">
        <img
          src="/images/why-choose-us-brick.webp"
          alt="Commercial brick and stone masonry installation in Chicagoland"
          width="420"
          height="500"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       TRUST BAR
  ═══════════════════════════════════════════════ -->
  <section class="sp-trust">
    <div class="sp-trust-inner">
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Licensed &amp; Insured
      </div>
      <div class="sp-trust-sep" aria-hidden="true"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Commercial GC Experience
      </div>
      <div class="sp-trust-sep" aria-hidden="true"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Written Schedule Commitment
      </div>
      <div class="sp-trust-sep" aria-hidden="true"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        19+ Years
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       PROBLEM SECTION
  ═══════════════════════════════════════════════ -->
  <section class="sp-problem">
    <div class="sp-problem-inner">
      <div class="sp-section-label">The Problem</div>
      <h2 class="sp-section-h2">What Commercial Clients<br><em>Actually Deal With</em></h2>
      <p class="sp-section-sub">Commercial masonry failures aren't just repair costs. They're delays, change orders, failed inspections, and projects that go over budget in the most visible way possible.</p>
      <div class="sp-problem-grid">
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3 class="sp-problem-title">Subs Who Miss Schedule</h3>
          <p class="sp-problem-body">Masonry is on the critical path in commercial construction. A crew that doesn't show on their committed start date pushes framing, envelope, windows — everything downstream. We've never missed a committed start date.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          </div>
          <h3 class="sp-problem-title">Hidden Change Orders</h3>
          <p class="sp-problem-body">Scope creep and material substitutions after the contract is signed are how masonry budgets blow up. AMS provides complete written bids with no allowances that expand after signing.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <h3 class="sp-problem-title">Failed Inspections</h3>
          <p class="sp-problem-body">Commercial masonry inspections check mortar strength, joint consistency, reinforcement, and drainage — failures mean stop-work orders and costly corrections. We pass every inspection.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
          </div>
          <h3 class="sp-problem-title">Material Mismatch on Multi-Phase Projects</h3>
          <p class="sp-problem-body">Commercial projects with multiple masonry phases need consistent material through all phases. Running out of matched material mid-project creates permanent visible inconsistency on a finished building.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       PROCESS SECTION
  ═══════════════════════════════════════════════ -->
  <section class="sp-process">
    <div class="sp-process-inner">
      <div class="sp-section-label">How It Works</div>
      <h2 class="sp-section-h2">Our Commercial Masonry<br><em>Process</em></h2>
      <p class="sp-section-sub">From bid review to final closeout — delivered on schedule, to spec, no surprises.</p>
      <div class="sp-process-steps">
        <div class="sp-step">
          <div class="sp-step-num" aria-hidden="true">01</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Bid Review &amp; Material Coordination</h3>
            <p class="sp-step-body">We review drawings, spec sheets, and material requirements before bidding — and confirm material availability before submitting a bid. No allowance-based surprises.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Commercial bids with material 'allowances' are an invitation to disputes. We confirm availability and price before we sign anything.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num" aria-hidden="true">02</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Pre-Construction Planning</h3>
            <p class="sp-step-body">We coordinate with your GC on start date, access, sequencing, and inspection scheduling before mobilization.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Commercial sites have multiple trades and tight sequencing. Arriving without pre-coordination creates conflict and delays you can't afford.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num" aria-hidden="true">03</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Masonry Installation</h3>
            <p class="sp-step-body">We install per drawings and spec — joint width, coursing, mortar compressive strength, and drainage systems. Every deviation from drawings is submitted as an RFI before the work happens, not after.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Field substitutions made without documented approval are the most common cause of commercial masonry disputes. We don't make them.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num" aria-hidden="true">04</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Quality Control &amp; Inspection</h3>
            <p class="sp-step-body">We maintain daily logs, photograph progress, and coordinate required inspections with your GC. We're ready for inspection when we say we're ready.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Surprise inspection failures delay the entire project. We know what inspectors check and we build to those standards.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num" aria-hidden="true">05</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Punch List &amp; Closeout</h3>
            <p class="sp-step-body">We complete a joint punch list with your GC, resolve all items before final payment, and provide lien waivers, insurance certificates, and as-built documentation.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Clean commercial closeout requires clean documentation. We provide it — first time, without being asked twice.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    (function() {
      function initStepAnimations() {
        var gsap = window.__gsap;
        var ScrollTrigger = window.__ScrollTrigger;
        if (!gsap || !ScrollTrigger) return;
        var steps = document.querySelectorAll('.sp-step');
        if (!steps.length) return;
        steps.forEach(function(step) {
          gsap.fromTo(step, { opacity: 0, x: -24 }, {
            opacity: 1, x: 0, duration: 0.55, ease: 'power2.out',
            scrollTrigger: { trigger: step, start: 'top 88%', toggleActions: 'play none none reverse' }
          });
        });
      }
      // Always wait for animations:ready — prevents race with BaseLayout ScrollTrigger.kill()
      window.removeEventListener('animations:ready', window.__spStepAnimReady);
      window.__spStepAnimReady = initStepAnimations;
      window.addEventListener('animations:ready', window.__spStepAnimReady);
      if (window.__lenis) initStepAnimations();
    })();
  </script>

  <!-- ═══════════════════════════════════════════════
       WHY AMS SECTION
  ═══════════════════════════════════════════════ -->
  <section class="sp-why">
    <div class="sp-why-inner">
      <div class="sp-section-label">Why AMS</div>
      <h2 class="sp-section-h2">Why Commercial Clients<br><em>Choose AMS</em></h2>
      <div class="sp-why-grid">
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">01</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Schedule in Writing</h3>
            <p class="sp-why-body">We commit to a start date and milestone schedule in our contract. We've never missed a committed commercial start date.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">02</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Complete Written Bids</h3>
            <p class="sp-why-body">No material allowances, no TBD line items. Every bid covers the full scope with confirmed pricing. What you sign is what you pay.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">03</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Free Project Scope Builder</h3>
            <p class="sp-why-body">Use our commercial scope builder to define your project parameters before your first call with us. Output ready for your GC or architect.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">04</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Family-Owned — Owner Accountability</h3>
            <p class="sp-why-body">Not a franchise — when you call AMS you reach the people doing the work. No layers of management between you and the crew.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       TOOL SECTION
  ═══════════════════════════════════════════════ -->
  <section class="sp-tool" id="scope-builder">
    <div class="sp-tool-inner">
      <div class="sp-tool-header">
        <div class="sp-section-label sp-section-label--light">Free Tool</div>
        <h2 class="sp-tool-h2">Free Commercial Brick &amp; Stone<br><em>Project Scope Builder</em></h2>
      </div>

      <div class="sp-tool-warning-hook" role="note">
        <p class="sp-tool-warning-intro">Walk into your GC or architect meeting with a defined scope — not vague requirements.</p>
        <ul class="sp-tool-warning-list">
          <li>Storefront, retail, or office building facade</li>
          <li>Mixed-use or multi-unit exterior masonry</li>
          <li>Commercial addition or renovation</li>
        </ul>
        <p class="sp-tool-warning-cta">Define your scope in 60 seconds — get a document ready for your GC or architect. Free.</p>
      </div>

      <div class="sp-tool-social" aria-label="Tool usage statistics">
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">480+</span>
          <span class="sp-tool-stat-label">Commercial scopes generated</span>
        </div>
        <div class="sp-tool-stat-sep" aria-hidden="true"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">4.8★</span>
          <span class="sp-tool-stat-label">Average rating · 92 reviews</span>
        </div>
        <div class="sp-tool-stat-sep" aria-hidden="true"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">60s</span>
          <span class="sp-tool-stat-label">To build your scope</span>
        </div>
      </div>

      <blockquote class="sp-tool-quote">
        <p>"Used the scope builder before our pre-bid meeting. Came in with a defined scope instead of vague requirements — saved at least an hour of back-and-forth with the GC."</p>
        <cite>— Property Developer · Chicagoland</cite>
      </blockquote>

      <p class="sp-section-sub" style="color: rgba(255,255,255,0.65); text-align: center; margin: 0 auto 32px; max-width: 640px;">Walk through your project type, dimensions, and material requirements — get a scope summary ready for your GC or first contractor meeting.</p>

      <div class="sp-tool-embed">
        <CommercialProjectScopeBuilder />
      </div>

      <p class="sp-tool-note">Scope output based on standard commercial masonry project parameters (2026). AMS's formal bid will reflect your specific drawings, spec, and site conditions.</p>

      <div class="sp-tool-faq" role="list">
        <div role="listitem">
          <h3 class="sp-tool-faq-q">Is the scope builder free?</h3>
          <p class="sp-tool-faq-a">Yes — free, no account required. Output can be downloaded or emailed for use in your GC meeting.</p>
        </div>
        <div role="listitem">
          <h3 class="sp-tool-faq-q">Does the scope builder replace a formal bid?</h3>
          <p class="sp-tool-faq-a">No — it's a preliminary planning tool to help you define requirements. AMS's formal bid requires drawings and a site visit.</p>
        </div>
        <div role="listitem">
          <h3 class="sp-tool-faq-q">What's next after I build my scope?</h3>
          <p class="sp-tool-faq-a">Contact us with your scope output and drawings — we'll schedule a project review and provide a complete written bid. <a href="/contact#form" class="sp-tool-faq-link">Get in touch here.</a></p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HowTo",
        "name": "How to Build a Commercial Masonry Scope Document in Chicago",
        "description": "Free commercial brick and stone project scope builder for Chicagoland GCs and developers. Define your masonry scope in 60 seconds — get a document ready for your architect or contractor.",
        "totalTime": "PT1M",
        "step": [
          { "@type": "HowToStep", "position": 1, "name": "Select building type and masonry scope items", "text": "Choose your building type (storefront, office, mixed-use, multi-unit, or industrial) and check the masonry scope items that apply: exterior facade, parapet, interior CMU, lintels, etc." },
          { "@type": "HowToStep", "position": 2, "name": "Select project scale and enter contact info", "text": "Choose project scale (small under $100K, medium $100K–$500K, or large over $500K) and enter your contact information for the personalized scope document." },
          { "@type": "HowToStep", "position": 3, "name": "Get your commercial scope document", "text": "Receive a personalized commercial masonry scope summary with cost range, crew plan, and bid package notes — free, instant, downloadable as a PDF ready for your GC meeting." }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is the commercial masonry scope builder free?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes — free, no account required. The scope document can be downloaded as a PDF for use in your GC or architect meeting." }
          },
          {
            "@type": "Question",
            "name": "Does the scope builder replace a formal commercial masonry bid?",
            "acceptedAnswer": { "@type": "Answer", "text": "No — it is a preliminary planning tool to help define requirements and budget. All Masonry Services' formal bid requires project drawings, spec sections, and a site visit to accurately quote labor, material, and site-specific conditions." }
          },
          {
            "@type": "Question",
            "name": "How do I get a formal commercial masonry bid in Chicago?",
            "acceptedAnswer": { "@type": "Answer", "text": "Contact All Masonry Services with your scope output, project drawings, and timeline. We'll schedule a project review and provide a complete written commercial bid within 48–72 hours. Call 773-656-2107 or contact us online." }
          }
        ]
      }
    ]
  }</script>

  <!-- ═══════════════════════════════════════════════
       PROJECTS SECTION
  ═══════════════════════════════════════════════ -->
  <section class="sp-projects">
    <div class="sp-projects-inner">
