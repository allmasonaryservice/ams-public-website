---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaService from '../../components/SchemaService.astro';
import SchemaFAQ from '../../components/SchemaFAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import Footer from '../../components/Footer.astro';
import FacadeCoverageEstimator from '../../components/magnets/FacadeCoverageEstimator.astro';

const siteUrl = 'https://allmasonryservices.com';
const pageUrl = `${siteUrl}/services/commercial-masonry-veneers`;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Commercial Masonry Veneers Facade Coverage Estimator",
  "description": "Free facade coverage estimator for commercial masonry veneer projects in Chicagoland. Get coverage area, material estimates, and project complexity notes.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "url": `${siteUrl}/services/commercial-masonry-veneers#facade-estimator`,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "All Masonry Services",
    "url": siteUrl
  }
};

const aggregateRatingSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "All Masonry Services",
  "url": siteUrl,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "92",
    "bestRating": "5"
  }
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How Commercial Masonry Veneer Installation Works: AMS 5-Step Process",
  "description": "How AMS installs commercial masonry veneer systems for storefronts, office buildings, and mixed-use developments.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Spec Review & System Selection",
      "text": "We review the project spec and select a veneer system — substrate, waterproofing, lath, scratch coat, and veneer — from compatible manufacturers per the architect's requirements."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Pre-Installation Coordination",
      "text": "We coordinate with the GC on sequencing — windows, waterproofing, and roofing must be completed in the correct order relative to veneer."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Substrate & Waterproofing Installation",
      "text": "We install waterproof barrier, lath fastened to structural framing, and scratch coat per spec — with inspection points coordinated with the GC before veneer placement begins."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Veneer Installation & Quality Control",
      "text": "We install veneer to the approved pattern with consistent mortar joints, movement joints at required intervals, and daily progress documentation."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Closeout & Special Inspection Documentation",
      "text": "We complete special inspection logs, clean-up, and punch list before closing out — with documentation package ready for your GC."
    }
  ]
};

const faqItems = [
  {
    question: "What is the difference between commercial and residential veneer installation?",
    answer: "Commercial installations typically involve larger areas, higher wind loads, special inspection requirements, and multi-trade coordination. Commercial projects also require specific documentation — special inspection logs, lien waivers, certificates of insurance — that residential projects don't. AMS is set up for both."
  },
  {
    question: "What is a special inspection for masonry?",
    answer: "Special inspections are third-party quality verifications required by the IBC for certain commercial masonry applications. An inspector verifies mortar mix, joint consistency, and grout placement during construction. AMS coordinates special inspection scheduling and maintains logs."
  },
  {
    question: "Do you work with spec'd veneer systems?",
    answer: "Yes — we install systems from major commercial veneer manufacturers per architect's specification. We review submittals and can provide product data sheets for spec approval."
  },
  {
    question: "Can you phase commercial veneer work around occupied tenants?",
    answer: "Yes — we're experienced with phased commercial work including after-hours installation and dust containment for occupied retail and office properties."
  },
  {
    question: "How does commercial facade veneer handle wind load?",
    answer: "Commercial veneers are designed to transfer lateral loads through the lath and substrate system to the structural framing — not to rely on adhesion alone. Lath fastening to structural framing (not just sheathing) is the critical requirement. AMS installs to this standard."
  },
  {
    question: "Is AMS certified or approved for commercial masonry veneers?",
    answer: "AMS is a licensed masonry contractor in Illinois with commercial project experience. We can work with your architect on material submittals and system approval documentation."
  },
  {
    question: "Do you provide warranties on commercial veneer work?",
    answer: "Yes — our commercial veneer warranty covers installation deficiencies. Material warranties are passed through from the manufacturer. Terms provided with every commercial contract."
  },
  {
    question: "What's the lead time for a commercial facade project?",
    answer: "Contact us 6–10 weeks before your required mobilization date for large commercial projects. Mid-size projects typically need 3–5 weeks of lead time."
  }
];
---

<BaseLayout
  title="Commercial Masonry Veneers Chicago | All Masonry Services"
  description="Commercial masonry veneer systems for storefronts, office buildings, and mixed-use developments in Chicagoland. Full facade coverage estimation. Call 773-656-2107."
  canonical={pageUrl}
  ogImage="/og-image.jpg"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(aggregateRatingSchema)} />
  <SchemaService
    name="Commercial Masonry Veneers in Chicago & Chicagoland"
    description="Commercial masonry veneer systems for storefronts, office buildings, and mixed-use developments in Chicagoland. System-specified, GC-coordinated, code-compliant."
    url={pageUrl}
    provider="All Masonry Services"
    providerUrl={siteUrl}
    areaServed="Chicago, Chicagoland, IL"
    serviceType="Commercial Masonry Veneer"
  />
  <SchemaFAQ items={faqItems} />

  <!-- ─── 1. HERO ─── -->
  <section class="sp-hero">
    <div class="sp-hero-inner">
      <div class="sp-hero-content">
        <div class="sp-hero-badges">
          <span class="sp-badge sp-badge--gold">Free Estimates</span>
          <span class="sp-badge sp-badge--outline">Family-Owned Since 2007</span>
        </div>
        <h1 class="sp-hero-h1">
          Commercial Masonry Veneers<br>
          <em>in Chicago &amp; Chicagoland</em>
        </h1>
        <p class="sp-hero-sub">
          Full commercial facade veneer systems — brick, stone, and masonry panel installation for storefronts, office buildings, and mixed-use developments, installed to spec and built to last.
        </p>
        <div class="sp-hero-stats">
          <div class="sp-stat">
            <span class="sp-stat-num">500+</span>
            <span class="sp-stat-label">Projects Completed</span>
          </div>
          <div class="sp-stat-divider"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">4.8★</span>
            <span class="sp-stat-label">92 Google Reviews</span>
          </div>
          <div class="sp-stat-divider"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">19+</span>
            <span class="sp-stat-label">Years Experience</span>
          </div>
        </div>
        <div class="sp-hero-actions">
          <a href="/contact" class="sp-btn sp-btn--primary">Get a Free Estimate</a>
          <a href="tel:7736562107" class="sp-btn sp-btn--ghost" aria-label="Call 773-656-2107">Call 773-656-2107</a>
        </div>
      </div>
      <div class="sp-hero-img-wrap">
        <img
          src="/images/project-brick-exterior.jpg"
          alt="Commercial masonry veneer facade on a Chicagoland office building"
          width="600"
          height="750"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ─── 2. TRUST BAR ─── -->
  <section class="sp-trust">
    <div class="sp-trust-inner">
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Licensed &amp; Insured
      </div>
      <div class="sp-trust-sep"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Commercial Facade Experience
      </div>
      <div class="sp-trust-sep"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Code-Compliant Systems
      </div>
      <div class="sp-trust-sep"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        19+ Years
      </div>
    </div>
  </section>

  <!-- ─── 3. PROBLEM / CONSEQUENCE ─── -->
  <section class="sp-problem">
    <div class="sp-problem-inner">
      <div class="sp-section-label">Why It Matters</div>
      <h2 class="sp-section-h2">Commercial Veneer Failures<br><em>Are Expensive and Visible</em></h2>
      <p class="sp-section-sub">
        A veneer failure on a commercial building isn't just a repair — it's a building with scaffolding in front of it, a closed storefront, and a property manager trying to explain to tenants why the facade is failing at year 4.
      </p>
      <div class="sp-problem-grid">
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="sp-problem-title">Incompatible System Components</h3>
          <p class="sp-problem-body">Commercial veneer systems require compatible waterproofing, lath, scratch coat, and mortar — all from the same approved system. Mixing components from different manufacturers voids warranties and causes failures.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3 class="sp-problem-title">Inadequate Substrate Attachment</h3>
          <p class="sp-problem-body">Commercial veneers span large areas with high wind loads. Lath attached only to sheathing, not to structural framing, pulls away under lateral load — creating cascading delamination.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3 class="sp-problem-title">No Third-Party Inspection</h3>
          <p class="sp-problem-body">Commercial projects often require special inspections for masonry work. Skipping or cutting corners on special inspections creates liability exposure and may void the building's certificate of occupancy.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
          </div>
          <h3 class="sp-problem-title">Sequencing Conflicts with Other Trades</h3>
          <p class="sp-problem-body">Commercial veneer must be coordinated with window installation, waterproofing, and roofing. Installed out of sequence — particularly before windows are flashed — guarantees water intrusion at every penetration.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 4. PROCESS ─── -->
  <section class="sp-process">
    <div class="sp-process-inner">
      <div class="sp-section-label">How We Work</div>
      <h2 class="sp-section-h2">Our Commercial Veneer<br><em>Process</em></h2>
      <p class="sp-section-sub">
        From spec review to special inspection documentation — system-installed, GC-coordinated, built to pass.
      </p>
      <div class="sp-process-steps">
        <div class="sp-step">
          <div class="sp-step-num">01</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Spec Review &amp; System Selection</h3>
            <p class="sp-step-body">We review the project spec and select a veneer system — substrate, waterproofing, lath, scratch coat, and veneer — from compatible manufacturers per the architect's requirements.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Spec'd systems have tested compatibility data. Field substitutions without engineering review are a warranty void and a failure waiting to happen.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">02</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Pre-Installation Coordination</h3>
            <p class="sp-step-body">We coordinate with the GC on sequencing — windows, waterproofing, and roofing must be completed in the correct order relative to veneer.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Veneer installed before window flashing is complete guarantees water infiltration at window heads. This sequence error is the most common cause of commercial envelope failures.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">03</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Substrate &amp; Waterproofing Installation</h3>
            <p class="sp-step-body">We install waterproof barrier, lath fastened to structural framing, and scratch coat per spec — with inspection points coordinated with the GC before veneer placement begins.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> This is the invisible work that determines whether the veneer lasts 5 years or 30. We don't rush the substrate for schedule.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">04</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Veneer Installation &amp; Quality Control</h3>
            <p class="sp-step-body">We install veneer to the approved pattern with consistent mortar joints, movement joints at required intervals, and daily progress documentation.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Daily documentation gives your GC visibility and provides evidence for special inspection records. We make inspection coordination easy.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">05</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Closeout &amp; Special Inspection Documentation</h3>
            <p class="sp-step-body">We complete special inspection logs, clean-up, and punch list before closing out — with documentation package ready for your GC.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Clean special inspection records are required for certificate of occupancy on commercial projects. We don't leave you chasing paperwork.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 5. WHY AMS ─── -->
  <section class="sp-why">
    <div class="sp-why-inner">
      <div class="sp-section-label">What Sets Us Apart</div>
      <h2 class="sp-section-h2">Why Commercial Clients<br><em>Choose AMS for Facade Veneers</em></h2>
      <div class="sp-why-grid">
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">01</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">System Compatibility Expertise</h3>
            <p class="sp-why-body">We install complete veneer systems — not just the visible layer. Compatible components, correct installation sequence, and documented special inspections.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">02</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">GC Sequencing Coordination</h3>
            <p class="sp-why-body">We integrate with your project schedule — windows, waterproofing, roofing — and communicate proactively when sequencing issues arise.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">03</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Free Facade Coverage Estimator</h3>
            <p class="sp-why-body">Estimate commercial facade coverage before your first meeting with us. Dimensions in, coverage and cost range out.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">04</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Family-Owned — Owner Accountability</h3>
            <p class="sp-why-body">No layers of management. You deal directly with the people responsible for the work.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 6. TOOL EMBED ─── -->
  <section class="sp-tool" id="facade-estimator">
    <div class="sp-tool-inner">
      <div class="sp-tool-header">
        <div class="sp-section-label sp-section-label--light">Free Tool — No Sign-Up Required</div>
        <h2 class="sp-tool-h2">Free Commercial Masonry Veneers<br><em>Facade Coverage Estimator</em></h2>
        <div class="sp-tool-warning-hook" aria-label="Project type checklist">
          <p class="sp-tool-warning-intro">Need facade coverage numbers before the formal takeoff?</p>
          <ul class="sp-tool-warning-list">
            <li>Full building exterior or partial facade</li>
            <li>Storefront, retail, or mixed-use cladding</li>
            <li>Parking structure or industrial facing</li>
          </ul>
          <p class="sp-tool-warning-cta">Enter building dimensions — get coverage area, material estimate, and cost range. Free.</p>
        </div>
        <p class="sp-tool-sub">Building dimensions → net coverage, material count, Chicago commercial 2026 cost range. 90 seconds. Free.</p>
      </div>
      <div class="sp-tool-social">
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">420+</span>
          <span class="sp-tool-stat-label">Commercial facade estimates generated</span>
        </div>
        <div class="sp-tool-stat-sep"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">4.8★</span>
          <span class="sp-tool-stat-label">Average rating · 92 reviews</span>
        </div>
        <div class="sp-tool-stat-sep"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">90s</span>
          <span class="sp-tool-stat-label">To get your estimate</span>
        </div>
      </div>
      <blockquote class="sp-tool-quote">
        <p>"The facade estimator gave our project team a quick coverage check before the formal takeoff. It matched our architect's numbers within 5%. Useful for early budget conversations."</p>
        <cite>— GC Project Manager · Chicagoland</cite>
      </blockquote>
      <div class="sp-tool-embed">
        <FacadeCoverageEstimator />
      </div>
      <p class="sp-tool-note">
        Coverage estimates based on standard commercial veneer panel configurations (2026). Your formal bid from AMS requires project drawings and a site visit.
      </p>
      <div class="sp-tool-faq">
        <div class="sp-tool-faq-item">
          <h3 class="sp-tool-faq-q">Is the facade estimator free?</h3>
          <p class="sp-tool-faq-a">Yes — free, no account required. Intended for preliminary commercial planning and early budget discussions.</p>
        </div>
        <div class="sp-tool-faq-item">
          <h3 class="sp-tool-faq-q">Does this replace a formal bid?</h3>
          <p class="sp-tool-faq-a">No — it's a planning tool. AMS's formal bid requires project drawings and a site visit to account for openings, details, and site conditions.</p>
        </div>
        <div class="sp-tool-faq-item">
          <h3 class="sp-tool-faq-q">How do I get a formal bid?</h3>
          <p class="sp-tool-faq-a">Contact us with your project documents — drawings, spec, and a project timeline. We'll schedule a project review and provide a complete written bid. <a href="/contact" class="sp-tool-faq-link">Get in touch here.</a></p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HowTo",
        "name": "How to Estimate Commercial Masonry Veneer Coverage in Chicago",
        "description": "Free commercial facade coverage estimator for Chicagoland GCs and developers. Enter building dimensions, get net coverage, material count, and cost range.",
        "totalTime": "PT2M",
        "step": [
          { "@type": "HowToStep", "position": 1, "name": "Enter building dimensions and elevations", "text": "Input your building width, depth, number of stories, and select which elevations (front, rear, left, right) will be clad with masonry veneer." },
          { "@type": "HowToStep", "position": 2, "name": "Select veneer system and enter openings", "text": "Choose your veneer system (thin brick, natural stone, limestone panel, or manufactured stone) and enter the total square footage of openings to deduct." },
          { "@type": "HowToStep", "position": 3, "name": "Get your facade estimate", "text": "Receive net coverage area, material quantity with waste factor, Chicago commercial 2026 cost range, and project complexity notes — free, instant, downloadable as a PDF." }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is the commercial facade coverage estimator free?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes — free, no account required. Intended for preliminary commercial planning and early budget discussions with your GC or architect." }
          },
          {
            "@type": "Question",
            "name": "Does the facade estimator replace a formal bid?",
            "acceptedAnswer": { "@type": "Answer", "text": "No — it is a planning tool for preliminary coverage and budgeting. All Masonry Services' formal bid requires project drawings and a site visit to account for openings, anchorage details, and site conditions." }
          },
          {
            "@type": "Question",
            "name": "How do I get a formal commercial masonry veneer bid in Chicago?",
            "acceptedAnswer": { "@type": "Answer", "text": "Contact All Masonry Services with your project drawings, spec section, and project timeline. We'll schedule a project review and provide a complete written bid within 48–72 hours. Call 773-656-2107." }
          }
        ]
      }
    ]
  }</script>

  <!-- ─── 7. FEATURED PROJECTS ─── -->
  <section class="sp-projects">
    <div class="sp-projects-inner">
      <div class="sp-section-label">Recent Work</div>
      <h2 class="sp-section-h2">Commercial Veneer Projects<br><em>Across Chicagoland</em></h2>
      <div class="sp-projects-grid">
        <div class="sp-project-card">
          <div class="sp-project-img-wrap">
            <img
              src="/images/project-brick-exterior.jpg"
              alt="Office building stone veneer facade in Chicagoland"
              width="540"
              height="405"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="sp-project-info">
            <span class="sp-project-location">Chicagoland</span>
            <h3 class="sp-project-title">Office Building — Stone Veneer Facade</h3>
            <p class="sp-project-desc">Full exterior stone veneer on a 5-story office building — system-specified, GC-coordinated, special inspections documented. Certificate of occupancy issued on schedule.</p>
          </div>
        </div>
        <div class="sp-project-card">
          <div class="sp-project-img-wrap">
            <img
              src="/images/project-brick-restoration.jpg"
              alt="Retail storefront brick veneer renovation in Western Suburbs"
              width="540"
              height="405"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="sp-project-info">
            <span class="sp-project-location">Western Suburbs</span>
            <h3 class="sp-project-title">Retail Storefront Renovation</h3>
            <p class="sp-project-desc">Complete facade renovation using brick veneer on a national retail location — completed during off-peak hours to minimize tenant disruption.</p>
          </div>
        </div>
