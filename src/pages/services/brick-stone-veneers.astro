---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaService from '../../components/SchemaService.astro';
import SchemaFAQ from '../../components/SchemaFAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import Footer from '../../components/Footer.astro';
import VeneerCoverageCalculator from '../../components/magnets/VeneerCoverageCalculator.astro';

const siteUrl = 'https://allmasonryservices.com';
const pageUrl = `${siteUrl}/services/brick-stone-veneers`;
const phone = '773-656-2107';

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Brick & Stone Veneer Coverage Calculator",
  "description": "Free veneer coverage calculator for Chicagoland homeowners. Get panel counts and cost ranges before calling a contractor.",
  "url": `${siteUrl}/services/brick-stone-veneers#veneer-calculator`,
  "applicationCategory": "HomeAndGarden",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "provider": {
    "@type": "LocalBusiness",
    "name": "All Masonry Services Inc",
    "telephone": phone,
    "url": siteUrl
  }
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How Brick & Stone Veneer Installation Works: AMS 5-Step Process",
  "description": "How AMS installs brick and stone veneer systems in Chicagoland.",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Wall Assessment & Substrate Prep", "text": "We inspect the existing wall substrate, assess moisture conditions, and determine the correct waterproofing system before any veneer work begins." },
    { "@type": "HowToStep", "position": 2, "name": "Waterproof Barrier & Lath Installation", "text": "We install code-compliant waterproof barrier and metal lath, properly lapped and fastened to studs or masonry — not just the sheathing." },
    { "@type": "HowToStep", "position": 3, "name": "Scratch Coat Application", "text": "We apply a consistent, textured scratch coat and let it cure properly before beginning veneer placement." },
    { "@type": "HowToStep", "position": 4, "name": "Veneer Installation & Jointing", "text": "We place veneer in the approved pattern, cutting pieces on site for tight fits at corners and edges. Mortar joints are consistent in width and tooled while workable." },
    { "@type": "HowToStep", "position": 5, "name": "Movement Joints & Final Inspection", "text": "We install movement joints at all required locations, clean mortar haze from the veneer face, and walk the completed work with you." }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "All Masonry Services Inc",
  "url": siteUrl,
  "telephone": phone,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Chicago",
    "addressRegion": "IL",
    "addressCountry": "US"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "92"
  },
  "areaServed": "Chicagoland",
  "description": "Professional brick and stone veneer installation for Chicagoland homes. 19+ years experience.",
  "priceRange": "$$"
};

const faqItems = [
  {
    question: "What's the difference between full-thickness masonry and veneer?",
    answer: "Full-thickness masonry is structural — it carries load. Veneer is a facing material attached to a structural wall behind it. Veneer requires a correct substrate system (waterproofing, lath, scratch coat, movement joints) to last. AMS installs both full masonry and veneer systems."
  },
  {
    question: "Is brick veneer as durable as full brick?",
    answer: "Yes — properly installed brick veneer with correct waterproofing, lath, scratch coat, and movement joints will last as long as full brick. Veneer failures are almost always the result of improper substrate installation, not the brick itself."
  },
  {
    question: "Can veneer be installed on any wall?",
    answer: "Almost any wall with the correct substrate preparation. Some walls require additional reinforcement or extra waterproofing layers. AMS assesses your existing wall on every estimate visit before recommending a veneer approach."
  },
  {
    question: "How thick is brick or stone veneer?",
    answer: "Thin veneer panels run 3/4\"–1-1/4\" thick. Full adhered veneer runs 1-1/4\"–2\" thick. AMS installs both, and the right choice depends on your wall substrate, project scope, and budget."
  },
  {
    question: "Do I need permits for veneer installation?",
    answer: "Most Chicagoland municipalities require a permit for exterior veneer work. AMS pulls all required permits and schedules all required inspections — you don't need to manage that process."
  },
  {
    question: "How long does veneer installation take?",
    answer: "A feature wall or fireplace surround runs 1–2 days. A partial exterior takes 3–7 days. A full exterior veneer project can take 1–3 weeks depending on scope, material lead time, and access."
  },
  {
    question: "What maintenance does brick or stone veneer require?",
    answer: "Brick veneer: inspect mortar joints every 5–7 years, repoint where needed, keep weep holes clear. Stone veneer: reseal every 5–7 years. Both benefit from an annual visual inspection for cracking or efflorescence."
  },
  {
    question: "Are you licensed and insured for veneer installation?",
    answer: "Yes — licensed in Illinois (License #MA-104-018887), $2.5M general liability, workers' comp on all crew members. Proof of insurance available before work begins."
  }
];
---

<BaseLayout
  title="Brick & Stone Veneers Chicago | All Masonry Services"
  description="Professional brick and stone veneer installation for Chicagoland homes. Full veneer coverage calculation, material sourcing, and expert installation. 19+ years. Call 773-656-2107."
  canonical={pageUrl}
  ogImage="/og-image.jpg"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <SchemaService
    name="Masonry Veneers in Chicago & Chicagoland"
    description="Professional brick and stone veneer installation for Chicagoland homes. Full veneer coverage calculation, material sourcing, and expert installation. 19+ years. Call 773-656-2107."
    url={pageUrl}
    provider="All Masonry Services"
    providerUrl={siteUrl}
    areaServed="Chicago, Chicagoland, IL"
    serviceType="Masonry Veneers"
  />
  <SchemaFAQ items={faqItems} />

  <!-- HERO -->
  <section class="sp-hero" aria-labelledby="hero-h1">
    <div class="sp-hero-inner">
      <div class="sp-hero-text">
        <div class="sp-hero-badges">
          <span class="sp-badge sp-badge--gold">19+ Years</span>
          <span class="sp-badge sp-badge--outline">Licensed &amp; Insured</span>
        </div>
        <h1 class="sp-hero-h1" id="hero-h1">Brick &amp; Stone Veneers<br><em>in Chicago &amp; Chicagoland</em></h1>
        <p class="sp-hero-sub">Add the look of full masonry to any surface — brick veneer, stone veneer, and full-coverage systems installed with proper flashing, drainage, and substrate prep that lasts decades.</p>
        <div class="sp-hero-stats" aria-label="Company stats">
          <div class="sp-stat">
            <span class="sp-stat-num">4.8★</span>
            <span class="sp-stat-label">Rating</span>
          </div>
          <div class="sp-stat-divider" aria-hidden="true"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">92</span>
            <span class="sp-stat-label">Reviews</span>
          </div>
          <div class="sp-stat-divider" aria-hidden="true"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">500+</span>
            <span class="sp-stat-label">Homes</span>
          </div>
          <div class="sp-stat-divider" aria-hidden="true"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">19+</span>
            <span class="sp-stat-label">Years</span>
          </div>
        </div>
        <div class="sp-hero-actions">
          <a href={`tel:${phone}`} class="sp-btn sp-btn--primary">Call {phone}</a>
          <a href="/contact" class="sp-btn sp-btn--ghost">Free Estimate</a>
        </div>
      </div>
      <div class="sp-hero-img-wrap" aria-hidden="true">
        <img src="/images/why-choose-us-brick.webp" alt="Brick and stone veneer installation in Chicagoland" width="420" height="500" loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="sp-trust" aria-label="Trust indicators">
    <div class="sp-trust-inner">
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Licensed &amp; Insured
      </span>
      <div class="sp-trust-sep" aria-hidden="true"></div>
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Free Estimates
      </span>
      <div class="sp-trust-sep" aria-hidden="true"></div>
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Proper Flashing &amp; Drainage
      </span>
      <div class="sp-trust-sep" aria-hidden="true"></div>
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        19+ Years
      </span>
    </div>
  </div>

  <!-- PROBLEM SECTION -->
  <section class="sp-problem" aria-labelledby="problem-h2">
    <div class="sp-problem-inner">
      <p class="sp-section-label">Why It Matters</p>
      <h2 class="sp-section-h2" id="problem-h2">What Goes Wrong With<br><em>Veneer Installations</em></h2>
      <p class="sp-section-sub">Veneer looks simple — it's thin, light, and installable by any crew. That's exactly why most veneer failures happen. The substrate, drainage, and mortar system matter more than the veneer itself.</p>
      <div class="sp-problem-grid">
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <p class="sp-problem-title">No Weep Screed = Trapped Moisture</p>
          <p class="sp-problem-body">Veneer systems require a weep screed at the base to allow moisture to drain. Skip it — or install it incorrectly — and water accumulates behind the veneer, destroying the substrate within a few years.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          </div>
          <p class="sp-problem-title">Wrong Substrate = Delamination</p>
          <p class="sp-problem-body">Veneer adheres to a scratch coat. If the scratch coat isn't properly prepared or the wall isn't correctly waterproofed, the veneer delaminates — often in large sheets — within 3–5 years.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
          </div>
          <p class="sp-problem-title">Incompatible Mortar = Joint Failure</p>
          <p class="sp-problem-body">Veneer mortar must be compatible with both the scratch coat and the veneer material. Mixing systems causes joint failure, cracking, and color inconsistency that can't be patched.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <p class="sp-problem-title">No Movement Joints = Cracking</p>
          <p class="sp-problem-body">Veneer panels expand and contract. Without movement joints at corners and at regular intervals, thermal stress cracks the veneer face and opens the substrate to water infiltration.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS SECTION -->
  <section class="sp-process" aria-labelledby="process-h2">
    <div class="sp-process-inner">
      <p class="sp-section-label">How We Work</p>
      <h2 class="sp-section-h2" id="process-h2">Our Veneer Installation<br><em>Process</em></h2>
      <p class="sp-section-sub">From substrate assessment to final inspection — every layer of the system done right.</p>
      <div class="sp-process-steps">

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">01</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Wall Assessment &amp; Substrate Prep</p>
            <p class="sp-step-body">We inspect the existing wall substrate, assess moisture conditions, and determine the correct waterproofing system before any veneer work begins.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> Veneer is only as good as the wall behind it. Substrate problems that aren't addressed before installation become delamination problems 3–5 years later.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">02</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Waterproof Barrier &amp; Lath Installation</p>
            <p class="sp-step-body">We install code-compliant waterproof barrier and metal lath, properly lapped and fastened to studs or masonry — not just the sheathing.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> Lath fastened only to sheathing pulls away under load. Stud fastening is required for lasting adhesion — inspectors check this.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">03</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Scratch Coat Application</p>
            <p class="sp-step-body">We apply a consistent, textured scratch coat and let it cure properly before beginning veneer placement.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> An improperly cured or inconsistent scratch coat is the most common cause of veneer delamination. There's no shortcut here.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">04</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Veneer Installation &amp; Jointing</p>
            <p class="sp-step-body">We place veneer in the approved pattern, cutting pieces on site for tight fits at corners and edges. Mortar joints are consistent in width and tooled while workable.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> Joints that aren't tooled while mortar is workable don't shed water properly. This is the difference between a veneer that looks good for 20 years and one that starts failing after 5.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">05</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Movement Joints &amp; Final Inspection</p>
            <p class="sp-step-body">We install movement joints at all required locations, clean mortar haze from the veneer face, and walk the completed work with you.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> Movement joints are non-negotiable in Chicago's climate. Thermal expansion without relief cracks veneer faces — often at the worst possible location (corners, window surrounds).</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- WHY AMS -->
  <section class="sp-why" aria-labelledby="why-h2">
    <div class="sp-why-inner">
      <p class="sp-section-label">Why AMS</p>
      <h2 class="sp-section-h2" id="why-h2">Why Chicagoland Homeowners<br><em>Choose AMS for Veneer</em></h2>
      <div class="sp-why-grid">
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">01</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Full System Expertise</p>
            <p class="sp-why-body">We don't just install veneer — we install the complete system: barrier, lath, scratch coat, veneer, movement joints. Every component correct, every time.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">02</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Free Coverage Calculator</p>
            <p class="sp-why-body">Use our calculator before you call — get coverage area, material count, and cost range for your specific wall dimensions.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">03</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Code-Compliant Installation</p>
            <p class="sp-why-body">Every veneer installation follows current IBC and IRC requirements for waterproofing, lath, and movement joints. We pass inspections.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">04</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Family-Owned — Direct Owner Contact</p>
            <p class="sp-why-body">No franchise, no subs. You work with the people doing the installation.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TOOL SECTION -->
  <section class="sp-tool" id="veneer-calculator" aria-labelledby="tool-h2">
    <div class="sp-tool-inner">
      <div class="sp-tool-header">
        <p class="sp-section-label sp-section-label--light">Free Tool</p>
        <h2 class="sp-tool-h2" id="tool-h2">Free Brick &amp; Stone Veneer<br><em>Coverage Calculator</em></h2>
        <p class="sp-tool-sub">Wall dimensions + veneer type → coverage area, panel count, Chicago 2026 cost range. 60 seconds. Free.</p>
      </div>

      <div class="sp-tool-warning-hook" role="note" aria-label="Tool use cases">
        <p class="sp-tool-warning-intro">Know your panel count and budget before calling a contractor.</p>
        <ul class="sp-tool-warning-list">
          <li>Full exterior wall or front elevation veneer</li>
          <li>Fireplace surround, feature wall, or addition facing</li>
          <li>Retaining wall or outdoor structure</li>
        </ul>
        <p class="sp-tool-warning-cta">Enter wall dimensions — get coverage, panel count, and cost range in 60 seconds. Free.</p>
      </div>

      <div class="sp-tool-social" aria-label="Tool stats">
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">680+</span>
          <span class="sp-tool-stat-label">Veneer coverage calculations completed</span>
        </div>
        <div class="sp-tool-stat-sep" aria-hidden="true"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">4.8★</span>
          <span class="sp-tool-stat-label">Average rating · 92 reviews</span>
        </div>
        <div class="sp-tool-stat-sep" aria-hidden="true"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">60s</span>
          <span class="sp-tool-stat-label">To get your estimate</span>
        </div>
      </div>

      <blockquote class="sp-tool-quote">
        <p>"The calculator gave me an accurate panel count for my full front elevation. AMS's actual order was within 3% of the estimate. No overordering, no wasted material."</p>
        <cite>— Eric B., Homeowner · Clarendon Hills, IL</cite>
      </blockquote>

      <div class="sp-tool-embed" aria-label="Brick and stone veneer coverage calculator">
        <VeneerCoverageCalculator />
      </div>

      <p class="sp-tool-note">Coverage calculations based on standard veneer panel sizes and Chicagoland project data (2026). Your on-site estimate from AMS confirms coverage for non-standard patterns.</p>

      <div class="sp-tool-faq" aria-label="Calculator FAQ">
        <div>
          <p class="sp-tool-faq-q">Is the coverage calculator free?</p>
          <p class="sp-tool-faq-a">Yes — free, no sign-up. You only share contact info if you want a full calculation report emailed.</p>
        </div>
        <div>
          <p class="sp-tool-faq-q">How accurate is the panel count?</p>
          <p class="sp-tool-faq-a">The calculator uses standard panel coverage with a 10% waste factor for cuts. It's accurate for standard running bond pattern — your on-site estimate confirms for herringbone or other patterns.</p>
        </div>
        <div>
          <p class="sp-tool-faq-q">What's next after I run the calculator?</p>
          <p class="sp-tool-faq-a">Call 773-656-2107 or fill out our <a href="/contact" class="sp-tool-faq-link">contact form</a>. We'll visit on-site, verify coverage, and give you a written estimate with material specification.</p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HowTo",
        "name": "How to Calculate Brick and Stone Veneer Coverage in Chicago",
        "description": "Free brick and stone veneer coverage calculator for Chicagoland homeowners. Enter wall dimensions and veneer type, get panel count and cost range in 60 seconds.",
        "totalTime": "PT1M",
        "step": [
          { "@type": "HowToStep", "position": 1, "name": "Enter wall dimensions", "text": "Input your wall width and height in feet. For multiple surfaces, add them together or run the calculator once per surface." },
          { "@type": "HowToStep", "position": 2, "name": "Select veneer type and deductions", "text": "Choose your veneer system (thin brick, full stone, limestone, or manufactured stone) and enter the square footage of any windows or doors to deduct." },
          { "@type": "HowToStep", "position": 3, "name": "Get your coverage and cost estimate", "text": "Receive net coverage area, panel count with 10% waste factor, and Chicago 2026 cost range — free, instant, downloadable as a PDF." }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is the brick and stone veneer coverage calculator free?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes — free, no sign-up required. You only share contact info if you want a full calculation report as a PDF." }
          },
          {
            "@type": "Question",
            "name": "How accurate is the veneer panel count?",
            "acceptedAnswer": { "@type": "Answer", "text": "The calculator uses standard panel coverage with a 10% waste factor built in for cuts and breakage. It is accurate for standard running bond pattern. Your on-site estimate from All Masonry Services confirms coverage for herringbone or other custom patterns." }
          },
          {
            "@type": "Question",
            "name": "What is the cost of brick veneer installation in Chicago in 2026?",
            "acceptedAnswer": { "@type": "Answer", "text": "Brick and stone veneer installation in the Chicago metro area typically ranges from $18–$38 per square foot installed, depending on veneer type, wall height, substrate condition, and site access. Run the free calculator for a range specific to your project, then contact All Masonry Services for a written estimate." }
          }
        ]
      }
    ]
  }</script>

  <!-- PROJECTS -->
  <section class="sp-projects" aria-labelledby="projects-h2">
    <div class="sp-projects-inner">
      <p class="sp-section-label">Recent Work</p>
      <h2 class="sp-section-h2" id="projects-h2">Brick &amp; Stone Veneer<br><em>Recent Projects</em></h2>
      <p class="sp-section-sub">A sample of recent veneer installations across Chicagoland.</p>
      <div class="sp-projects-grid">
        <div class="sp-project-card">
          <div class="sp-project-img-wrap">
            <img src="/images/project-brick-exterior.webp" alt="Full front elevation brick veneer in Clarendon Hills" width="400" height="240" loading="lazy" decoding="async" />
