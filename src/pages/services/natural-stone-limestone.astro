---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaService from '../../components/SchemaService.astro';
import SchemaFAQ from '../../components/SchemaFAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import Footer from '../../components/Footer.astro';
import StoneStyleSelector from '../../components/magnets/StoneStyleSelector.astro';

const siteUrl = 'https://allmasonryservices.com';
const pageUrl = `${siteUrl}/services/natural-stone-limestone`;
const phone = '773-656-2107';

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Natural Stone & Limestone Style Selector",
  "description": "Free stone style selector for Chicagoland homeowners. Get personalized stone recommendations with care and cost guidance.",
  "url": `${siteUrl}/services/natural-stone-limestone#stone-selector`,
  "applicationCategory": "HomeAndGarden",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "provider": {
    "@type": "LocalBusiness",
    "name": "All Masonry Services Inc",
    "telephone": phone,
    "url": siteUrl
  }
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How Natural Stone & Limestone Installation Works: AMS 5-Step Process",
  "description": "How AMS installs natural stone and limestone for facades, fireplaces, and architectural features in Chicagoland.",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Style & Material Consultation", "text": "We evaluate your home's architecture, existing materials, and your aesthetic goals — then recommend specific stone types and finishes that work together." },
    { "@type": "HowToStep", "position": 2, "name": "Stone Sourcing & Vetting", "text": "We source stone from reputable suppliers and physically inspect material for consistency — color, texture, and cut quality." },
    { "@type": "HowToStep", "position": 3, "name": "Substrate & Waterproofing Prep", "text": "We prepare the substrate with correct waterproofing membrane, drainage layer, and mortar bed per stone type." },
    { "@type": "HowToStep", "position": 4, "name": "Stone Installation & Jointing", "text": "We install stone in deliberate patterns — dry-laid first to check fit and appearance, then set in mortar with correct joint width and profile." },
    { "@type": "HowToStep", "position": 5, "name": "Sealing & Final Inspection", "text": "After curing, we apply appropriate sealer for the stone type, clean the face, and walk the completed work with you before closeout." }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "All Masonry Services Inc",
  "url": siteUrl,
  "telephone": phone,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Chicago",
    "addressRegion": "IL",
    "addressCountry": "US"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "92"
  },
  "areaServed": "Chicagoland",
  "description": "Premium natural stone and limestone installation for Chicagoland homes. 19+ years experience.",
  "priceRange": "$$"
};

const faqItems = [
  {
    question: "What's the difference between natural stone, limestone, and manufactured stone?",
    answer: "Natural stone is quarried with irregular variation in color and texture. Limestone is a sedimentary stone that cuts cleanly and consistently — often used for architectural features and facades. Manufactured stone is a concrete product that mimics stone — less durable and less valuable. AMS installs natural stone and limestone only."
  },
  {
    question: "How do I know if my home can support limestone?",
    answer: "Limestone is heavy and requires proper structural support — a ledger, flashing, and in some cases structural reinforcement. AMS assesses your home's substrate and structural capacity on every estimate visit before recommending an installation approach."
  },
  {
    question: "Is limestone good for Chicago winters?",
    answer: "Yes — Indiana limestone in particular was quarried and shipped to Chicago for over a century and handles freeze-thaw cycles well. The key is proper waterproofing and sealing. AMS seals every limestone installation and uses appropriate mortar for the stone type."
  },
  {
    question: "How long does natural stone installation take?",
    answer: "Accent features and small sections run 2–5 days. Partial facades take 1–2 weeks. Full exterior limestone or stone installations can take 3–6 weeks depending on scope and stone sourcing lead time."
  },
  {
    question: "Can you match stone on an existing home?",
    answer: "Yes — AMS sources stone from the same or compatible quarry to match your existing installation. Some historic stones are no longer quarried in the same way; we'll tell you upfront if an exact match isn't achievable and show you the closest available option."
  },
  {
    question: "Does natural stone need to be sealed?",
    answer: "Yes — and it's not optional in Chicago's climate. Unsealed natural stone absorbs water, which freezes and causes spalling. AMS applies a penetrating sealer after installation and recommends resealing every 5–7 years."
  },
  {
    question: "Do you do interior stone work?",
    answer: "Yes — fireplaces, feature walls, kitchen backsplashes, and interior architectural accents. Same stone sourcing and installation quality as exterior work."
  },
  {
    question: "How much does limestone installation cost?",
    answer: "Natural stone and limestone installation typically runs $25–$65 per square foot installed, depending on stone type, sourcing, substrate conditions, and design complexity. Free on-site estimates at 773-656-2107."
  }
];
---

<BaseLayout
  title="Natural Stone & Limestone Installation Chicago | All Masonry Services"
  description="Premium natural stone and limestone installation for Chicagoland homes. Facades, accents, fireplaces, and architectural features. 19+ years. Free estimates. Call 773-656-2107."
  canonical={pageUrl}
  ogImage="/og-image.jpg"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <SchemaService
    name="Natural Stone Installation in Chicago & Chicagoland"
    description="Premium natural stone and limestone installation for Chicagoland homes. Facades, accents, fireplaces, and architectural features. 19+ years. Free estimates. Call 773-656-2107."
    url={pageUrl}
    provider="All Masonry Services"
    providerUrl={siteUrl}
    areaServed="Chicago, Chicagoland, IL"
    serviceType="Natural Stone Installation"
  />
  <SchemaFAQ items={faqItems} />

  <!-- HERO -->
  <section class="sp-hero" aria-labelledby="hero-h1">
    <div class="sp-hero-inner">
      <div class="sp-hero-text">
        <div class="sp-hero-badges">
          <span class="sp-badge sp-badge--gold">19+ Years</span>
          <span class="sp-badge sp-badge--outline">Licensed &amp; Insured</span>
        </div>
        <h1 class="sp-hero-h1" id="hero-h1">Natural Stone &amp; Limestone<br><em>in Chicago &amp; Chicagoland</em></h1>
        <p class="sp-hero-sub">Limestone facades, natural stone accents, architectural features — premium stone installation that elevates any home's character and holds up through Chicago winters.</p>
        <div class="sp-hero-stats" aria-label="Company stats">
          <div class="sp-stat">
            <span class="sp-stat-num">4.8★</span>
            <span class="sp-stat-label">Rating</span>
          </div>
          <div class="sp-stat-divider" aria-hidden="true"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">92</span>
            <span class="sp-stat-label">Reviews</span>
          </div>
          <div class="sp-stat-divider" aria-hidden="true"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">500+</span>
            <span class="sp-stat-label">Homes</span>
          </div>
          <div class="sp-stat-divider" aria-hidden="true"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">19+</span>
            <span class="sp-stat-label">Years</span>
          </div>
        </div>
        <div class="sp-hero-actions">
          <a href={`tel:${phone}`} class="sp-btn sp-btn--primary">Call {phone}</a>
          <a href="/contact" class="sp-btn sp-btn--ghost">Free Estimate</a>
        </div>
      </div>
      <div class="sp-hero-img-wrap" aria-hidden="true">
        <img src="/images/project-tuckpointing.webp" alt="Natural stone and limestone installation in Chicagoland" width="420" height="500" loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="sp-trust" aria-label="Trust indicators">
    <div class="sp-trust-inner">
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Licensed &amp; Insured
      </span>
      <div class="sp-trust-sep" aria-hidden="true"></div>
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Free Estimates
      </span>
      <div class="sp-trust-sep" aria-hidden="true"></div>
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Premium Stone Sourcing
      </span>
      <div class="sp-trust-sep" aria-hidden="true"></div>
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        19+ Years in Chicagoland
      </span>
    </div>
  </div>

  <!-- PROBLEM SECTION -->
  <section class="sp-problem" aria-labelledby="problem-h2">
    <div class="sp-problem-inner">
      <p class="sp-section-label">Why It Matters</p>
      <h2 class="sp-section-h2" id="problem-h2">What Goes Wrong With<br><em>Poor Stone Installation</em></h2>
      <p class="sp-section-sub">Natural stone and limestone are unforgiving materials. Installation errors that seem minor become permanent, visible, and expensive to correct.</p>
      <div class="sp-problem-grid">
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <p class="sp-problem-title">Wrong Mortar = Staining &amp; Failure</p>
          <p class="sp-problem-body">Stone requires specific mortar mixes — particularly for limestone, which is highly reactive. Use the wrong mortar and you get permanent staining, joint failure, and spalling within a few years.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <p class="sp-problem-title">No Movement Joints = Cracks</p>
          <p class="sp-problem-body">Stone expands and contracts differently than your home's framing. Without proper movement joints, thermal stress cracks the stone face — often within the first two winters.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <p class="sp-problem-title">Untreated Stone = Water Damage</p>
          <p class="sp-problem-body">Unsealed natural stone is porous. In Chicago's climate, moisture penetrates, freezes, and expands — causing internal fractures and surface spalling that look like a 20-year-old installation after 3 seasons.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
          </div>
          <p class="sp-problem-title">Poor Stone Selection = Visual Mismatch</p>
          <p class="sp-problem-body">Not all stones work with all architectural styles. Selecting limestone for a contemporary home, or rough-cut fieldstone for a formal colonial, creates a permanent visual conflict no amount of landscaping fixes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS SECTION -->
  <section class="sp-process" aria-labelledby="process-h2">
    <div class="sp-process-inner">
      <p class="sp-section-label">How We Work</p>
      <h2 class="sp-section-h2" id="process-h2">Our Stone Installation<br><em>Process</em></h2>
      <p class="sp-section-sub">From material consultation to final sealing — every step protects your investment.</p>
      <div class="sp-process-steps">

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">01</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Style &amp; Material Consultation</p>
            <p class="sp-step-body">We evaluate your home's architecture, existing materials, and your aesthetic goals — then recommend specific stone types and finishes that work together.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> Stone selection made without reference to the home's existing proportions and materials almost always looks wrong. Getting this right is 50% of the installation.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">02</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Stone Sourcing &amp; Vetting</p>
            <p class="sp-step-body">We source stone from reputable suppliers and physically inspect material for consistency — color, texture, and cut quality. We reject inconsistent batches before they arrive on site.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> Stone from different quarry batches can vary significantly in color and texture. Using mixed batches without vetting creates obvious inconsistency that's permanent.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">03</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Substrate &amp; Waterproofing Prep</p>
            <p class="sp-step-body">We prepare the substrate with correct waterproofing membrane, drainage layer, and mortar bed per stone type. Limestone and natural stone each require specific systems.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> Skipping proper waterproofing is the most common cause of stone failure. Water behind stone = freeze-thaw spalling, staining, and eventual structural deterioration.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">04</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Stone Installation &amp; Jointing</p>
            <p class="sp-step-body">We install stone in deliberate patterns — dry-laid first to check fit and appearance, then set in mortar with correct joint width and profile for the selected stone type.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> Stone installation can't be rushed. Dry-laying first catches fit issues before they're set in mortar. This step is where most contractors cut corners.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">05</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Sealing &amp; Final Inspection</p>
            <p class="sp-step-body">After curing, we apply appropriate sealer for the stone type, clean the face, and walk the completed work with you before closeout.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> Sealing limestone and porous natural stone is non-optional in Chicago's climate. An unsealed installation will show water damage within 1–2 seasons.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- WHY AMS -->
  <section class="sp-why" aria-labelledby="why-h2">
    <div class="sp-why-inner">
      <p class="sp-section-label">Why AMS</p>
      <h2 class="sp-section-h2" id="why-h2">Why Chicagoland Homeowners<br><em>Choose AMS for Stone</em></h2>
      <div class="sp-why-grid">
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">01</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Stone Compatibility Guarantee</p>
            <p class="sp-why-body">We guarantee the stone we select works with your home's architecture and existing materials — or we don't propose it. No visual mismatches.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">02</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Premium Supplier Network</p>
            <p class="sp-why-body">We work with established stone suppliers and physically inspect material for consistency before it arrives on your job site.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">03</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Free Stone Style Selector</p>
            <p class="sp-why-body">Use our free tool to explore stone options for your home's style and get personalized recommendations. No sign-up required.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">04</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Family-Owned — Direct Owner Contact</p>
            <p class="sp-why-body">No subs, no call centers. You deal with the owners on every job.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TOOL SECTION -->
  <section class="sp-tool" id="stone-selector" aria-labelledby="tool-h2">
    <div class="sp-tool-inner">
      <div class="sp-tool-header">
        <p class="sp-section-label sp-section-label--light">Free Tool</p>
        <h2 class="sp-tool-h2" id="tool-h2">Free Natural Stone &amp; Limestone<br><em>Style Selector</em></h2>
        <p class="sp-tool-sub">Home style + application + budget → the right stone or limestone for your Chicagoland home. Instant. Free.</p>
      </div>

      <div class="sp-tool-warning-hook" role="note" aria-label="Tool use cases">
        <p class="sp-tool-warning-intro">Not sure which stone suits your home — or your Chicago winters?</p>
        <ul class="sp-tool-warning-list">
          <li>Front facade, feature elevation, or chimney facing</li>
          <li>Fireplace surround or outdoor entertainment area</li>
          <li>Accent bands or architectural details</li>
        </ul>
        <p class="sp-tool-warning-cta">Tell us your home's style — get a personalized stone match with cost and care guidance. Free.</p>
      </div>

      <div class="sp-tool-social" aria-label="Tool stats">
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">740+</span>
          <span class="sp-tool-stat-label">Stone style assessments completed</span>
        </div>
        <div class="sp-tool-stat-sep" aria-hidden="true"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">4.8★</span>
          <span class="sp-tool-stat-label">Average rating · 92 reviews</span>
        </div>
        <div class="sp-tool-stat-sep" aria-hidden="true"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">3 min</span>
          <span class="sp-tool-stat-label">To get your recommendation</span>
        </div>
      </div>

      <blockquote class="sp-tool-quote">
        <p>"The selector recommended Indiana limestone for our Tudor-style home. AMS installed it — every person who visits asks who did the stone work."</p>
        <cite>— Sandra K., Homeowner · Winnetka, IL</cite>
      </blockquote>

      <div class="sp-tool-embed" aria-label="Natural stone and limestone style selector">
        <StoneStyleSelector />
      </div>

      <p class="sp-tool-note">Recommendations based on common Chicagoland stone applications (2026). Your free on-site estimate will confirm material selection and give exact pricing.</p>

      <div class="sp-tool-faq" aria-label="Selector FAQ">
        <div>
          <p class="sp-tool-faq-q">Is the stone selector free?</p>
          <p class="sp-tool-faq-a">Yes — free, no account needed. You only share contact info if you want recommendations emailed to you.</p>
        </div>
        <div>
          <p class="sp-tool-faq-q">How do I know which stone is right for my home?</p>
          <p class="sp-tool-faq-a">The selector considers your home's architectural style, the location of the installation (above grade, below grade, interior), and your aesthetic preferences. It narrows options to 2–3 that work well together.</p>
        </div>
        <div>
          <p class="sp-tool-faq-q">What's next after I get my recommendation?</p>
          <p class="sp-tool-faq-a">Call 773-656-2107 or fill out our <a href="/contact" class="sp-tool-faq-link">contact form</a>. We'll visit on-site, show you physical samples, and give you a written estimate.</p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HowTo",
        "name": "How to Choose the Right Natural Stone or Limestone for a Chicago Home",
        "description": "Free natural stone and limestone style selector for Chicagoland homeowners. Match stone type to your home's architecture, application, and budget — with freeze-thaw ratings for Chicago's climate.",
        "totalTime": "PT3M",
        "step": [
          { "@type": "HowToStep", "position": 1, "name": "Select your home style and application", "text": "Choose your home's architectural style (Tudor, Colonial, Contemporary, etc.) and the specific application: front facade, fireplace surround, chimney facing, outdoor kitchen, or accent details." },
          { "@type": "HowToStep", "position": 2, "name": "Enter your area and budget range", "text": "Provide the approximate square footage of the installation area and your budget preference so the selector can narrow options to realistic choices for your project." },
          { "@type": "HowToStep", "position": 3, "name": "Get your personalized stone recommendation", "text": "Receive a primary stone recommendation with Chicago climate rating, cost range, care requirements, and alternative options — free, instant, downloadable as a PDF." }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is the natural stone style selector free?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes — free, no account needed. You only share contact info if you want your personalized stone recommendation as a PDF." }
          },
          {
            "@type": "Question",
            "name": "Which natural stone holds up best in Chicago winters?",
            "acceptedAnswer": { "@type": "Answer", "text": "Indiana limestone, bluestone, and properly sealed granite are the strongest performers in Chicago's Zone 5B freeze-thaw climate. Softer stones like sandstone require more careful sealing and placement. The style selector includes a freeze-thaw rating for each recommendation." }
          },
          {
            "@type": "Question",
            "name": "What is the cost of natural stone installation in Chicago in 2026?",
            "acceptedAnswer": { "@type": "Answer", "text": "Natural stone installation in the Chicago metro area typically ranges from $35–$80+ per square foot installed, depending on stone type, thickness, pattern complexity, and site conditions. Limestone panels typically run $28–$55 per square foot. Run the free selector for a range specific to your application and material choice." }
          }
        ]
      }
    ]
  }</script>

  <!-- PROJECTS -->
  <section class="sp-projects" aria-labelledby="projects-h2">
    <div class="sp-projects-inner">
      <p class="sp-section-label">Recent Work</p>
      <h2 class="sp-section-h2" id="projects-h2">Natural Stone &amp; Limestone<br><em>Recent Projects</em></h2>
      <p class="sp-section-sub">A sample of recent natural stone and limestone installations across Chicagoland.</p>
      <div class="sp-projects-grid">
        <div class="sp-project-card">
          <div class="sp-project-img-wrap">
            <img src="/images/project-tuckpointing.webp" alt="Indiana limestone facade on a Tudor Colonial in Winnetka" width="400" height="240" loading="lazy" decoding="async" />
          </div>
          <div class="sp-project-info">
            <span class="sp-project-location">Winnetka, IL</span>
            <h3 class="sp-project-title">Indiana Limestone Facade — Tudor Colonial</h3>
            <p class="sp-project-desc">Full front elevation in Indiana limestone with custom-cut sills and lintels. Stone sourced, inspected, and installed by AMS.</p>
          </div>
        </div>
        <div class="sp-project-card">
          <div class="sp-project-img-wrap">
            <img src="/images/project-brick-exterior.webp" alt="Natural stone fireplace and chimney facing in Hinsdale" width="400" height="240" loading="lazy" decoding="async" />
