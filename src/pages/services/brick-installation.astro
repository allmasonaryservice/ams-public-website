---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaService from '../../components/SchemaService.astro';
import SchemaFAQ from '../../components/SchemaFAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import Footer from '../../components/Footer.astro';
import BrickInstallationEstimator from '../../components/magnets/BrickInstallationEstimator.astro';

const siteUrl = 'https://allmasonryservices.com';
const pageUrl = `${siteUrl}/services/brick-installation`;
const phone = '773-656-2107';

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Brick Installation Cost & Material Estimator",
  "description": "Free brick installation estimator for Chicagoland homeowners. Get material counts and cost ranges before calling a contractor.",
  "url": `${siteUrl}/services/brick-installation#brick-estimator`,
  "applicationCategory": "HomeAndGarden",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "provider": {
    "@type": "LocalBusiness",
    "name": "All Masonry Services Inc",
    "telephone": phone,
    "url": siteUrl
  }
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How Brick Installation Works: AMS 5-Step Process",
  "description": "How AMS installs brick walls, facades, and features in Chicagoland.",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Site & Substrate Assessment", "text": "We evaluate your foundation, existing substrate, and drainage conditions before a single brick is laid." },
    { "@type": "HowToStep", "position": 2, "name": "Mortar Selection & Mix", "text": "We select the correct mortar type for your brick — Type N, S, or M — based on the brick's density, location, and climate exposure." },
    { "@type": "HowToStep", "position": 3, "name": "Weep Holes & Flashing", "text": "Before brick is laid, we install proper flashing at the base course and weep holes at regular intervals to allow moisture to escape the wall cavity." },
    { "@type": "HowToStep", "position": 4, "name": "Brick Laying & Joint Tooling", "text": "We lay brick in consistent courses, checking level and plumb at every stage. Mortar joints are tooled to the specified profile while still workable." },
    { "@type": "HowToStep", "position": 5, "name": "Cleanup & Final Inspection", "text": "We clean mortar haze off the brick face with appropriate acid wash, sweep the work area, and walk the completed work with you before we close out." }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "All Masonry Services Inc",
  "url": siteUrl,
  "telephone": phone,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Chicago",
    "addressRegion": "IL",
    "addressCountry": "US"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "92"
  },
  "areaServed": "Chicagoland",
  "description": "Professional brick installation for Chicago and Chicagoland homes. 19+ years experience.",
  "priceRange": "$$"
};

const faqItems = [
  {
    question: "How much does brick installation cost in Chicago?",
    answer: "Brick installation in Chicagoland typically costs $15–$35 per square foot depending on brick type, mortar complexity, and site access. A small outdoor feature or wall repair runs $2,000–$6,000. A full home exterior can range from $20,000 to $75,000+. Free on-site estimates at 773-656-2107."
  },
  {
    question: "How do I know what brick type I need?",
    answer: "Brick selection depends on your home's style, the location of the installation, and your climate exposure. AMS helps you select the right brick type and source it before any work begins — we'll walk you through options on the estimate visit."
  },
  {
    question: "How long does brick installation take?",
    answer: "Small projects (retaining walls, outdoor features, additions) typically run 1–5 days. A full exterior can take 1–3 weeks. We provide a detailed timeline at the estimate stage."
  },
  {
    question: "Can you match existing brick on my home?",
    answer: "Yes — brick matching is one of our specialties. We source bricks that match your existing in color, texture, and size, and we mortar-match to your existing joints. The goal is that you can't see where old ends and new begins."
  },
  {
    question: "What's the difference between Type N, S, and M mortar?",
    answer: "Type N is correct for most above-grade exterior walls — medium strength, flexible enough for brick movement. Type S is for below-grade or high-moisture environments. Type M is for foundations and hardscape. Using the wrong type causes premature brick failure. AMS matches every mortar mix to your specific brick and location."
  },
  {
    question: "Do you install brick for both residential and commercial projects?",
    answer: "Yes — AMS does both. For commercial brick installation, see our Commercial Brick & Stone service page. For custom home builds, see Custom Home Masonry."
  },
  {
    question: "Is AMS licensed and insured for brick installation?",
    answer: "Yes. Licensed in Illinois (License #MA-104-018887), $2.5M general liability, workers' compensation on all crew members. Proof of insurance available before work starts."
  },
  {
    question: "Do you offer free estimates for brick installation?",
    answer: "Yes — all estimates are free, on-site, and in writing. Call 773-656-2107 or fill out our contact form to schedule."
  }
];
---

<BaseLayout
  title="Brick Installation Chicago | All Masonry Services"
  description="Professional brick installation for Chicago and Chicagoland homes. New brick walls, facades, additions, and features. 19+ years experience. Free estimates. Call 773-656-2107."
  canonical={pageUrl}
  ogImage="/og-image.jpg"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <SchemaService
    name="Brick Installation in Chicago & Chicagoland"
    description="Professional brick installation for Chicago and Chicagoland homes. New brick walls, facades, additions, and features. 19+ years experience. Free estimates. Call 773-656-2107."
    url={pageUrl}
    provider="All Masonry Services"
    providerUrl={siteUrl}
    areaServed="Chicago, Chicagoland, IL"
    serviceType="Brick Installation"
  />
  <SchemaFAQ items={faqItems} />

  <!-- HERO -->
  <section class="sp-hero" aria-labelledby="hero-h1">
    <div class="sp-hero-inner">
      <div class="sp-hero-text">
        <div class="sp-hero-badges">
          <span class="sp-badge sp-badge--gold">19+ Years</span>
          <span class="sp-badge sp-badge--outline">Licensed &amp; Insured</span>
        </div>
        <h1 class="sp-hero-h1" id="hero-h1">Brick Installation<br><em>in Chicago &amp; Chicagoland</em></h1>
        <p class="sp-hero-sub">New brick walls, facades, additions, and outdoor features — professionally laid with precision mortar work, matched materials, and craftsmanship that lasts for decades.</p>
        <div class="sp-hero-stats" aria-label="Company stats">
          <div class="sp-stat">
            <span class="sp-stat-num">4.8★</span>
            <span class="sp-stat-label">Rating</span>
          </div>
          <div class="sp-stat-divider" aria-hidden="true"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">92</span>
            <span class="sp-stat-label">Reviews</span>
          </div>
          <div class="sp-stat-divider" aria-hidden="true"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">500+</span>
            <span class="sp-stat-label">Homes</span>
          </div>
          <div class="sp-stat-divider" aria-hidden="true"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">19+</span>
            <span class="sp-stat-label">Years</span>
          </div>
        </div>
        <div class="sp-hero-actions">
          <a href={`tel:${phone}`} class="sp-btn sp-btn--primary">Call {phone}</a>
          <a href="/contact" class="sp-btn sp-btn--ghost">Free Estimate</a>
        </div>
      </div>
      <div class="sp-hero-img-wrap" aria-hidden="true">
        <img src="/images/why-choose-us-brick.webp" alt="Professional brick installation in Chicagoland" width="420" height="500" loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="sp-trust" aria-label="Trust indicators">
    <div class="sp-trust-inner">
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Licensed &amp; Insured in Illinois
      </span>
      <div class="sp-trust-sep" aria-hidden="true"></div>
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Free On-Site Estimates
      </span>
      <div class="sp-trust-sep" aria-hidden="true"></div>
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Precision Mortar Work
      </span>
      <div class="sp-trust-sep" aria-hidden="true"></div>
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        19+ Years in Chicagoland
      </span>
    </div>
  </div>

  <!-- PROBLEM SECTION -->
  <section class="sp-problem" aria-labelledby="problem-h2">
    <div class="sp-problem-inner">
      <p class="sp-section-label">Why It Matters</p>
      <h2 class="sp-section-h2" id="problem-h2">What Happens When You<br><em>Cut Corners on Brick</em></h2>
      <p class="sp-section-sub">Brick installation looks simple. Get the mortar wrong, the base wrong, or the drainage wrong — and you're relooking at the wall in 5 years.</p>
      <div class="sp-problem-grid">
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <p class="sp-problem-title">Wrong Mortar Hardness → Cracks &amp; Spalling</p>
          <p class="sp-problem-body">Mortar too hard for the brick = spalling within 5 years as freeze-thaw stresses transfer to the brick face rather than the joint.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <p class="sp-problem-title">No Drainage System → Water Buildup</p>
          <p class="sp-problem-body">Without weep holes and proper flashing, water collects behind the brick — saturating the wall cavity, rotting framing, and causing mold before you see any visible damage.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
          </div>
          <p class="sp-problem-title">Poor Foundation Prep → Settling &amp; Cracks</p>
          <p class="sp-problem-body">Brick is heavy. Lay it on an inadequately prepped base and it settles unevenly — cracking joints, shifting courses, and creating structural issues over years.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
          </div>
          <p class="sp-problem-title">Mismatched Materials → Visible Incompatibility</p>
          <p class="sp-problem-body">Mixing brick types or batches without careful matching creates obvious color and texture inconsistencies. Impossible to fix once the mortar cures.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS SECTION -->
  <section class="sp-process" aria-labelledby="process-h2">
    <div class="sp-process-inner">
      <p class="sp-section-label">How We Work</p>
      <h2 class="sp-section-h2" id="process-h2">Our Brick Installation<br><em>Process</em></h2>
      <p class="sp-section-sub">From substrate inspection to final cleanup — every step is done right the first time.</p>
      <div class="sp-process-steps">

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">01</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Site &amp; Substrate Assessment</p>
            <p class="sp-step-body">We evaluate your foundation, existing substrate, and drainage conditions before a single brick is laid. This determines the right base preparation and drainage system.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> Skipping this step is how brick walls end up settling, cracking, and failing within 5–10 years of installation.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">02</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Mortar Selection &amp; Mix</p>
            <p class="sp-step-body">We select the correct mortar type for your brick — Type N, S, or M — based on the brick's density, location, and climate exposure. Every batch is mixed to consistent spec.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> The wrong mortar hardness is the single biggest cause of premature brick failure. It's also invisible until it's too late.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">03</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Weep Holes &amp; Flashing</p>
            <p class="sp-step-body">Before brick is laid, we install proper flashing at the base course and weep holes at regular intervals to allow moisture to escape the wall cavity.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> Inspectors look for this. Builders who skip it create water damage that shows up 3–5 years later — after you've already closed on the project.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">04</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Brick Laying &amp; Joint Tooling</p>
            <p class="sp-step-body">We lay brick in consistent courses, checking level and plumb at every stage. Mortar joints are tooled to the specified profile while still workable — not raked dry.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> Joint tooling is what makes brick weathertight. A joint that's tooled properly sheds water. A joint raked too early or left untooled holds it.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">05</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Cleanup &amp; Final Inspection</p>
            <p class="sp-step-body">We clean mortar haze off the brick face with appropriate acid wash, sweep the work area, and walk the completed work with you before we close out.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> Mortar residue left on brick permanently stains the face. The walk-through is your final check — we don't consider the job done until you do.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- WHY AMS -->
  <section class="sp-why" aria-labelledby="why-h2">
    <div class="sp-why-inner">
      <p class="sp-section-label">Why AMS</p>
      <h2 class="sp-section-h2" id="why-h2">Why Chicagoland Homeowners<br><em>Choose AMS for Brick</em></h2>
      <div class="sp-why-grid">
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">01</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Mortar-Match Guarantee</p>
            <p class="sp-why-body">New brick mortar matched to your existing masonry in color, texture, and hardness — or we redo it at no charge. No other contractor in the area offers this in writing.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">02</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Transparent Written Estimates</p>
            <p class="sp-why-body">Every estimate is free, on-site, and in writing — scope, materials, and timeline before any work begins. You know exactly what you're paying before we start.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">03</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Free Brick Cost Estimator</p>
            <p class="sp-why-body">Use our free brick installation estimator to get material counts and cost ranges before you call anyone. No sign-up, no obligation.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">04</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Family-Owned — You Deal With the Owners</p>
            <p class="sp-why-body">Not a franchise, not a subcontractor network. Same crew that estimates is the crew that builds.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TOOL SECTION -->
  <section class="sp-tool" id="brick-estimator" aria-labelledby="tool-h2">
    <div class="sp-tool-inner">
      <div class="sp-tool-header">
        <p class="sp-section-label sp-section-label--light">Free Tool</p>
        <h2 class="sp-tool-h2" id="tool-h2">Free Brick Installation<br><em>Cost &amp; Material Estimator</em></h2>
        <p class="sp-tool-sub">Wall dimensions + brick type → brick count, material cost, labor range. Chicago 2026 pricing. 60 seconds. Free.</p>
      </div>

      <div class="sp-tool-warning-hook" role="note" aria-label="Tool use cases">
        <p class="sp-tool-warning-intro">Know your brick count and budget before talking to a contractor.</p>
        <ul class="sp-tool-warning-list">
          <li>New brick wall, facade, or addition</li>
          <li>Outdoor feature wall or retaining wall</li>
          <li>Repair and match existing brick</li>
        </ul>
        <p class="sp-tool-warning-cta">Get your brick count and cost range in 60 seconds. Free.</p>
      </div>

      <div class="sp-tool-social" aria-label="Tool stats">
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">920+</span>
          <span class="sp-tool-stat-label">Chicagoland projects estimated</span>
        </div>
        <div class="sp-tool-stat-sep" aria-hidden="true"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">4.8★</span>
          <span class="sp-tool-stat-label">Average rating · 92 reviews</span>
        </div>
        <div class="sp-tool-stat-sep" aria-hidden="true"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">60s</span>
          <span class="sp-tool-stat-label">To get your estimate</span>
        </div>
      </div>

      <blockquote class="sp-tool-quote">
        <p>"The estimator told me I needed about 4,200 bricks for my retaining wall. AMS's actual count was 4,150. Saved me from ordering too little and stopping mid-job."</p>
        <cite>— Tom W., Homeowner · Oak Brook, IL</cite>
      </blockquote>

      <div class="sp-tool-embed" aria-label="Brick installation cost and material estimator">
        <BrickInstallationEstimator />
      </div>

      <p class="sp-tool-note">Cost ranges based on typical Chicagoland brick installation projects (2026). Your free on-site estimate from AMS will reflect your specific brick type, site conditions, and access.</p>

      <div class="sp-tool-faq" aria-label="Estimator FAQ">
        <div>
          <p class="sp-tool-faq-q">Is the brick estimator free?</p>
          <p class="sp-tool-faq-a">Yes — free, no sign-up required. You only share contact info if you want a full report emailed to you.</p>
        </div>
        <div>
          <p class="sp-tool-faq-q">How accurate is the material count?</p>
          <p class="sp-tool-faq-a">The estimator uses standard brick coverage formulas with a 10% waste factor built in. It's accurate for standard coursing — your on-site estimate will confirm the count for any non-standard patterns.</p>
        </div>
        <div>
          <p class="sp-tool-faq-q">What should I do after running the estimator?</p>
          <p class="sp-tool-faq-a">Call 773-656-2107 or fill out our <a href="/contact" class="sp-tool-faq-link">contact form</a> to schedule a free on-site estimate. Bring your dimensions — we'll verify the count and give you a written quote.</p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HowTo",
        "name": "How to Estimate Brick Installation Cost and Material Count in Chicago",
        "description": "Free brick installation cost and material estimator for Chicagoland homeowners. Enter wall dimensions and brick type, get brick count and 2026 cost range in 60 seconds.",
        "totalTime": "PT1M",
        "step": [
          { "@type": "HowToStep", "position": 1, "name": "Enter wall dimensions", "text": "Input your wall width and height in feet to calculate the total square footage of brick needed." },
          { "@type": "HowToStep", "position": 2, "name": "Select brick type and bond pattern", "text": "Choose your brick type (standard modular, queen, roman, or utility) and bond pattern (running bond, flemish, or stack) to refine the count." },
          { "@type": "HowToStep", "position": 3, "name": "Get your brick count and cost range", "text": "Receive brick count with 10% waste factor, material cost, and Chicago 2026 labor range — free, instant, downloadable as a PDF." }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is the brick installation estimator free?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes — free, no sign-up required. You only share contact info if you want a full estimate report as a PDF." }
          },
          {
            "@type": "Question",
            "name": "How accurate is the brick material count?",
            "acceptedAnswer": { "@type": "Answer", "text": "The estimator uses standard brick coverage formulas with a 10% waste factor built in. It is accurate for standard coursing — your on-site estimate from All Masonry Services will confirm the count for non-standard patterns and site conditions." }
          },
          {
            "@type": "Question",
            "name": "What does brick installation cost in Chicago in 2026?",
            "acceptedAnswer": { "@type": "Answer", "text": "Brick installation in the Chicago metro area typically ranges from $22–$45 per square foot installed, depending on brick type, bond pattern, wall height, and site conditions. Run the free estimator for a range specific to your project dimensions." }
          }
        ]
      }
    ]
  }</script>

  <!-- PROJECTS -->
  <section class="sp-projects" aria-labelledby="projects-h2">
    <div class="sp-projects-inner">
      <p class="sp-section-label">Recent Work</p>
      <h2 class="sp-section-h2" id="projects-h2">Brick Installation<br><em>Recent Projects</em></h2>
      <p class="sp-section-sub">A sample of recent brick installation projects across Chicagoland.</p>
      <div class="sp-projects-grid">
        <div class="sp-project-card">
          <div class="sp-project-img-wrap">
            <img src="/images/project-brick-exterior.webp" alt="Full brick exterior addition in Hinsdale" width="400" height="240" loading="lazy" decoding="async" />
          </div>
          <div class="sp-project-info">
            <span class="sp-project-location">Hinsdale, IL</span>
            <h3 class="sp-project-title">Full Brick Exterior — 1980s Ranch Expansion</h3>
            <p class="sp-project-desc">Complete brick exterior on a 600 sq ft addition — matched existing mortar color and brick texture exactly. Passed inspection first visit.</p>
          </div>
        </div>
