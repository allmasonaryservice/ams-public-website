---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaService from '../../components/SchemaService.astro';
import SchemaFAQ from '../../components/SchemaFAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import Footer from '../../components/Footer.astro';
import CMULoadCalculator from '../../components/magnets/CMULoadCalculator.astro';

const siteUrl = 'https://allmasonryservices.com';
const pageUrl = `${siteUrl}/services/cmu-block-installation`;
const phone = '773-656-2107';

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "CMU Block Installation Quantity Calculator",
  "description": "Free CMU block quantity calculator for commercial projects in Chicagoland. Get block counts, mortar estimates, and project complexity notes.",
  "url": `${siteUrl}/services/cmu-block-installation#cmu-calculator`,
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "provider": {
    "@type": "LocalBusiness",
    "name": "All Masonry Services Inc",
    "telephone": phone,
    "url": siteUrl
  }
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How CMU Block Installation Works: AMS 5-Step Process",
  "description": "How AMS installs CMU block walls for commercial buildings and structures in Chicagoland.",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Engineering Review & Block Selection", "text": "We review structural drawings, confirm block size and density requirements, and verify reinforcement specification before ordering." },
    { "@type": "HowToStep", "position": 2, "name": "Footing & Base Inspection", "text": "We verify footing dimensions and bearing capacity before placing the first course." },
    { "@type": "HowToStep", "position": 3, "name": "Block Laying & Reinforcement", "text": "We lay CMU in running bond, setting rebar at specified locations and maintaining consistent mortar joints throughout." },
    { "@type": "HowToStep", "position": 4, "name": "Grouting & Consolidation", "text": "We fill required cells with specified grout mix in lifts — not in one pour — and consolidate each lift before adding the next." },
    { "@type": "HowToStep", "position": 5, "name": "Control Joints & Waterproofing", "text": "We install control joints at code-required intervals and apply appropriate waterproofing to below-grade and exposed faces." }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "All Masonry Services Inc",
  "url": siteUrl,
  "telephone": phone,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Chicago",
    "addressRegion": "IL",
    "addressCountry": "US"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "92"
  },
  "areaServed": "Chicagoland",
  "description": "Expert CMU block installation for commercial buildings and structures in Chicagoland. 19+ years experience.",
  "priceRange": "$$"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": `${siteUrl}/services` },
    { "@type": "ListItem", "position": 3, "name": "CMU Block Installation", "item": pageUrl }
  ]
};

const faqItems = [
  {
    question: "What sizes of CMU block does AMS work with?",
    answer: "AMS installs 4\", 6\", 8\", 10\", and 12\" CMU blocks. Block size is selected based on your structural engineer's drawings and the load requirements of the project."
  },
  {
    question: "Do you provide structural drawings for CMU projects?",
    answer: "No — AMS works from structural drawings provided by your engineer. If you don't have an engineer, we can recommend local structural engineering firms to work with."
  },
  {
    question: "What is grouting and why does it matter?",
    answer: "Grouting is the process of filling CMU block cells with concrete to achieve full structural capacity and encase reinforcing steel. Incompletely grouted walls lose significant strength — inspectors check grout placement before the wall can go higher on most commercial projects."
  },
  {
    question: "What are control joints in CMU and where are they required?",
    answer: "Control joints are vertical joints filled with flexible sealant that allow CMU walls to expand and contract without cracking. IBC specifies maximum spacing — typically around 25 feet. AMS installs control joints at all required locations per your engineer's drawings."
  },
  {
    question: "Can AMS handle both interior and exterior CMU work?",
    answer: "Yes — interior partition walls, exterior load-bearing walls, below-grade foundation walls, and retaining structures. We work on both commercial new construction and renovation projects."
  },
  {
    question: "Do you work directly with GCs and developers?",
    answer: "Yes — most of our CMU work comes through general contractors and developers. We're experienced with payment applications, lien waivers, certified payrolls, and the documentation requirements of commercial projects."
  },
  {
    question: "Is AMS licensed for commercial CMU installation?",
    answer: "Yes — licensed in Illinois (License #MA-104-018887), $2.5M general liability, workers' comp. We're set up for commercial documentation requirements including insurance certificates and additional insured endorsements."
  },
  {
    question: "What's the lead time for a commercial CMU project?",
    answer: "Lead time depends on block availability and crew scheduling. For large commercial projects, we recommend contacting us 4–8 weeks before your planned start date. Current availability is confirmed on your first call."
  }
];
---

<BaseLayout
  title="CMU Block Installation Chicago | All Masonry Services"
  description="Expert CMU block installation for commercial buildings and structures in Chicagoland. Quantity calculations, reinforcement, and code-compliant construction. Call 773-656-2107."
  canonical={pageUrl}
  ogImage="/og-image.jpg"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <SchemaService
    name="CMU Block Installation in Chicago & Chicagoland"
    description="Expert CMU block installation for commercial buildings and structures in Chicagoland. Quantity calculations, reinforcement, and code-compliant construction. Call 773-656-2107."
    url={pageUrl}
    provider="All Masonry Services"
    providerUrl={siteUrl}
    areaServed="Chicago, Chicagoland, IL"
    serviceType="CMU Block Installation"
  />
  <SchemaFAQ items={faqItems} />

  <!-- HERO -->
  <section class="sp-hero" aria-labelledby="hero-h1">
    <div class="sp-hero-inner">
      <div class="sp-hero-text">
        <div class="sp-hero-badges">
          <span class="sp-badge sp-badge--gold">19+ Years</span>
          <span class="sp-badge sp-badge--outline">Licensed &amp; Insured</span>
        </div>
        <h1 class="sp-hero-h1" id="hero-h1">CMU Block Installation<br><em>in Chicago &amp; Chicagoland</em></h1>
        <p class="sp-hero-sub">Concrete masonry unit (CMU) installation for commercial buildings, retaining structures, and load-bearing walls — engineered, code-compliant, and built to carry the loads your project requires.</p>
        <div class="sp-hero-stats" aria-label="Company stats">
          <div class="sp-stat">
            <span class="sp-stat-num">4.8★</span>
            <span class="sp-stat-label">Rating</span>
          </div>
          <div class="sp-stat-divider" aria-hidden="true"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">92</span>
            <span class="sp-stat-label">Reviews</span>
          </div>
          <div class="sp-stat-divider" aria-hidden="true"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">500+</span>
            <span class="sp-stat-label">Homes</span>
          </div>
          <div class="sp-stat-divider" aria-hidden="true"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">19+</span>
            <span class="sp-stat-label">Years</span>
          </div>
        </div>
        <div class="sp-hero-actions">
          <a href={`tel:${phone}`} class="sp-btn sp-btn--primary">Call {phone}</a>
          <a href="/contact" class="sp-btn sp-btn--ghost">Free Estimate</a>
        </div>
      </div>
      <div class="sp-hero-img-wrap" aria-hidden="true">
        <img src="/images/projects/downers-grove-cmu-block-installation-desktop.webp" alt="CMU block installation for commercial building in Chicagoland" width="420" height="500" loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="sp-trust" aria-label="Trust indicators">
    <div class="sp-trust-inner">
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Licensed &amp; Insured
      </span>
      <div class="sp-trust-sep" aria-hidden="true"></div>
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Commercial Experience
      </span>
      <div class="sp-trust-sep" aria-hidden="true"></div>
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Engineered Installations
      </span>
      <div class="sp-trust-sep" aria-hidden="true"></div>
      <span class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        19+ Years
      </span>
    </div>
  </div>

  <!-- PROBLEM SECTION -->
  <section class="sp-problem" aria-labelledby="problem-h2">
    <div class="sp-problem-inner">
      <p class="sp-section-label">Why It Matters</p>
      <h2 class="sp-section-h2" id="problem-h2">What Goes Wrong With<br><em>CMU Block Projects</em></h2>
      <p class="sp-section-sub">CMU construction looks straightforward. The failures happen in reinforcement, grouting, and waterproofing — the parts no one sees until the wall moves.</p>
      <div class="sp-problem-grid">
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <p class="sp-problem-title">Undersized Reinforcement</p>
          <p class="sp-problem-body">CMU walls in load-bearing or retaining applications require engineered rebar reinforcement. A block count that's correct with inadequate steel is still a structural failure waiting to happen.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <p class="sp-problem-title">Incomplete Grouting</p>
          <p class="sp-problem-body">Cells requiring grout must be fully filled — incompletely grouted CMU walls lose structural capacity, get flagged at inspection, and require tear-out to fix.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
          </div>
          <p class="sp-problem-title">No Control Joints</p>
          <p class="sp-problem-body">Without control joints at code-required intervals, thermal stress cracks the CMU wall face and compromises waterproofing — spacing is specified by code, not approximated.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 16s-1.5-2-4-2-4 2-4 2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
          </div>
          <p class="sp-problem-title">Missing Waterproofing on Below-Grade Work</p>
          <p class="sp-problem-body">Below-grade CMU without proper waterproofing is a guaranteed moisture failure. Water penetrates through block and mortar joints, saturating interior spaces and deteriorating the wall from inside.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS SECTION -->
  <section class="sp-process" aria-labelledby="process-h2">
    <div class="sp-process-inner">
      <p class="sp-section-label">How We Work</p>
      <h2 class="sp-section-h2" id="process-h2">Our CMU Installation<br><em>Process</em></h2>
      <p class="sp-section-sub">From engineering review to final waterproofing — every step built to spec and ready for inspection.</p>
      <div class="sp-process-steps">

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">01</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Engineering Review &amp; Block Selection</p>
            <p class="sp-step-body">We review structural drawings, confirm block size and density requirements, and verify reinforcement specification before ordering.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> CMU blocks come in multiple densities and strengths. Using the wrong block for a load-bearing application creates a code violation that requires rebuild.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">02</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Footing &amp; Base Inspection</p>
            <p class="sp-step-body">We verify footing dimensions and bearing capacity before placing the first course.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> A CMU wall is only as strong as what it's sitting on. Inadequate footings lead to settling and cracking — often within the first few years.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">03</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Block Laying &amp; Reinforcement</p>
            <p class="sp-step-body">We lay CMU in running bond, setting rebar at specified locations and maintaining consistent mortar joints throughout.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> Consistent joint thickness is structurally important in CMU — it directly affects load transfer. We check every course.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">04</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Grouting &amp; Consolidation</p>
            <p class="sp-step-body">We fill required cells with specified grout mix in lifts — not in one pour — and consolidate each lift before adding the next.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> One-pour grouting traps air pockets and reduces consolidation. Lift-and-consolidate is the spec-compliant method — and the only one we use.</p>
          </div>
        </div>

        <div class="sp-step">
          <span class="sp-step-num" aria-hidden="true">05</span>
          <div class="sp-step-content">
            <p class="sp-step-title">Control Joints &amp; Waterproofing</p>
            <p class="sp-step-body">We install control joints at code-required intervals and apply appropriate waterproofing to below-grade and exposed faces.</p>
            <p class="sp-step-why"><strong>Why this matters:</strong> Control joints at wrong spacing or omitted entirely leave the wall without thermal relief. In Chicago's climate, that means cracking within 1–2 winters.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      function initStepAnimations() {
        var steps = document.querySelectorAll('.sp-step');
        if (!steps.length) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          steps.forEach(function (s) { s.style.opacity = '1'; s.style.transform = 'none'; });
          return;
        }
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var el = entry.target;
              var idx = parseInt(el.getAttribute('data-step-idx') || '0', 10);
              setTimeout(function () {
                el.style.transition = 'opacity 500ms ease, transform 500ms ease';
                el.style.opacity = '1';
                el.style.transform = 'translateX(0)';
              }, idx * 80);
              observer.unobserve(el);
            }
          });
        }, { threshold: 0.12 });
        steps.forEach(function (s, i) {
          s.setAttribute('data-step-idx', String(i));
          observer.observe(s);
        });
      }
      window.removeEventListener('animations:ready', window.__spStepAnimReady);
      window.__spStepAnimReady = initStepAnimations;
      window.addEventListener('animations:ready', window.__spStepAnimReady);
      if (window.__lenis) initStepAnimations();
    })();
  </script>

  <!-- WHY AMS -->
  <section class="sp-why" aria-labelledby="why-h2">
    <div class="sp-why-inner">
      <p class="sp-section-label">Why AMS</p>
      <h2 class="sp-section-h2" id="why-h2">Why Commercial Clients<br><em>Choose AMS for CMU</em></h2>
      <div class="sp-why-grid">
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">01</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Engineering Coordination</p>
            <p class="sp-why-body">We work directly with your structural engineer or GC to confirm block selection, reinforcement, and grouting spec before we start.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">02</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Code-Compliant Every Time</p>
            <p class="sp-why-body">CMU installations pass inspection because we build to spec — not approximations. We know what inspectors check and we do it right.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">03</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Free CMU Quantity Calculator</p>
            <p class="sp-why-body">Use our calculator to estimate block count, grout, and project complexity before you call. Commercial tool, free to use.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <span class="sp-why-num" aria-hidden="true">04</span>
          <div class="sp-why-content">
            <p class="sp-why-title">Family-Owned — Direct Owner Contact</p>
            <p class="sp-why-body">No subs, no franchise. You deal with the people doing the work.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TOOL SECTION -->
  <section class="sp-tool" id="cmu-calculator" aria-labelledby="tool-h2">
    <div class="sp-tool-inner">
      <div class="sp-tool-header">
        <p class="sp-section-label sp-section-label--light">Free Tool</p>
        <h2 class="sp-tool-h2" id="tool-h2">Free CMU Block Installation<br><em>Quantity Calculator</em></h2>
        <p class="sp-tool-sub">Wall dimensions + block size → block count, mortar bags, cost range. Chicago commercial 2026. 90 seconds. Free.</p>
      </div>

      <div class="sp-tool-warning-hook" role="note" aria-label="Tool use cases">
        <p class="sp-tool-warning-intro">Get your CMU quantities before the formal takeoff — or verify your estimator's numbers.</p>
        <ul class="sp-tool-warning-list">
          <li>Commercial load-bearing, retaining, or partition walls</li>
          <li>Foundation or below-grade construction</li>
          <li>Industrial, warehouse, or site structure</li>
        </ul>
        <p class="sp-tool-warning-cta">Enter wall specs — get block count, mortar estimate, and complexity notes. Free.</p>
      </div>

      <div class="sp-tool-social" aria-label="Tool stats">
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">540+</span>
          <span class="sp-tool-stat-label">Commercial projects calculated</span>
        </div>
        <div class="sp-tool-stat-sep" aria-hidden="true"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">4.8★</span>
          <span class="sp-tool-stat-label">Average rating · 92 reviews</span>
        </div>
        <div class="sp-tool-stat-sep" aria-hidden="true"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">90s</span>
          <span class="sp-tool-stat-label">To get your estimate</span>
        </div>
      </div>

      <blockquote class="sp-tool-quote">
        <p>"The CMU calculator gave our estimator a quick quantity check before the formal takeoff. The numbers matched within 2%. Saved us from a major order error on a tight project budget."</p>
        <cite>— Mark R., GC · Chicagoland</cite>
      </blockquote>

      <div class="sp-tool-embed" aria-label="CMU block quantity calculator">
        <CMULoadCalculator />
      </div>

      <p class="sp-tool-note">Quantity estimates based on standard CMU coverage formulas (2026). Your formal structural takeoff and on-site estimate from AMS will confirm quantities for your specific drawings.</p>

      <div class="sp-tool-faq" aria-label="Calculator FAQ">
        <div>
          <p class="sp-tool-faq-q">Is the CMU calculator free?</p>
          <p class="sp-tool-faq-a">Yes — free, no account required. Intended for commercial estimating and preliminary project planning.</p>
        </div>
        <div>
          <p class="sp-tool-faq-q">How accurate is the block count?</p>
          <p class="sp-tool-faq-a">The calculator uses standard CMU coverage formulas with 5% waste factor. For projects with extensive openings, pilasters, or non-standard coursing, your formal takeoff from AMS will be more precise.</p>
        </div>
        <div>
          <p class="sp-tool-faq-q">What's next after I use the calculator?</p>
          <p class="sp-tool-faq-a">Call 773-656-2107 or fill out our <a href="/contact" class="sp-tool-faq-link">contact form</a> to schedule a commercial project consultation. We'll review your drawings and provide a full written bid.</p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HowTo",
        "name": "How to Calculate CMU Block Quantity and Cost for a Chicago Project",
        "description": "Free CMU block installation quantity calculator for Chicagoland GCs and developers. Enter wall dimensions and block size, get block count, mortar requirement, and cost range.",
        "totalTime": "PT2M",
        "step": [
          { "@type": "HowToStep", "position": 1, "name": "Enter wall dimensions", "text": "Input your wall length, height, and number of openings. The calculator accounts for standard CMU coverage and deducts openings from the gross count." },
          { "@type": "HowToStep", "position": 2, "name": "Select block size and wall type", "text": "Choose your CMU block size (8x8x16 standard, 8x4x16, or 12x8x16) and wall type (load-bearing, non-load-bearing, or retaining wall) for accurate quantity and complexity notes." },
          { "@type": "HowToStep", "position": 3, "name": "Get block count, mortar bags, and cost range", "text": "Receive block quantity with 5% waste factor, mortar bag estimate, and Chicago commercial 2026 cost range — free, instant, downloadable as a PDF." }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is the CMU block quantity calculator free?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes — free, no account required. Intended for commercial estimating, preliminary project planning, and GC bid preparation." }
          },
          {
            "@type": "Question",
            "name": "How accurate is the CMU block count?",
            "acceptedAnswer": { "@type": "Answer", "text": "The calculator uses standard CMU coverage formulas with a 5% waste factor. For projects with extensive openings, pilasters, or non-standard coursing, a formal structural takeoff from All Masonry Services will be more precise." }
          },
          {
            "@type": "Question",
