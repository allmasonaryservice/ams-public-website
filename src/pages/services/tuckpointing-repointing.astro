---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaService from '../../components/SchemaService.astro';
import SchemaFAQ from '../../components/SchemaFAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import Footer from '../../components/Footer.astro';
import MortarDamageAssessment from '../../components/magnets/MortarDamageAssessment.astro';

const siteUrl = 'https://allmasonryservices.com';
const pageUrl = `${siteUrl}/services/tuckpointing-repointing`;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Mortar Damage Assessment Tool",
  "description": "Free online tool to assess mortar joint damage on Chicago and Chicagoland brick homes. Get a tuckpointing cost estimate in 60 seconds.",
  "applicationCategory": "HomeAndGarden",
  "operatingSystem": "Web",
  "url": `${siteUrl}/services/tuckpointing-repointing#mortar-assessment-tool`,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "All Masonry Services",
    "url": siteUrl
  }
};

const aggregateRatingSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "All Masonry Services",
  "url": siteUrl,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "92",
    "bestRating": "5"
  }
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How Tuckpointing Works: AMS 5-Step Process",
  "description": "How professional tuckpointing and mortar repointing is done on Chicago and Chicagoland brick homes.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Free On-Site Assessment",
      "text": "We inspect your mortar joints, identify all areas of damage, and assess the depth of deterioration. You get a full written scope and a firm quote — no surprises once work starts."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Mortar Matching",
      "text": "We match the new mortar to your existing joints — color, texture, and hardness. Using the wrong mortar hardness is the #1 cause of premature failure and cracked bricks."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Old Mortar Removal",
      "text": "We grind out deteriorated mortar to a depth of 3/4\"–1\" using angle grinders and chisels — deep enough for the new mortar to bond properly without disturbing the brick face."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "New Mortar Application",
      "text": "Fresh mortar is packed in layers — never in one shot, which causes shrinkage cracks. Each layer is tooled to match the original joint profile for a seamless, weathertight finish."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Cleanup & Final Walk-Through",
      "text": "We clean mortar residue off the brick face, sweep the work area, and walk the job with you. If anything doesn't meet your standard, we fix it before we leave."
    }
  ]
};

const faqItems = [
  {
    question: "How much does tuckpointing cost in Chicago?",
    answer: "Tuckpointing in Chicago typically costs $5–$25 per square foot depending on the extent of mortar damage, brick type, and accessibility. A standard chimney tuckpoint runs $300–$800. We provide free on-site estimates with no obligation — call 773-656-2107 to schedule."
  },
  {
    question: "How do I know if my home needs tuckpointing?",
    answer: "Look for crumbling or missing mortar joints, white chalky stains on brick (efflorescence), cracks wider than 1/4 inch, or mortar that crumbles when you press it. Chicago's freeze-thaw winters accelerate this damage — what looks minor in fall can become a serious water intrusion problem by spring."
  },
  {
    question: "What happens if I delay tuckpointing repairs?",
    answer: "Deteriorating mortar allows water to penetrate behind your brick. In Chicago's climate, that water freezes and expands every winter, cracking bricks from the inside. What starts as a $500 tuckpointing job can become a $5,000–$15,000 brick replacement project within 2–3 seasons of neglect."
  },
  {
    question: "How long does tuckpointing last?",
    answer: "Quality tuckpointing using correctly matched mortar lasts 20–30 years. The key is matching the mortar hardness to your brick — using a mortar that's too hard will crack the brick itself rather than flex with it. AMS matches every mortar mix to your specific brick type."
  },
  {
    question: "Can tuckpointing be done in winter in Chicago?",
    answer: "Tuckpointing requires temperatures above 40°F for mortar to cure properly. We typically work March through November in the Chicago area. If you're seeing damage now, schedule a spring appointment — we book up fast once the season starts."
  },
  {
    question: "What is the difference between tuckpointing and repointing?",
    answer: "Repointing means removing old mortar and replacing it — this is the core repair. Tuckpointing traditionally refers to a decorative technique with two-color mortar, but in the Chicago area both terms are used interchangeably to mean mortar joint repair. AMS does both structural repointing and decorative tuckpointing."
  },
  {
    question: "Is AMS licensed and insured for tuckpointing in Illinois?",
    answer: "Yes. All Masonry Services Inc is fully licensed and insured in Illinois. We carry general liability and workers' compensation insurance on every job. We're happy to provide proof of insurance before any work begins."
  },
  {
    question: "Do you offer free estimates for tuckpointing?",
    answer: "Yes — all estimates are free and come with no pressure or obligation. We assess the full scope of mortar damage, explain what needs to be done and why, and give you a written quote on the spot. Call 773-656-2107 or fill out our contact form."
  },
  {
    question: "Which mortar type does my home need — Type N, S, or M?",
    answer: "Type N (medium strength) is correct for above-grade exterior walls on most Chicago homes — flexible enough to move with brick without causing spalling. Type S is for below-grade and soil-contact work; Type M is for foundations and hardscape only. AMS matches every mortar mix to your specific brick type and location before touching your joints."
  }
];
---

<BaseLayout
  title="Tuckpointing & Repointing Chicago | All Masonry Services"
  description="Professional tuckpointing and mortar repointing for Chicago and Chicagoland homes. 19+ years experience. Free estimates. Call 773-656-2107."
  canonical={pageUrl}
  ogImage="/og-image.jpg"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(aggregateRatingSchema)} />
  <SchemaService
    name="Tuckpointing & Repointing in Chicago & Chicagoland"
    description="Professional tuckpointing and mortar repointing services for Chicago and Chicagoland homes. 19+ years experience, fully licensed and insured."
    url={pageUrl}
    provider="All Masonry Services"
    providerUrl={siteUrl}
    areaServed="Chicago, Chicagoland, IL"
    serviceType="Tuckpointing"
  />
  <SchemaFAQ items={faqItems} />

  <!-- ─── 1. HERO ─── -->
  <section class="sp-hero">
    <div class="sp-hero-inner">
      <div class="sp-hero-content">
        <div class="sp-hero-badges">
          <span class="sp-badge sp-badge--gold">Free Estimates</span>
          <span class="sp-badge sp-badge--outline">Family-Owned Since 2007</span>
        </div>
        <h1 class="sp-hero-h1">
          Tuckpointing &amp; Repointing<br>
          <em>in Chicago &amp; Chicagoland</em>
        </h1>
        <p class="sp-hero-sub">
          Chicago winters crack mortar joints faster than anywhere else in the Midwest.
          We stop water infiltration before it becomes a brick replacement — with matched mortar, clean joints, and work that lasts 20–30 years.
        </p>
        <div class="sp-hero-stats">
          <div class="sp-stat">
            <span class="sp-stat-num">500+</span>
            <span class="sp-stat-label">Homes Completed</span>
          </div>
          <div class="sp-stat-divider"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">4.8★</span>
            <span class="sp-stat-label">92 Google Reviews</span>
          </div>
          <div class="sp-stat-divider"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">19</span>
            <span class="sp-stat-label">Cities Served</span>
          </div>
        </div>
        <div class="sp-hero-actions">
          <a href="/contact#form" class="sp-btn sp-btn--primary">Get a Free Estimate</a>
          <a href="tel:7736562107" class="sp-btn sp-btn--ghost" aria-label="Call 773-656-2107">Call 773-656-2107</a>
        </div>
      </div>
      <div class="sp-hero-img-wrap">
        <img
          src="/images/projects/chicago-tuckpointing-repointing-desktop.webp"
          alt="Professional tuckpointing on a Chicago brick home"
          width="600"
          height="750"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ─── 2. TRUST BAR ─── -->
  <section class="sp-trust">
    <div class="sp-trust-inner">
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Licensed &amp; Insured in Illinois
      </div>
      <div class="sp-trust-sep"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Free On-Site Estimates
      </div>
      <div class="sp-trust-sep"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Mortar Matched to Your Brick
      </div>
      <div class="sp-trust-sep"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        19+ Years in Chicagoland
      </div>
    </div>
  </section>

  <!-- ─── 3. PROBLEM / CONSEQUENCE ─── -->
  <section class="sp-problem">
    <div class="sp-problem-inner">
      <div class="sp-section-label">Why It Matters</div>
      <h2 class="sp-section-h2">What Happens When You<br><em>Delay Tuckpointing</em></h2>
      <p class="sp-section-sub">
        Mortar joints are the weakest point in any brick wall. Chicago's freeze-thaw cycle attacks them every single winter. Here's what ignoring them costs you.
      </p>
      <div class="sp-problem-grid">
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="sp-problem-title">Water Gets Behind Your Brick</h3>
          <p class="sp-problem-body">
            Cracked mortar is an open door for water. Once moisture gets behind the brick face, it saturates your wall cavity, insulation, and eventually your interior framing — invisible damage until it's expensive.
          </p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3 class="sp-problem-title">Freeze-Thaw Destroys Bricks</h3>
          <p class="sp-problem-body">
            Water inside joints freezes and expands every winter — 9% expansion per freeze cycle. After 2–3 seasons it spalls bricks from the inside. A $500 tuckpointing job becomes a $10,000+ brick replacement.
          </p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="sp-problem-title">Repair Cost Grows Every Season</h3>
          <p class="sp-problem-body">
            Mortar damage is exponential, not linear. The longer you wait, the more joints fail, the more water enters, the more bricks crack.
          </p>
          <div class="sp-cost-ramp" aria-label="Cost escalation timeline">
            <div class="sp-cost-step">
              <span class="sp-cost-stage">Now</span>
              <span class="sp-cost-bar sp-cost-bar--1"></span>
              <span class="sp-cost-dollar">$</span>
              <span class="sp-cost-label">Tuckpointing</span>
            </div>
            <div class="sp-cost-step">
              <span class="sp-cost-stage">1–2 yrs</span>
              <span class="sp-cost-bar sp-cost-bar--2"></span>
              <span class="sp-cost-dollar">$$</span>
              <span class="sp-cost-label">Joint failure</span>
            </div>
            <div class="sp-cost-step">
              <span class="sp-cost-stage">3–4 yrs</span>
              <span class="sp-cost-bar sp-cost-bar--3"></span>
              <span class="sp-cost-dollar">$$$</span>
              <span class="sp-cost-label">Brick spalling</span>
            </div>
            <div class="sp-cost-step">
              <span class="sp-cost-stage">5+ yrs</span>
              <span class="sp-cost-bar sp-cost-bar--4"></span>
              <span class="sp-cost-dollar">$$$$</span>
              <span class="sp-cost-label">Structural</span>
            </div>
          </div>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3 class="sp-problem-title">Failed Home Inspections</h3>
          <p class="sp-problem-body">
            Visible mortar deterioration is flagged on every home inspection. Buyers negotiate down — or walk away. Tuckpointing before listing your home is one of the highest-ROI repairs you can make.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 4. PROCESS ─── -->
  <section class="sp-process">
    <div class="sp-process-inner">
      <div class="sp-section-label">How We Work</div>
      <h2 class="sp-section-h2">Our Tuckpointing<br><em>Process</em></h2>
      <p class="sp-section-sub">
        No surprise crews. No hidden costs. You know exactly what happens at every step — and why.
      </p>
      <div class="sp-process-steps">
        <div class="sp-step">
          <div class="sp-step-num">01</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Free On-Site Assessment</h3>
            <p class="sp-step-body">We inspect your mortar joints, identify all areas of damage, and assess the depth of deterioration. You get a full written scope and a firm quote — no surprises once work starts.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Phone estimates for masonry are guesswork. The only accurate quote comes from seeing the brick in person — depth of damage, mortar type, and access all affect cost.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">02</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Mortar Matching</h3>
            <p class="sp-step-body">We match the new mortar to your existing joints — color, texture, and hardness. Using the wrong mortar hardness is the #1 cause of premature failure and cracked bricks. We get this right.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Hard mortar on soft brick transfers stress directly to the brick face, causing spalling within 5–10 years. ASTM C270-compliant mortar matching prevents this entirely.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">03</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Old Mortar Removal</h3>
            <p class="sp-step-body">We grind out deteriorated mortar to a depth of 3/4"–1" using angle grinders and chisels — deep enough for the new mortar to bond properly without disturbing the brick face.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Shallow removal (under 3/4") gives new mortar nothing to grip. It looks fine for one season, then pops out entirely. Proper depth is the difference between a 2-year fix and a 25-year fix.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">04</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">New Mortar Application</h3>
            <p class="sp-step-body">Fresh mortar is packed in layers — never in one shot, which causes shrinkage cracks. Each layer is tooled to match the original joint profile for a seamless, weathertight finish.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Single-pass application shrinks as it cures, leaving micro-gaps at the brick edge. Layered application eliminates shrinkage — the joint cures fully bonded on all sides.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">05</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Cleanup &amp; Final Walk-Through</h3>
            <p class="sp-step-body">We clean mortar residue off the brick face, sweep the work area, and walk the job with you. If anything doesn't meet your standard, we fix it before we leave.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Mortar residue left on brick permanently stains the face. The walk-through is your final check — not ours. We don't consider the job done until you do.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 5. WHY AMS ─── -->
  <section class="sp-why">
    <div class="sp-why-inner">
      <div class="sp-section-label">What Sets Us Apart</div>
      <h2 class="sp-section-h2">Why Chicagoland Homeowners<br><em>Choose AMS Over Anyone Else</em></h2>
      <div class="sp-why-grid">
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">01</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Mortar-Match Guarantee</h3>
            <p class="sp-why-body">We guarantee your new mortar matches your existing joints in color, texture, and hardness — or we redo it at no charge. No other contractor in the area offers this in writing.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">02</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Transparent, Written Estimates</h3>
            <p class="sp-why-body">Every estimate is free, on-site, and in writing — scope, materials, and timeline before any work begins. No ballpark numbers over the phone.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">03</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Free Damage Assessment Tool</h3>
            <p class="sp-why-body">Before you even call us, use our free mortar assessment to understand your damage level and realistic cost range. No sign-up, no sales call — just honest information so you can make an informed decision.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">04</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Family-Owned — You Deal With the Owners</h3>
            <p class="sp-why-body">Not a franchise, not a subcontractor network — when you call AMS you reach the owners, and the same crew that gives your estimate does the work.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 6. TOOL EMBED ─── -->
  <section class="sp-tool" id="mortar-assessment-tool">
    <div class="sp-tool-inner">
      <div class="sp-tool-header">
        <div class="sp-section-label sp-section-label--light">Free Tool — No Sign-Up Required</div>
        <h2 class="sp-tool-h2">Free Mortar Damage Assessment<br><em>for Chicagoland Homeowners</em></h2>
        <div class="sp-tool-warning-hook" aria-label="Warning signs checklist">
          <p class="sp-tool-warning-intro">Chicago freeze-thaw cycles destroy ignored mortar.</p>
          <ul class="sp-tool-warning-list">
            <li>Crumbling or missing mortar joints</li>
            <li>White staining (efflorescence) on brick face</li>
            <li>Cracks wider than ¼ inch in mortar</li>
          </ul>
          <p class="sp-tool-warning-cta">Find out how serious it is — and what it'll cost — in 60 seconds. Free.</p>
        </div>
        <p class="sp-tool-sub">8 warning signs. 60 seconds. Realistic tuckpointing cost range for your Chicagoland home.</p>
      </div>
      <div class="sp-tool-social">
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">847</span>
          <span class="sp-tool-stat-label">Chicagoland homeowners assessed</span>
        </div>
        <div class="sp-tool-stat-sep"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">4.8★</span>
          <span class="sp-tool-stat-label">Average rating · 92 reviews</span>
        </div>
        <div class="sp-tool-stat-sep"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">60s</span>
          <span class="sp-tool-stat-label">To get your estimate</span>
        </div>
      </div>
      <blockquote class="sp-tool-quote">
        <p>"Used this before calling AMS — the estimate was spot on. Saved me from getting overcharged by another contractor."</p>
        <cite>— Karen L., Winnetka homeowner</cite>
      </blockquote>
      <div class="sp-tool-embed">
        <MortarDamageAssessment />
      </div>
      <p class="sp-tool-note">
        Cost ranges are based on typical Chicagoland tuckpointing projects (2026). Your free on-site estimate from AMS may vary based on actual brick type, mortar depth, and access.
      </p>
      <div class="sp-tool-faq">
        <div class="sp-tool-faq-item">
          <h3 class="sp-tool-faq-q">Is this mortar damage assessment free?</h3>
          <p class="sp-tool-faq-a">Yes — completely free. No account, no email required. You only share contact info if you want your PDF report.</p>
        </div>
        <div class="sp-tool-faq-item">
          <h3 class="sp-tool-faq-q">How accurate is the tuckpointing cost estimate?</h3>
          <p class="sp-tool-faq-a">Reflects real Chicagoland tuckpointing costs from 2026 — typically within 20–30% of the actual quote. An on-site estimate from AMS is always the most accurate number.</p>
        </div>
        <div class="sp-tool-faq-item">
          <h3 class="sp-tool-faq-q">What should I do if the assessment shows moderate or severe damage?</h3>
          <p class="sp-tool-faq-a">Schedule a free on-site assessment before the next Chicago winter. One freeze-thaw cycle through open mortar joints can double the repair cost. Call 773-656-2107 or <a href="/contact#form" class="sp-tool-faq-link">contact us here</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HowTo",
        "name": "How to Check Mortar Damage on Chicago Brick Homes",
        "description": "Use this free mortar damage assessment to identify tuckpointing needs and get a cost estimate for Chicagoland brick homes.",
        "totalTime": "PT1M",
        "step": [
          { "@type": "HowToStep", "position": 1, "name": "Inspect your brick", "text": "Look for crumbling mortar joints, efflorescence (white staining), or cracks wider than ¼ inch." },
          { "@type": "HowToStep", "position": 2, "name": "Answer 8 assessment questions", "text": "Walk through the 8 most common signs of mortar deterioration on Chicago-area brick homes." },
          { "@type": "HowToStep", "position": 3, "name": "Get your damage level and cost range", "text": "Receive a personalized damage assessment and realistic tuckpointing cost range for your Chicagoland home — free, instant, no sign-up." }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
