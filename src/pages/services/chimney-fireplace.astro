.sp-why-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; }
.sp-why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; background: #D8D2C8; border: 1px solid #D8D2C8; margin-top: 48px; }
