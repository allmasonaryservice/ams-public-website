---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaService from '../../components/SchemaService.astro';
import SchemaFAQ from '../../components/SchemaFAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import Footer from '../../components/Footer.astro';
import ChimneyInspectionChecklist from '../../components/magnets/ChimneyInspectionChecklist.astro';

const siteUrl = 'https://allmasonryservices.com';
const phone = '773-656-2107';
const pageUrl = `${siteUrl}/services/chimney-fireplace`;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "All Masonry Services Inc",
  "url": siteUrl,
  "telephone": phone,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Chicago",
    "addressRegion": "IL",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 41.8781,
    "longitude": -87.6298
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "92"
  },
  "openingHours": "Mo-Sa 07:00-18:00",
  "priceRange": "$$",
  "description": "Custom chimney construction and fireplace masonry for Chicagoland homes. New builds, rebuilds, and fireplace surround installation. 19+ years. Free estimates.",
  "areaServed": [
    "Chicago", "Hinsdale", "Oak Brook", "Winnetka", "Highland Park",
    "Elmhurst", "Western Springs", "Naperville", "Wheaton", "Downers Grove",
    "La Grange", "Clarendon Hills", "Burr Ridge", "Willowbrook", "Evanston",
    "Wilmette", "Kenilworth", "Glencoe", "Northbrook"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Chimney & Fireplace Masonry Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "New Chimney Construction" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Chimney Repair & Rebuild" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fireplace Surround Installation" } }
    ]
  }
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Chimney & Fireplace Safety Inspection Checklist",
  "description": "Free chimney safety inspection checklist for Chicagoland homeowners. Check 10 warning signs and get a safety assessment.",
  "url": `${siteUrl}/services/chimney-fireplace#chimney-inspection`,
  "applicationCategory": "HomeAndGarden",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "LocalBusiness",
    "name": "All Masonry Services Inc",
    "url": siteUrl
  }
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How Chimney & Fireplace Masonry Works: AMS 5-Step Process",
  "description": "How AMS builds and installs chimneys and fireplaces in Chicagoland.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Drawing Review & Code Check",
      "text": "We review your drawings against current IRC and local code — chimney height, clearances, flue sizing, and crown specifications — before any work begins."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Foundation & Footing Inspection",
      "text": "Chimney mass requires an engineered footing. We verify footing capacity and dimensions before constructing the chimney base."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Brick or Block Construction",
      "text": "We construct the chimney in planned courses — checking plumb at every lift, using correct mortar type for each application."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Crown Cap & Flashing Installation",
      "text": "We pour or form a proper sloped crown, install a code-compliant cap, and flash the chimney-roof junction to current standards — including a cricket where required."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Firebox Completion & Final Inspection",
      "text": "We complete the firebox with refractory mortar, install damper, and conduct a final walk-through including flue visual check."
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": `${siteUrl}/services`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Chimney & Fireplace",
      "item": pageUrl
    }
  ]
};

const faqItems = [
  {
    question: "Do I need a permit to build or rebuild a chimney?",
    answer: "Yes — chimney construction and major repair requires a permit in most Chicagoland municipalities. AMS pulls all required permits, coordinates inspections, and maintains a clean inspection record."
  },
  {
    question: "How long does chimney construction take?",
    answer: "A new chimney construction takes 5–10 days depending on height and complexity. Chimney rebuild from the roofline takes 1–3 days. A fireplace surround installation runs 2–3 days."
  },
  {
    question: "What is refractory mortar and why does it matter?",
    answer: "Refractory mortar is a heat-resistant mortar designed for fireplace temperatures (2,000°F+). Standard mortar fails at these temperatures — cracking joints, allowing heat to transfer to combustibles. Every AMS firebox uses refractory mortar, not standard mortar."
  },
  {
    question: "What is a chimney cricket?",
    answer: "A cricket is a small ridged structure installed behind a chimney to divert water around it rather than collecting at the chimney-roof junction. It's required by code on all chimneys over 30 inches wide. AMS installs crickets on every applicable chimney."
  },
  {
    question: "Can you match existing brick on a chimney rebuild?",
    answer: "Yes — we source brick to match your existing chimney and exterior brick in color and texture. The goal is a rebuild that's visually indistinguishable from the original."
  },
  {
    question: "Is AMS licensed for fireplace and chimney construction?",
    answer: "Yes — licensed masonry contractor in Illinois (License #MA-104-018887), $2.5M liability, workers' comp. We pull permits and work above board on every job."
  },
  {
    question: "What is a chimney crown and why does it fail?",
    answer: "The crown is the concrete or mortar cap that seals the top of the chimney around the flue. Thin or flat crowns crack within 2–3 Chicago winters from freeze-thaw cycles. A proper crown is sloped, overhangs the brick face, and is cast in concrete — not mortar. AMS builds code-compliant crowns only."
  },
  {
    question: "How do I know if my chimney needs repair vs. full rebuild?",
    answer: "If deterioration is limited to mortar joints, crown, or cap — repair is typically appropriate. If the brick itself is spalling or the structure has moved, a partial or full rebuild may be necessary. AMS assesses on site and gives you an honest recommendation."
  }
];
---

<BaseLayout
  title="Chimney & Fireplace Masonry Chicago | All Masonry Services"
  description="Custom chimney construction and fireplace masonry for Chicagoland homes. New builds, rebuilds, and fireplace surround installation. 19+ years. Free estimates. Call 773-656-2107."
  canonical={pageUrl}
  ogImage="/og-image.jpg"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <style>
.sp-section-label { font-family: 'Satoshi', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #D4A931; margin-bottom: 14px; }
.sp-section-label--light { color: #D4A931; }
.sp-section-h2 { font-family: 'Fraunces', serif; font-size: clamp(28px, 3.5vw, 40px); font-weight: 700; color: #1A1A1A; line-height: 1.2; margin: 0 0 16px 0; }
.sp-section-h2 em { font-style: italic; font-weight: 400; color: #D4A931; }
.sp-section-sub { font-family: 'Satoshi', sans-serif; font-size: 16px; color: #4A4A4A; line-height: 1.75; max-width: 640px; margin: 0 0 48px 0; }
.sp-badge { font-family: 'Satoshi', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 10px; border-radius: 0px; }
.sp-badge--gold { background: #D4A931; color: #1A1A1A; }
.sp-badge--outline { border: 2px solid #D4A931; color: #D4A931; background: transparent; }
.sp-btn { display: inline-flex; align-items: center; justify-content: center; font-family: 'Satoshi', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; padding: 13px 28px; min-height: 44px; border: 2px solid transparent; border-radius: 0px; transition: background 200ms ease, border-color 200ms ease, color 200ms ease; white-space: nowrap; cursor: pointer; }
.sp-btn--primary { background: #D4A931; color: #1A1A1A; border-color: #D4A931; }
.sp-btn--primary:hover { background: #B8932A; border-color: #B8932A; }
.sp-btn--primary:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }
.sp-btn--ghost { background: transparent; color: #D4A931; border-color: #D4A931; }
.sp-btn--ghost:hover { background: #D4A931; color: #1A1A1A; }
.sp-btn--ghost:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }
.sp-btn--outline { background: transparent; color: #1A1A1A; border-color: #1A1A1A; }
.sp-btn--outline:hover { background: #1A1A1A; color: #D4A931; }
.sp-btn--outline:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }
.sp-hero { background: #F5F3EF; padding: 120px 0 100px; }
.sp-hero-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; display: grid; grid-template-columns: 1fr 420px; gap: 64px; align-items: center; }
.sp-hero-badges { display: flex; gap: 10px; margin-bottom: 24px; flex-wrap: wrap; }
.sp-hero-h1 { font-family: 'Fraunces', serif; font-size: clamp(36px, 4.5vw, 56px); font-weight: 700; color: #1A1A1A; line-height: 1.1; margin: 0 0 20px 0; }
.sp-hero-h1 em { font-style: italic; font-weight: 400; color: #D4A931; }
.sp-hero-sub { font-family: 'Satoshi', sans-serif; font-size: 17px; color: #4A4A4A; line-height: 1.75; margin: 0 0 32px 0; max-width: 520px; }
.sp-hero-stats { display: flex; align-items: center; gap: 24px; margin-bottom: 36px; flex-wrap: wrap; }
.sp-stat { display: flex; flex-direction: column; gap: 4px; }
.sp-stat-num { font-family: 'Fraunces', serif; font-size: 28px; font-weight: 700; color: #D4A931; line-height: 1; }
.sp-stat-label { font-family: 'Satoshi', sans-serif; font-size: 11px; font-weight: 600; color: #8B8070; text-transform: uppercase; letter-spacing: 0.05em; }
.sp-stat-divider { width: 1px; height: 40px; background: #D8D2C8; flex-shrink: 0; }
.sp-hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
.sp-hero-img-wrap { position: relative; }
.sp-hero-img-wrap img { width: 100%; height: 500px; object-fit: cover; display: block; border: 2px solid #D8D2C8; }
.sp-trust { background: #1A1A1A; padding: 20px 0; border-top: 1px solid #2D2D2D; }
.sp-trust-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; display: flex; align-items: center; justify-content: center; gap: 32px; flex-wrap: wrap; }
.sp-trust-item { display: flex; align-items: center; gap: 8px; font-family: 'Satoshi', sans-serif; font-size: 12px; font-weight: 600; color: #D4A931; letter-spacing: 0.04em; text-transform: uppercase; }
.sp-trust-item svg { flex-shrink: 0; }
.sp-trust-sep { width: 1px; height: 20px; background: #2D2D2D; }
.sp-problem { background: #E8E4DC; padding: 100px 0; }
.sp-problem-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; }
.sp-problem-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
.sp-problem-card { background: #fff; border: 1px solid #D8D2C8; padding: 28px 24px; }
.sp-problem-card:hover { border: 2px solid #D4A931; }
.sp-problem-icon { margin-bottom: 16px; }
.sp-problem-title { font-family: 'Satoshi', sans-serif; font-size: 14px; font-weight: 700; color: #1A1A1A; margin: 0 0 10px 0; text-transform: uppercase; letter-spacing: 0.04em; }
.sp-problem-body { font-family: 'Satoshi', sans-serif; font-size: 14px; color: #4A4A4A; line-height: 1.7; margin: 0; }
.sp-process { background: #F5F3EF; padding: 100px 0; }
.sp-process-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; }
.sp-process-steps { display: flex; flex-direction: column; gap: 0; border: 1px solid #D8D2C8; }
.sp-step { display: grid; grid-template-columns: 100px 1fr; gap: 0; border-bottom: 1px solid #D8D2C8; transition: background 200ms ease; opacity: 0; transform: translateX(-24px); }
@media (prefers-reduced-motion: reduce) { .sp-step { opacity: 1; transform: none; } }
.sp-step:last-child { border-bottom: none; }
.sp-step:hover { background: #fff; }
.sp-step-num { font-family: 'Fraunces', serif; font-size: 36px; font-weight: 700; color: #D4A931; padding: 32px 0 32px 32px; display: flex; align-items: flex-start; opacity: 0.6; line-height: 1; }
.sp-step-content { padding: 32px 32px 32px 0; }
.sp-step-title { font-family: 'Satoshi', sans-serif; font-size: 14px; font-weight: 700; color: #1A1A1A; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 8px 0; }
.sp-step-body { font-family: 'Satoshi', sans-serif; font-size: 15px; color: #4A4A4A; line-height: 1.7; margin: 0 0 10px 0; }
.sp-step-why { font-family: 'Satoshi', sans-serif; font-size: 13px; color: #8B8070; line-height: 1.65; margin: 0; padding: 10px 12px; border-left: 3px solid #D4A931; background: rgba(212,169,49,0.05); }
.sp-step-why strong { color: #D4A931; font-weight: 700; }
