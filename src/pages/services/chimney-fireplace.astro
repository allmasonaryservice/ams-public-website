.sp-pricing-link:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }
.sp-pricing-guarantee { font-family: 'Satoshi', sans-serif; font-size: 14px; font-weight: 600; color: #1A1A1A; background: rgba(212,169,49,0.07); border-left: 3px solid #D4A931; padding: 12px 16px; margin-top: 16px; max-width: 600px; }
.sp-reviews { background: #E8E4DC; padding: 100px 0; }
.sp-reviews-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; }
