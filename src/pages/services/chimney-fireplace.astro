.sp-tool-note { font-family: 'Satoshi', sans-serif; font-size: 12px; color: #8B8070; text-align: center; margin-top: 20px; line-height: 1.6; }
.sp-tool-faq { margin-top: 48px; border-top: 1px solid #2D2D2D; padding-top: 40px; display: flex; flex-direction: column; gap: 28px; }
.sp-tool-faq-q { font-family: 'Satoshi', sans-serif; font-size: 14px; font-weight: 700; color: #D4A931; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 8px 0; }
.sp-tool-faq-a { font-family: 'Satoshi', sans-serif; font-size: 15px; color: rgba(255,255,255,0.65); line-height: 1.75; margin: 0; }
.sp-tool-faq-link { color: #D4A931; text-decoration: underline; }
