.sp-price-card { background: #fff; border: 1px solid #D8D2C8; padding: 32px 28px; display: flex; flex-direction: column; gap: 20px; }
.sp-price-card--featured { border: 2px solid #D4A931; position: relative; }
.sp-price-popular { position: absolute; top: -1px; left: 50%; transform: translateX(-50%); background: #D4A931; color: #1A1A1A; font-family: 'Satoshi', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 12px; }
.sp-price-tier { font-family: 'Satoshi', sans-serif; font-size: 12px; font-weight: 700; color: #8B8070; text-transform: uppercase; letter-spacing: 0.08em; margin-top: 12px; }
.sp-price-range { font-family: 'Fraunces', serif; font-size: 32px; font-weight: 700; color: #1A1A1A; line-height: 1; }
