.sp-why-content { display: flex; flex-direction: column; gap: 10px; }
.sp-why-title { font-family: 'Satoshi', sans-serif; font-size: 13px; font-weight: 700; color: #1A1A1A; text-transform: uppercase; letter-spacing: 0.05em; margin: 0; }
.sp-why-body { font-family: 'Satoshi', sans-serif; font-size: 15px; color: #4A4A4A; line-height: 1.7; margin: 0; }
.sp-tool { background: #1A1A1A; padding: 100px 0; }
.sp-tool-inner { max-width: 900px; margin: 0 auto; padding: 0 80px; }
.sp-tool-header { text-align: center; margin-bottom: 48px; }
.sp-tool-h2 { font-family: 'Fraunces', serif; font-size: clamp(28px, 3.5vw, 40px); font-weight: 700; color: #fff; line-height: 1.2; margin: 0 0 16px 0; }
.sp-tool-h2 em { font-style: italic; font-weight: 400; color: #D4A931; }
.sp-tool-sub { font-family: 'Satoshi', sans-serif; font-size: 16px; color: rgba(255,255,255,0.65); line-height: 1.75; margin: 0; }
.sp-tool-warning-hook { background: rgba(212,169,49,0.08); border: 1px solid rgba(212,169,49,0.25); border-left: 3px solid #D4A931; padding: 20px 24px; margin: 0 auto 28px; max-width: 640px; text-align: left; }
.sp-tool-warning-intro { font-family: 'Satoshi', sans-serif; font-size: 13px; font-weight: 700; color: #D4A931; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 12px 0; }
.sp-tool-warning-list { margin: 0 0 14px 0; padding: 0 0 0 18px; display: flex; flex-direction: column; gap: 6px; }
.sp-tool-warning-list li { font-family: 'Satoshi', sans-serif; font-size: 14px; color: rgba(255,255,255,0.8); line-height: 1.5; }
.sp-tool-warning-cta { font-family: 'Satoshi', sans-serif; font-size: 14px; font-weight: 600; color: #fff; margin: 0; }
.sp-tool-embed { background: #fff; border: 2px solid #D4A931; padding: 40px; min-height: 200px; }
.sp-tool-social { display: flex; align-items: center; justify-content: center; gap: 32px; flex-wrap: wrap; margin-bottom: 28px; }
.sp-tool-stat { display: flex; flex-direction: column; align-items: center; gap: 4px; }
.sp-tool-stat-num { font-family: 'Fraunces', serif; font-size: 26px; font-weight: 700; color: #D4A931; line-height: 1; }
.sp-tool-stat-label { font-family: 'Satoshi', sans-serif; font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.45); text-transform: uppercase; letter-spacing: 0.05em; text-align: center; }
.sp-tool-stat-sep { width: 1px; height: 36px; background: #2D2D2D; flex-shrink: 0; }
