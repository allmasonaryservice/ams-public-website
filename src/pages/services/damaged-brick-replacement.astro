---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaService from '../../components/SchemaService.astro';
import SchemaFAQ from '../../components/SchemaFAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import Footer from '../../components/Footer.astro';
import BrickDamageCounter from '../../components/magnets/BrickDamageCounter.astro';

const siteUrl = 'https://allmasonryservices.com';
const pageUrl = `${siteUrl}/services/damaged-brick-replacement`;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Brick Damage Assessment & Replacement Cost Estimator",
  "description": "Free brick damage counter for Chicagoland homeowners. Count damaged bricks by type, get a repair estimate and urgency rating.",
  "applicationCategory": "HomeAndGarden",
  "operatingSystem": "Web",
  "url": `${siteUrl}/services/damaged-brick-replacement#brick-damage-counter`,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "All Masonry Services",
    "url": siteUrl
  }
};

const aggregateRatingSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "All Masonry Services",
  "url": siteUrl,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "92",
    "bestRating": "5"
  }
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How Damaged Brick Replacement Works: AMS 5-Step Process",
  "description": "How AMS removes and replaces damaged brick to match your existing facade in Chicagoland.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Damage Assessment & Brick Matching",
      "text": "We assess all damaged bricks, identify the extent of structural impact, and source matching bricks in color, texture, and size before any removal begins."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Controlled Removal",
      "text": "We remove damaged bricks with angle grinders and chisels — carefully, to avoid disturbing adjacent sound bricks or mortar joints that don't need replacement."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Substrate Inspection",
      "text": "Once bricks are removed, we inspect the substrate, wall cavity, and mortar bed for moisture damage or structural issues before placing replacement bricks."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Replacement Brick Setting & Mortar Matching",
      "text": "We set replacement bricks in correctly matched mortar — type, color, and texture — and tool joints to match the existing profile."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Cleanup & Final Walk-Through",
      "text": "We clean mortar residue from surrounding brick, sweep the work area, and walk the repair with you. The standard: you shouldn't be able to tell which bricks were replaced."
    }
  ]
};

const faqItems = [
  {
    question: "How do I know if my brick needs to be replaced or just repaired?",
    answer: "If the brick face is spalling (layers separating), cracked through more than 1/3 of its depth, or showing interior erosion — replacement is the right call. Hairline surface cracks that haven't penetrated deeply may be sealed rather than replaced. AMS assesses on site and tells you honestly which approach applies."
  },
  {
    question: "Can you match old or discontinued brick?",
    answer: "Often yes — we work with a network of brick suppliers including reclaimed brick sources that specialize in matching older Chicago-area housing stock. Some discontinued styles aren't matchable, and we'll tell you that upfront rather than install something visibly different."
  },
  {
    question: "How do you remove damaged bricks without damaging surrounding ones?",
    answer: "We use angle grinders to cut through mortar joints and chisels to carefully extract the brick — working outward from the brick center to avoid stress to adjacent units. This is slower than aggressive removal but preserves the surrounding wall."
  },
  {
    question: "How long does brick replacement take?",
    answer: "Minor repairs (under 10 bricks) run half a day to a day. Moderate repairs (10–50 bricks) take 1–2 days. Extensive replacement (50+ bricks) may run 3–5 days depending on sourcing and access."
  },
  {
    question: "Why does my brick keep spalling?",
    answer: "In Chicago's climate, spalling is caused by water infiltration followed by freeze-thaw expansion — usually entering through deteriorated mortar joints. AMS evaluates mortar condition at the same time as brick damage and addresses both to prevent recurrence."
  },
  {
    question: "Can damaged brick replacement improve my home's value?",
    answer: "Yes — visible brick damage is flagged on home inspections and creates negative first impressions. Pre-sale brick repair consistently shows a positive ROI in the Chicagoland market. Many of our clients do brick work specifically before listing."
  },
  {
    question: "Do you replace brick on commercial properties?",
    answer: "Yes — AMS does damaged brick replacement on commercial buildings as well as residential. Commercial brick replacement involves the same process but may require special access equipment and after-hours work."
  },
  {
    question: "Is AMS licensed and insured for brick replacement work?",
    answer: "Yes — licensed masonry contractor in Illinois, $2.5M general liability, workers' comp. Free estimates at 773-656-2107."
  }
];
---

<BaseLayout
  title="Damaged Brick Replacement Chicago | All Masonry Services"
  description="Cracked, spalled, and damaged brick replacement for Chicagoland homes. Brick matching, precise removal, and seamless repair. 19+ years. Free estimates. Call 773-656-2107."
  canonical={pageUrl}
  ogImage="/og-image.jpg"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(aggregateRatingSchema)} />
  <SchemaService
    name="Damaged Brick Replacement in Chicago & Chicagoland"
    description="Cracked, spalled, and damaged brick replacement for Chicagoland homes. Brick matching, precise removal, and seamless repair. 19+ years experience."
    url={pageUrl}
    provider="All Masonry Services"
    providerUrl={siteUrl}
    areaServed="Chicago, Chicagoland, IL"
    serviceType="Damaged Brick Replacement"
  />
  <SchemaFAQ items={faqItems} />

  <!-- ─── 1. HERO ─── -->
  <section class="sp-hero">
    <div class="sp-hero-inner">
      <div class="sp-hero-content">
        <div class="sp-hero-badges">
          <span class="sp-badge sp-badge--gold">Free Estimates</span>
          <span class="sp-badge sp-badge--outline">Family-Owned Since 2007</span>
        </div>
        <h1 class="sp-hero-h1">
          Damaged Brick Replacement<br>
          <em>in Chicago &amp; Chicagoland</em>
        </h1>
        <p class="sp-hero-sub">
          Spalled, cracked, or structurally compromised bricks replaced and matched to your existing facade — so precisely the repair is invisible. Protecting your home from the inside out.
        </p>
        <div class="sp-hero-stats">
          <div class="sp-stat">
            <span class="sp-stat-num">500+</span>
            <span class="sp-stat-label">Homes Completed</span>
          </div>
          <div class="sp-stat-divider"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">4.8★</span>
            <span class="sp-stat-label">92 Google Reviews</span>
          </div>
          <div class="sp-stat-divider"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">19+</span>
            <span class="sp-stat-label">Years Experience</span>
          </div>
        </div>
        <div class="sp-hero-actions">
          <a href="/contact" class="sp-btn sp-btn--primary">Get a Free Estimate</a>
          <a href="tel:7736562107" class="sp-btn sp-btn--ghost" aria-label="Call 773-656-2107">Call 773-656-2107</a>
        </div>
      </div>
      <div class="sp-hero-img-wrap">
        <img
          src="/images/why-choose-us-brick.webp"
          alt="Damaged brick replacement on a Chicagoland home facade"
          width="600"
          height="750"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ─── 2. TRUST BAR ─── -->
  <section class="sp-trust">
    <div class="sp-trust-inner">
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Licensed &amp; Insured
      </div>
      <div class="sp-trust-sep"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Free Estimates
      </div>
      <div class="sp-trust-sep"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Precision Brick Matching
      </div>
      <div class="sp-trust-sep"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        19+ Years
      </div>
    </div>
  </section>

  <!-- ─── 3. PROBLEM / CONSEQUENCE ─── -->
  <section class="sp-problem">
    <div class="sp-problem-inner">
      <div class="sp-section-label">Why It Matters</div>
      <h2 class="sp-section-h2">What Happens When You<br><em>Ignore Damaged Brick</em></h2>
      <p class="sp-section-sub">
        Damaged bricks don't stay contained. Every compromised brick creates an entry point for water — and Chicago winters turn every entry point into an expanding problem.
      </p>
      <div class="sp-problem-grid">
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="sp-problem-title">Water Entry Through Damaged Faces</h3>
          <p class="sp-problem-body">A spalled or cracked brick exposes the porous interior to water. That water migrates into the wall cavity, soaks insulation, and eventually reaches interior framing — damage you don't see until it's extensive.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3 class="sp-problem-title">Freeze-Thaw Accelerates Failure</h3>
          <p class="sp-problem-body">Water behind damaged brick freezes every winter. Ice expansion fractures adjacent bricks from the inside — one damaged brick becomes three, then ten. What's a $400 repair in fall is a $3,000 repair by spring.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3 class="sp-problem-title">Structural Integrity Degradation</h3>
          <p class="sp-problem-body">Multiple damaged bricks in a concentrated area reduce the wall's ability to carry load and resist lateral force. In severe cases, this creates structural risk — not just cosmetic damage.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="sp-problem-title">Pre-Sale Inspection Failures</h3>
          <p class="sp-problem-body">Home inspectors flag visible brick damage on every report. Buyers negotiate — or walk away. Replacing damaged bricks before listing is one of the highest-ROI repairs available.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 4. PROCESS ─── -->
  <section class="sp-process">
    <div class="sp-process-inner">
      <div class="sp-section-label">How We Work</div>
      <h2 class="sp-section-h2">Our Damaged Brick<br><em>Replacement Process</em></h2>
      <p class="sp-section-sub">
        From damage assessment to final walk-through — the repair should be invisible when we're done.
      </p>
      <div class="sp-process-steps">
        <div class="sp-step">
          <div class="sp-step-num">01</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Damage Assessment &amp; Brick Matching</h3>
            <p class="sp-step-body">We assess all damaged bricks, identify the extent of structural impact, and source matching bricks in color, texture, and size before any removal begins.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Removing bricks before you have a match means either your wall sits open longer than it should, or you use a visibly different brick. We source first.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">02</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Controlled Removal</h3>
            <p class="sp-step-body">We remove damaged bricks with angle grinders and chisels — carefully, to avoid disturbing adjacent sound bricks or mortar joints that don't need replacement.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Aggressive removal damages surrounding bricks. Our method preserves as much of the original wall as possible.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">03</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Substrate Inspection</h3>
            <p class="sp-step-body">Once bricks are removed, we inspect the substrate, wall cavity, and mortar bed for moisture damage or structural issues before placing replacement bricks.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Replacing bricks over a wet or damaged substrate just re-seals the problem inside the wall. We address what we find.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">04</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Replacement Brick Setting &amp; Mortar Matching</h3>
            <p class="sp-step-body">We set replacement bricks in correctly matched mortar — type, color, and texture — and tool joints to match the existing profile.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Mortar mismatch is the most visible sign of brick replacement. We match mortar as carefully as we match brick.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">05</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Cleanup &amp; Final Walk-Through</h3>
            <p class="sp-step-body">We clean mortar residue from surrounding brick, sweep the work area, and walk the repair with you. The standard: you shouldn't be able to tell which bricks were replaced.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> A visible repair devalues the aesthetic work. We don't close out until the match is right.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 5. WHY AMS ─── -->
  <section class="sp-why">
    <div class="sp-why-inner">
      <div class="sp-section-label">What Sets Us Apart</div>
      <h2 class="sp-section-h2">Why Chicagoland Homeowners<br><em>Choose AMS for Brick Repair</em></h2>
      <div class="sp-why-grid">
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">01</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Brick Matching Expertise</h3>
            <p class="sp-why-body">We source replacement bricks through our established supplier network and match in-person before committing. Color, texture, and size — as close as possible to identical.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">02</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Mortar-Match Guarantee</h3>
            <p class="sp-why-body">New mortar matched to existing joints in color, texture, and hardness — or we redo it. In writing.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">03</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Free Brick Damage Counter Tool</h3>
            <p class="sp-why-body">Use our damage counter to tally your damaged bricks by type and get a repair cost estimate and urgency rating. No sign-up required.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">04</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Family-Owned — You Deal With the Owners</h3>
            <p class="sp-why-body">No subs, no call centers. Same crew that estimates is the crew that does the repair.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 6. TOOL EMBED ─── -->
  <section class="sp-tool" id="brick-damage-counter">
    <div class="sp-tool-inner">
      <div class="sp-tool-header">
        <div class="sp-section-label sp-section-label--light">Free Tool — No Sign-Up Required</div>
        <h2 class="sp-tool-h2">Free Damaged Brick<br><em>Replacement Damage Assessment</em></h2>
        <div class="sp-tool-warning-hook" aria-label="Warning signs checklist">
          <p class="sp-tool-warning-intro">Spalled or cracked bricks get worse every Chicago winter. Know what you're dealing with now.</p>
          <ul class="sp-tool-warning-list">
            <li>Spalling, flaking, or delaminating brick faces</li>
            <li>Cracks through individual bricks</li>
            <li>Hollow-sounding bricks when tapped</li>
          </ul>
          <p class="sp-tool-warning-cta">Count by damage type — get a repair estimate and urgency rating. Free.</p>
        </div>
        <p class="sp-tool-sub">Count damaged bricks by type → repair cost estimate + urgency rating for your Chicagoland home. 3 minutes. Free.</p>
      </div>
      <div class="sp-tool-social">
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">760+</span>
          <span class="sp-tool-stat-label">Brick damage assessments completed</span>
        </div>
        <div class="sp-tool-stat-sep"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">4.8★</span>
          <span class="sp-tool-stat-label">Average rating · 92 reviews</span>
        </div>
        <div class="sp-tool-stat-sep"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">3 min</span>
          <span class="sp-tool-stat-label">To get your assessment</span>
        </div>
      </div>
      <blockquote class="sp-tool-quote">
        <p>"I counted my damaged bricks using this tool — came back with 23 spalled and 8 cracked. AMS's on-site count was 24 spalled and 9 cracked. The tool basically saved the estimate visit."</p>
        <cite>— Frank M., Homeowner · Naperville, IL</cite>
      </blockquote>
      <div class="sp-tool-embed">
        <BrickDamageCounter />
      </div>
      <p class="sp-tool-note">
        Cost ranges based on typical Chicagoland brick replacement projects (2026). Your free on-site estimate from AMS accounts for brick sourcing, mortar matching, and access conditions.
      </p>
      <div class="sp-tool-faq">
        <div class="sp-tool-faq-item">
          <h3 class="sp-tool-faq-q">Is the damage counter free?</h3>
          <p class="sp-tool-faq-a">Yes — completely free, no account required. You only share contact info if you want your assessment results emailed.</p>
        </div>
        <div class="sp-tool-faq-item">
          <h3 class="sp-tool-faq-q">How accurate is the repair cost estimate?</h3>
          <p class="sp-tool-faq-a">The estimate reflects real Chicagoland brick replacement costs by damage type and count. It gives you a reliable ballpark — your on-site estimate from AMS will be the most accurate number.</p>
        </div>
        <div class="sp-tool-faq-item">
          <h3 class="sp-tool-faq-q">What should I do after getting my assessment?</h3>
          <p class="sp-tool-faq-a">If the tool shows moderate or severe damage, schedule a free on-site assessment before the next Chicago winter. Brick damage left through freeze-thaw cycles gets significantly worse. <a href="/contact" class="sp-tool-faq-link">Schedule here</a> or call 773-656-2107.</p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HowTo",
        "name": "How to Count Damaged Bricks and Estimate Repair Cost in Chicago",
        "description": "Free brick damage counter for Chicagoland homeowners. Count damaged bricks by type, get a repair cost estimate and urgency rating in 3 minutes.",
        "totalTime": "PT3M",
        "step": [
          { "@type": "HowToStep", "position": 1, "name": "Walk your home and count damaged bricks", "text": "Count bricks that are spalling or flaking, cracked through, hollow-sounding when tapped, or showing face separation." },
          { "@type": "HowToStep", "position": 2, "name": "Enter counts by damage type", "text": "Input your brick counts by damage category so the tool can calculate repair scope and urgency for your specific situation." },
          { "@type": "HowToStep", "position": 3, "name": "Get your repair estimate and urgency rating", "text": "Receive a realistic repair cost range, urgency level, and specific next steps for your Chicagoland home — free, instant, downloadable as a PDF." }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is the brick damage counter free?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes — completely free, no account required. You only share contact info if you want your PDF assessment report." }
          },
          {
            "@type": "Question",
            "name": "How accurate is the brick repair cost estimate?",
            "acceptedAnswer": { "@type": "Answer", "text": "The estimate reflects real Chicagoland brick replacement costs by damage type and count for 2026. It gives a reliable ballpark — your on-site estimate from All Masonry Services will be the most accurate number for your specific brick type, mortar match, and site access." }
          },
          {
            "@type": "Question",
            "name": "What happens to damaged brick if I wait through a Chicago winter?",
            "acceptedAnswer": { "@type": "Answer", "text": "Water penetrates cracked and spalled brick, freezes, and expands — turning a $200 repair into a $2,000 replacement. If your assessment shows moderate or severe damage, schedule a free on-site assessment before the next freeze season. Call 773-656-2107." }
          }
        ]
      }
    ]
  }</script>

  <!-- ─── 7. FEATURED PROJECTS ─── -->
  <section class="sp-projects">
    <div class="sp-projects-inner">
      <div class="sp-section-label">Recent Work</div>
      <h2 class="sp-section-h2">Brick Replacement Projects<br><em>Across Chicagoland</em></h2>
      <div class="sp-projects-grid">
        <div class="sp-project-card">
          <div class="sp-project-img-wrap">
            <img
              src="/images/why-choose-us-brick.webp"
              alt="30+ spalled bricks replaced on front facade in Naperville"
              width="540"
              height="405"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="sp-project-info">
            <span class="sp-project-location">Naperville, IL</span>
            <h3 class="sp-project-title">30+ Spalled Bricks — Front Facade</h3>
            <p class="sp-project-desc">32 spalled bricks removed and replaced on a 1975 brick home. All replacement bricks sourced to match existing — homeowner couldn't identify which bricks were new.</p>
          </div>
        </div>
        <div class="sp-project-card">
          <div class="sp-project-img-wrap">
            <img
              src="/images/project-brick-restoration.webp"
              alt="Structural brick damage repair in foundation course in Downers Grove"
              width="540"
              height="405"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="sp-project-info">
            <span class="sp-project-location">Downers Grove, IL</span>
            <h3 class="sp-project-title">Structural Brick Damage — Foundation Course</h3>
