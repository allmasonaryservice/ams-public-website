  <!-- ─── PROCESS SCROLL ANIMATION ─── -->
  <script is:inline>
    (function() {
      function initStepAnimations() {
        var gsap = window.__gsap;
        var ScrollTrigger = window.__ScrollTrigger;
        if (!gsap || !ScrollTrigger) return;
        var steps = document.querySelectorAll('.sp-step');
        if (!steps.length) return;
        steps.forEach(function(step) {
          gsap.fromTo(step, { opacity: 0, x: -24 }, {
            opacity: 1, x: 0, duration: 0.55, ease: 'power2.out',
            scrollTrigger: { trigger: step, start: 'top 88%', toggleActions: 'play none none reverse' }
          });
        });
      }
      // Always wait for animations:ready — prevents race with BaseLayout ScrollTrigger.kill()
      window.removeEventListener('animations:ready', window.__spStepAnimReady);
      window.__spStepAnimReady = initStepAnimations;
      window.addEventListener('animations:ready', window.__spStepAnimReady);
      if (window.__lenis) initStepAnimations();
    })();
  </script>

  <!-- ─── FAQ ACCORDION SCRIPT ─── -->
  <script is:inline>
    (function() {
      var btns = document.querySelectorAll('.sp-faq-q');
      btns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var expanded = this.getAttribute('aria-expanded') === 'true';
          btns.forEach(function(b) {
            b.setAttribute('aria-expanded', 'false');
            var ans = document.getElementById(b.getAttribute('aria-controls'));
            if (ans) ans.style.maxHeight = null;
          });
          if (!expanded) {
            this.setAttribute('aria-expanded', 'true');
            var answer = document.getElementById(this.getAttribute('aria-controls'));
            if (answer) answer.style.maxHeight = answer.scrollHeight + 'px';
          }
        });
        btn.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); this.click(); }
        });
      });
    })();
  </script>

