---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaService from '../../components/SchemaService.astro';
import SchemaFAQ from '../../components/SchemaFAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import Footer from '../../components/Footer.astro';
import ChimneyRiskScore from '../../components/magnets/ChimneyRiskScore.astro';

const siteUrl = 'https://allmasonryservices.com';
const pageUrl = `${siteUrl}/services/chimney-repair-rebuilding`;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Chimney Repair & Structural Risk Score",
  "description": "Free chimney structural risk assessment for Chicagoland homeowners. Answer 12 questions and get a risk score with specific repair recommendations.",
  "applicationCategory": "HomeAndGarden",
  "operatingSystem": "Web",
  "url": `${siteUrl}/services/chimney-repair-rebuilding#chimney-risk-score`,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "provider": {
    "@type": "Organization",
    "name": "All Masonry Services",
    "url": siteUrl
  }
};

const aggregateRatingSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "All Masonry Services",
  "url": siteUrl,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "92",
    "bestRating": "5"
  }
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How Chimney Repair & Rebuilding Works: AMS 5-Step Process",
  "description": "How AMS assesses, repairs, and rebuilds chimneys in Chicagoland.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Full Chimney Assessment",
      "text": "We assess the chimney from footing to crown — exterior brick, mortar joints, flashing, crown condition, and flue liner — and identify all issues before recommending a scope."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Repair vs. Rebuild Recommendation",
      "text": "Based on the assessment, we recommend targeted repair (tuckpointing, crown, cap, flashing) or partial or full rebuild — with honest reasoning for the recommendation."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Targeted Repair or Partial Rebuild",
      "text": "We execute the agreed scope — tuckpointing, crown replacement, flashing, or rebuild from the roofline — with materials specified to the existing chimney's brick type and exposure."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Full Rebuild When Required",
      "text": "Where structural issues or severe deterioration require it, we rebuild the chimney in full — new footing assessment, brick laying from the base, refractory firebox, and proper crown and cap — to current code."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Final Inspection & Water Test",
      "text": "We inspect the completed work, run a water test to verify crown and flashing integrity, and walk the work with you before closing out."
    }
  ]
};

const faqItems = [
  {
    question: "How do I know if my chimney needs repair or full rebuild?",
    answer: "If damage is limited to mortar joints, crown, cap, or flashing — targeted repair is usually sufficient. If the brick itself is structurally compromised (crumbling, spalling deeply, or the chimney has shifted) — partial or full rebuild is required. AMS assesses on site and gives you an honest written recommendation."
  },
  {
    question: "What is a chimney crown and why does mine keep cracking?",
    answer: "The crown is the concrete or mortar cap at the top of the chimney. Thin mortar crowns (the most common installation) crack within 2–3 Chicago winters from freeze-thaw expansion. A proper crown is sloped, overhangs the brick, and is cast in concrete — not mortar. AMS only installs proper concrete crowns."
  },
  {
    question: "Can you repair a leaning chimney?",
    answer: "Chimney lean indicates foundation movement or structural separation. Depending on the extent, this requires either stabilization and tuckpointing or full demolition and rebuild. A leaning chimney is a safety issue — contact us for an assessment before the next storm season."
  },
  {
    question: "How long does chimney repair take?",
    answer: "Crown and flashing repair: 1 day. Full chimney tuckpoint + crown: 1–2 days. Partial rebuild from roofline: 3–5 days. Full rebuild: 5–10 days depending on height and complexity."
  },
  {
    question: "What causes chimney brick to spall?",
    answer: "Spalling is caused by water infiltrating the brick and freezing. The root cause in most cases is deteriorated mortar joints that allow water entry. Addressing mortar (tuckpointing) alongside brick replacement prevents recurrence. AMS evaluates mortar condition on every brick repair job."
  },
  {
    question: "My ceiling has water stains near the chimney — is that the chimney?",
    answer: "Usually, yes. The most common sources are: a cracked or flat crown allowing water into the flue, deteriorated flashing at the chimney-roof junction, or missing chimney cap allowing rainwater entry. All three are repairable without full rebuild in most cases. AMS diagnoses on site."
  },
  {
    question: "Is AMS licensed for chimney repair and rebuilding?",
    answer: "Yes — licensed masonry contractor in Illinois (License #MA-104-018887), $2.5M general liability, workers' comp. We pull permits for structural chimney work and pass inspections."
  },
  {
    question: "Do you offer warranties on chimney repair work?",
    answer: "Yes — all repair and rebuild work is warranted against deficient installation. Warranty terms are included in every written contract."
  }
];
---

<BaseLayout
  title="Chimney Repair & Rebuilding Chicago | All Masonry Services"
  description="Expert chimney repair and rebuilding for Chicagoland homes — tuckpointing, crown repair, full rebuilds, and structural restoration. 19+ years. Free estimates. Call 773-656-2107."
  canonical={pageUrl}
  ogImage="/og-image.jpg"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(aggregateRatingSchema)} />
  <SchemaService
    name="Chimney Repair & Rebuilding in Chicago & Chicagoland"
    description="Expert chimney repair and rebuilding for Chicagoland homes — tuckpointing, crown repair, full rebuilds, and structural restoration. 19+ years experience."
    url={pageUrl}
    provider="All Masonry Services"
    providerUrl={siteUrl}
    areaServed="Chicago, Chicagoland, IL"
    serviceType="Chimney Repair"
  />
  <SchemaFAQ items={faqItems} />

  <!-- ─── 1. HERO ─── -->
  <section class="sp-hero">
    <div class="sp-hero-inner">
      <div class="sp-hero-content">
        <div class="sp-hero-badges">
          <span class="sp-badge sp-badge--gold">Free Estimates</span>
          <span class="sp-badge sp-badge--outline">Family-Owned Since 2007</span>
        </div>
        <h1 class="sp-hero-h1">
          Chimney Repair &amp; Rebuilding<br>
          <em>in Chicago &amp; Chicagoland</em>
        </h1>
        <p class="sp-hero-sub">
          Cracked crowns, deteriorated mortar, spalling brick, and structurally compromised chimneys restored — from targeted repairs to full rebuilds, with code-compliant construction and permanent results.
        </p>
        <div class="sp-hero-stats">
          <div class="sp-stat">
            <span class="sp-stat-num">500+</span>
            <span class="sp-stat-label">Homes Completed</span>
          </div>
          <div class="sp-stat-divider"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">4.8★</span>
            <span class="sp-stat-label">92 Google Reviews</span>
          </div>
          <div class="sp-stat-divider"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">19+</span>
            <span class="sp-stat-label">Years Experience</span>
          </div>
        </div>
        <div class="sp-hero-actions">
          <a href="/contact" class="sp-btn sp-btn--primary">Get a Free Estimate</a>
          <a href="tel:7736562107" class="sp-btn sp-btn--ghost" aria-label="Call 773-656-2107">Call 773-656-2107</a>
        </div>
      </div>
      <div class="sp-hero-img-wrap">
        <img
          src="/images/service-chimney.webp"
          alt="Chimney repair and rebuilding by AMS in Chicagoland"
          width="600"
          height="750"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ─── 2. TRUST BAR ─── -->
  <section class="sp-trust">
    <div class="sp-trust-inner">
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Licensed &amp; Insured
      </div>
      <div class="sp-trust-sep"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Free Estimates
      </div>
      <div class="sp-trust-sep"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Structural Chimney Expertise
      </div>
      <div class="sp-trust-sep"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        19+ Years
      </div>
    </div>
  </section>

  <!-- ─── 3. PROBLEM / CONSEQUENCE ─── -->
  <section class="sp-problem">
    <div class="sp-problem-inner">
      <div class="sp-section-label">Why It Matters</div>
      <h2 class="sp-section-h2">What Happens When You<br><em>Delay Chimney Repair</em></h2>
      <p class="sp-section-sub">
        Chimney deterioration is a structural and safety issue — not cosmetic — that compounds with every Chicago winter and ranks among the most expensive masonry failures homeowners face.
      </p>
      <div class="sp-problem-grid">
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="sp-problem-title">Water Entry Through Damaged Crown</h3>
          <p class="sp-problem-body">A cracked or flat chimney crown allows water to pool and enter the flue. Once water is inside a chimney, it damages the flue liner, mortar joints, and eventually the firebox — repairs escalate from hundreds to thousands quickly.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3 class="sp-problem-title">Freeze-Thaw Destroys Chimney Brick</h3>
          <p class="sp-problem-body">Water in chimney brick expands 9% per freeze cycle — Chicago's 40–60 annual cycles turn surface spalling into structural deterioration within 2–4 years.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3 class="sp-problem-title">Leaning Chimneys Are Safety Hazards</h3>
          <p class="sp-problem-body">A leaning chimney is a structural failure — not cosmetic. An unsecured chimney can separate from the home or fall in a severe storm. Not a repair to defer.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="sp-problem-title">Water Infiltration Damages Interior</h3>
          <p class="sp-problem-body">Chimney water entry doesn't stay in the chimney. It migrates to the chimney breast, attic framing, ceilings, and interior walls — causing mold, rot, and staining that spreads until the source is fixed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 4. PROCESS ─── -->
  <section class="sp-process">
    <div class="sp-process-inner">
      <div class="sp-section-label">How We Work</div>
      <h2 class="sp-section-h2">Our Chimney Repair &amp;<br><em>Rebuilding Process</em></h2>
      <p class="sp-section-sub">
        From full assessment to final water test — honest recommendations, permanent repairs.
      </p>
      <div class="sp-process-steps">
        <div class="sp-step">
          <div class="sp-step-num">01</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Full Chimney Assessment</h3>
            <p class="sp-step-body">We assess the chimney from footing to crown — exterior brick, mortar joints, flashing, crown condition, and flue liner — and identify all issues before recommending a scope.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Partial assessments lead to partial repairs that don't address the root cause. We don't want to be back next year for something we should have caught on the first visit.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">02</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Repair vs. Rebuild Recommendation</h3>
            <p class="sp-step-body">Based on the assessment, we recommend targeted repair (tuckpointing, crown, cap, flashing) or partial or full rebuild — with honest reasoning for the recommendation.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Some contractors recommend full rebuild when targeted repair is sufficient. Others recommend targeted repair when the structure actually needs rebuilding. We give you an honest answer — in writing.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">03</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Targeted Repair or Partial Rebuild</h3>
            <p class="sp-step-body">We execute the agreed scope — tuckpointing, crown replacement, flashing, or rebuild from the roofline — with materials specified to the existing chimney's brick type and exposure.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Chimney repairs done with incorrect mortar or mismatched materials fail faster than the original deterioration. We specify every material before touching the chimney.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">04</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Full Rebuild (When Required)</h3>
            <p class="sp-step-body">Where structural issues or severe deterioration require it, we rebuild the chimney in full — new footing assessment, brick laying from the base, refractory firebox, and proper crown and cap — to current code.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> A chimney rebuilt to code will outlast the original. We don't patch structural problems — we fix them.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">05</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Final Inspection &amp; Water Test</h3>
            <p class="sp-step-body">We inspect the completed work, run a water test to verify crown and flashing integrity, and walk the work with you before closing out.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> The water test is the only way to confirm flashing and crown integrity before you find out through a ceiling stain. We run it every time.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 5. WHY AMS ─── -->
  <section class="sp-why">
    <div class="sp-why-inner">
      <div class="sp-section-label">What Sets Us Apart</div>
      <h2 class="sp-section-h2">Why Chicagoland Homeowners<br><em>Trust AMS for Chimney Repair</em></h2>
      <div class="sp-why-grid">
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">01</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Honest Repair vs. Rebuild Recommendation</h3>
            <p class="sp-why-body">We tell you what the chimney actually needs — not the most expensive option. Our written recommendation includes specific reasoning for every item in scope.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">02</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Structural Chimney Expertise</h3>
            <p class="sp-why-body">Full chimney assessment — footing to crown. We know what failing looks like at every component.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">03</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Free Chimney Risk Score Tool</h3>
            <p class="sp-why-body">Check your chimney against 12 structural risk indicators and get a detailed recommendation. No sign-up required.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">04</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Family-Owned — You Deal With the Owners</h3>
            <p class="sp-why-body">The people giving you the assessment are the people doing the repair. Same standards, every job.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 6. TOOL EMBED ─── -->
  <section class="sp-tool" id="chimney-risk-score">
    <div class="sp-tool-inner">
      <div class="sp-tool-header">
        <div class="sp-section-label sp-section-label--light">Free Tool — No Sign-Up Required</div>
        <h2 class="sp-tool-h2">Free Chimney Repair &amp;<br><em>Structural Risk Score</em></h2>
        <div class="sp-tool-warning-hook" aria-label="Warning signs checklist">
          <p class="sp-tool-warning-intro">A leaning chimney is a structural emergency. Don't wait.</p>
          <ul class="sp-tool-warning-list">
            <li>Cracks in chimney crown, mortar, or brick</li>
            <li>Chimney shifting, leaning, or separating from house</li>
            <li>Water stains on ceilings near chimney</li>
          </ul>
          <p class="sp-tool-warning-cta">Answer 12 questions — get a structural risk score and repair priority. Free.</p>
        </div>
        <p class="sp-tool-sub">12 questions. 4 minutes. Structural risk score + prioritized repair recommendations for your Chicagoland chimney.</p>
      </div>
      <div class="sp-tool-social">
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">890+</span>
          <span class="sp-tool-stat-label">Chimney risk assessments completed</span>
        </div>
        <div class="sp-tool-stat-sep"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">4.8★</span>
          <span class="sp-tool-stat-label">Average rating · 92 reviews</span>
        </div>
        <div class="sp-tool-stat-sep"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">4 min</span>
          <span class="sp-tool-stat-label">To complete assessment</span>
        </div>
      </div>
      <blockquote class="sp-tool-quote">
        <p>"The risk score came back 'High — structural attention required' with three specific items flagged. AMS came out the next day. Two of the three flagged items needed immediate repair. The tool was right."</p>
        <cite>— George W., Homeowner · Evanston, IL</cite>
      </blockquote>
      <div class="sp-tool-embed">
        <ChimneyRiskScore />
      </div>
      <p class="sp-tool-note">
        Risk assessment based on visual warning signs. A professional on-site assessment by AMS is required for accurate structural determination and repair scoping. Call 773-656-2107 to schedule.
      </p>
      <div class="sp-tool-faq">
        <div class="sp-tool-faq-item">
          <h3 class="sp-tool-faq-q">Is the chimney risk score tool free?</h3>
          <p class="sp-tool-faq-a">Yes — completely free, no account required. You only share contact info if you want your PDF report.</p>
        </div>
        <div class="sp-tool-faq-item">
          <h3 class="sp-tool-faq-q">Is this a substitute for a professional inspection?</h3>
          <p class="sp-tool-faq-a">No — this tool identifies visual risk indicators. An AMS on-site assessment evaluates structural integrity, mortar condition, flashing, crown, and flue from a trained perspective. Call 773-656-2107 to schedule.</p>
        </div>
        <div class="sp-tool-faq-item">
          <h3 class="sp-tool-faq-q">What should I do if my score is High?</h3>
          <p class="sp-tool-faq-a">Schedule an on-site assessment before the next winter season. High-risk chimneys can deteriorate significantly through a single Chicago winter — or become a safety hazard in a severe storm. <a href="/contact" class="sp-tool-faq-link">Schedule here</a> or call 773-656-2107.</p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HowTo",
        "name": "How to Check Your Chimney Structural Risk — Chicagoland",
        "description": "Free chimney structural risk score tool for Chicago-area homeowners. Answer 12 questions, get a risk level and prioritized repair recommendations.",
        "totalTime": "PT4M",
        "step": [
          { "@type": "HowToStep", "position": 1, "name": "Inspect your chimney", "text": "Look for cracks in the crown or mortar, leaning or separation, water stains near chimney, and spalling brick." },
          { "@type": "HowToStep", "position": 2, "name": "Answer 12 condition questions", "text": "Walk through 12 structural and visual indicators of chimney deterioration specific to Chicago's climate." },
          { "@type": "HowToStep", "position": 3, "name": "Get your risk score and repair plan", "text": "Receive a Low / Medium / High structural risk score with specific, prioritized repair recommendations — free, instant, no sign-up." }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is the chimney structural risk score tool free?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes — completely free. No account or email required. You only share contact info if you want your PDF risk report." }
          },
          {
            "@type": "Question",
            "name": "Does this replace a professional chimney inspection?",
            "acceptedAnswer": { "@type": "Answer", "text": "No — this tool identifies visual risk indicators. An AMS on-site assessment evaluates structural integrity, mortar condition, flashing, crown, and flue from a trained perspective. Call All Masonry Services at 773-656-2107." }
          },
          {
            "@type": "Question",
            "name": "What should I do if my chimney risk score is High?",
            "acceptedAnswer": { "@type": "Answer", "text": "Schedule a free on-site assessment before the next Chicago winter season. High-risk chimneys can deteriorate rapidly through a single freeze-thaw cycle or become a safety hazard in a severe storm. Call 773-656-2107 or contact All Masonry Services online." }
          }
        ]
      }
    ]
  }</script>

  <!-- ─── 7. FEATURED PROJECTS ─── -->
  <section class="sp-projects">
    <div class="sp-projects-inner">
      <div class="sp-section-label">Recent Work</div>
      <h2 class="sp-section-h2">Chimney Repair Projects<br><em>Across Chicagoland</em></h2>
      <div class="sp-projects-grid">
        <div class="sp-project-card">
          <div class="sp-project-img-wrap">
            <img
              src="/images/service-chimney.webp"
              alt="Full chimney rebuild in Evanston after structural failure"
              width="540"
              height="405"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="sp-project-info">
            <span class="sp-project-location">Evanston, IL</span>
            <h3 class="sp-project-title">Full Chimney Rebuild — Structural Failure</h3>
            <p class="sp-project-desc">Chimney had separated from the home at the roof junction and was leaning. Demolished and rebuilt from the footing — new brick, refractory firebox, proper crown. Home safe for first fire of winter.</p>
          </div>
        </div>
        <div class="sp-project-card">
