---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaService from '../../components/SchemaService.astro';
import SchemaFAQ from '../../components/SchemaFAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import Footer from '../../components/Footer.astro';
import CustomHomeMasonryPlanner from '../../components/magnets/CustomHomeMasonryPlanner.astro';

const siteUrl = 'https://allmasonryservices.com';
const pageUrl = `${siteUrl}/services/custom-home-masonry`;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Custom Home Masonry Project Planner",
  "description": "Free AI-powered masonry planner for custom home builders and homeowners in Chicagoland. Get a personalized scope, timeline, and cost guidance.",
  "applicationCategory": "HomeAndGarden",
  "operatingSystem": "Web",
  "url": `${siteUrl}/services/custom-home-masonry#masonry-planner`,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "provider": { "@type": "Organization", "name": "All Masonry Services", "url": siteUrl }
};

const aggregateRatingSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "All Masonry Services",
  "url": siteUrl,
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.8", "reviewCount": "92", "bestRating": "5" }
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How Custom Home Masonry Works: AMS 5-Step Process",
  "description": "How AMS delivers full-scope masonry for custom home builds in Chicagoland.",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Design Collaboration", "text": "We work directly with your architect or builder at the design stage — reviewing drawings, suggesting materials, and flagging structural or logistical issues before construction starts." },
    { "@type": "HowToStep", "position": 2, "name": "Material Selection & Sourcing", "text": "We help you select the right brick, stone, or limestone for your home's style, climate exposure, and budget. We source materials and confirm availability before the project is scheduled." },
    { "@type": "HowToStep", "position": 3, "name": "Foundation & Substrate Prep", "text": "Every masonry installation starts with the foundation. We verify structural capacity, install weep holes and flashing, and prep substrates to code — work that's invisible but load-bearing." },
    { "@type": "HowToStep", "position": 4, "name": "Full Masonry Installation", "text": "Our crew installs the full scope — brick walls, stone facades, fireplaces, chimneys, retaining walls — according to approved drawings, with daily progress photos shared with your builder." },
    { "@type": "HowToStep", "position": 5, "name": "Final Inspection & Walk-Through", "text": "We complete a joint inspection with your builder before any final payments are released. Every item on the punch list is resolved. No open items, no arguments." }
  ]
};

const faqItems = [
  { question: "What masonry work does AMS do on custom homes?", answer: "AMS handles full-scope masonry for custom homes — exterior brick and stone facades, fireplaces, chimneys, retaining walls, limestone accents, and feature walls. We work with architects, builders, and homeowners throughout Chicagoland from design through final inspection." },
  { question: "How early in the build should I involve a masonry contractor?", answer: "Ideally at the design stage — before drawings are finalized. Material selection affects window placement, lintel sizing, foundation loads, and construction sequencing. Getting us involved early prevents costly change orders and delays once framing starts." },
  { question: "What's the difference between brick, stone, and limestone for a custom home?", answer: "Brick is the most cost-effective and weather-durable option — classic Chicago aesthetic, low maintenance. Limestone is warm, refined, and works with both modern and traditional architecture. Natural stone is a premium option requiring expert installation and careful mortar selection. We help you choose based on style, site exposure, and budget." },
  { question: "Do you work with custom home builders and GCs?", answer: "Yes — the majority of our custom home work comes through builders and general contractors. We're used to coordinating with construction schedules, providing lien waivers, and working within a builder's punch list process. We'll integrate cleanly with your project team." },
  { question: "How long does exterior masonry take on a custom home?", answer: "A full exterior brick facade on a custom home typically runs 3–6 weeks depending on size and complexity. Stone and limestone work can take longer due to custom cutting and fitting. We provide a detailed schedule at the estimate stage so your builder can plan sequencing." },
  { question: "Do you pull permits for custom home masonry?", answer: "Yes. Structural masonry on new construction requires permits in most Chicagoland municipalities. We pull all required permits, schedule inspections, and maintain a clean inspection record on every job." },
  { question: "What geographic areas do you serve for custom home projects?", answer: "We work throughout Chicagoland — from Chicago proper to the North Shore, western suburbs, and surrounding communities. For large custom home projects, we've worked as far as 60 miles from the city. Call us to discuss your project location." },
  { question: "Can AMS help with both exterior masonry and interior features like fireplaces?", answer: "Yes — we're a full-scope masonry contractor. Many custom home clients have us handle everything: exterior brick, stone facade accents, fireplace surrounds, chimney construction, and outdoor masonry elements like retaining walls and patios. One contractor, one accountability line." }
];
---

<BaseLayout
  title="Custom Home Masonry Chicago | All Masonry Services"
  description="Full-scope masonry for custom home builds in Chicagoland — brick, stone, limestone, fireplaces, chimneys. 19+ years working with builders. Free estimates. Call 773-656-2107."
  canonical={pageUrl}
  ogImage="/og-image.jpg"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(aggregateRatingSchema)} />
  <SchemaService
    name="Custom Home Masonry in Chicago & Chicagoland"
    description="Full-scope custom home masonry services — brick facades, natural stone, limestone, fireplaces, chimneys, and retaining walls. 19+ years working with Chicagoland builders."
    url={pageUrl}
    provider="All Masonry Services"
    providerUrl={siteUrl}
    areaServed="Chicago, Chicagoland, IL"
    serviceType="Custom Home Masonry"
  />
  <SchemaFAQ items={faqItems} />

  <!-- ─── 1. HERO ─── -->
  <section class="sp-hero">
    <div class="sp-hero-inner">
      <div class="sp-hero-content">
        <div class="sp-hero-badges">
          <span class="sp-badge sp-badge--gold">Free Estimates</span>
          <span class="sp-badge sp-badge--outline">Family-Owned Since 2007</span>
        </div>
        <h1 class="sp-hero-h1">
          Custom Home Masonry<br>
          <em>in Chicago &amp; Chicagoland</em>
        </h1>
        <p class="sp-hero-sub">
          Brick facades, natural stone accents, limestone details, fireplaces, chimneys — full-scope masonry for custom home builds, delivered on schedule and built to code.
        </p>
        <div class="sp-hero-stats">
          <div class="sp-stat">
            <span class="sp-stat-num">500+</span>
            <span class="sp-stat-label">Homes Completed</span>
          </div>
          <div class="sp-stat-divider"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">4.8★</span>
            <span class="sp-stat-label">92 Google Reviews</span>
          </div>
          <div class="sp-stat-divider"></div>
          <div class="sp-stat">
            <span class="sp-stat-num">19+</span>
            <span class="sp-stat-label">Years Experience</span>
          </div>
        </div>
        <div class="sp-hero-actions">
          <a href="/contact#form" class="sp-btn sp-btn--primary">Get a Free Estimate</a>
          <a href="tel:7736562107" class="sp-btn sp-btn--ghost" aria-label="Call 773-656-2107">Call 773-656-2107</a>
        </div>
      </div>
      <div class="sp-hero-img-wrap">
        <img
          src="/images/projects/oak-brook-custom-home-masonry-desktop.webp"
          alt="Custom home brick facade installed by AMS in Chicagoland"
          width="600"
          height="750"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ─── 2. TRUST BAR ─── -->
  <section class="sp-trust">
    <div class="sp-trust-inner">
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Licensed &amp; Insured in Illinois
      </div>
      <div class="sp-trust-sep"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Free On-Site Estimates
      </div>
      <div class="sp-trust-sep"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Builder &amp; GC Coordination
      </div>
      <div class="sp-trust-sep"></div>
      <div class="sp-trust-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        19+ Years in Chicagoland
      </div>
    </div>
  </section>

  <!-- ─── 3. PROBLEM / CONSEQUENCE ─── -->
  <section class="sp-problem">
    <div class="sp-problem-inner">
      <div class="sp-section-label">Why It Matters</div>
      <h2 class="sp-section-h2">What Goes Wrong When You<br><em>Hire the Wrong Mason</em></h2>
      <p class="sp-section-sub">
        Custom home masonry is permanent. Mistakes made during construction don't show up for 2–5 years — by then they're expensive to fix and impossible to hide.
      </p>
      <div class="sp-problem-grid">
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="sp-problem-title">Wrong Mortar = Cracked Brick</h3>
          <p class="sp-problem-body">Using mortar that's too hard for your brick is the single most common mistake in new construction masonry. It looks fine for a few years — then bricks start spalling from freeze-thaw stress.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3 class="sp-problem-title">Missing Flashing Causes Leaks</h3>
          <p class="sp-problem-body">Flashing, weep holes, and drainage mats are code requirements for a reason. Skip them — or install them incorrectly — and water infiltrates your wall cavity, rotting framing from the inside.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="sp-problem-title">Failed Inspections Cost Money</h3>
          <p class="sp-problem-body">Masonry work that doesn't meet code gets flagged at inspection — delaying your close date, frustrating your builder, and costing you in carrying costs and rework. We pass every inspection on the first visit.</p>
        </div>
        <div class="sp-problem-card">
          <div class="sp-problem-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3 class="sp-problem-title">Subs Who Miss Schedule</h3>
          <p class="sp-problem-body">Masonry is on the critical path. A crew that doesn't show when promised pushes framing, roofing, windows — everything. We commit to a schedule in writing and show up as agreed, every time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 4. PROCESS ─── -->
  <section class="sp-process">
    <div class="sp-process-inner">
      <div class="sp-section-label">How We Work</div>
      <h2 class="sp-section-h2">Our Custom Home Masonry<br><em>Process</em></h2>
      <p class="sp-section-sub">
        From design collaboration to final walk-through — every step is documented, on schedule, and built to pass inspection.
      </p>
      <div class="sp-process-steps">
        <div class="sp-step">
          <div class="sp-step-num">01</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Design Collaboration</h3>
            <p class="sp-step-body">We work directly with your architect or builder at the design stage — reviewing drawings, suggesting materials, and flagging structural or logistical issues before construction starts.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Material choices made at the drawing stage are nearly free to change. Material choices made after framing starts cost thousands in change orders and delays.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">02</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Material Selection &amp; Sourcing</h3>
            <p class="sp-step-body">We help you select the right brick, stone, or limestone for your home's style, climate exposure, and budget — then source and confirm material availability before the project is scheduled.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Some materials have 8–12 week lead times. Finding this out after you've framed the house delays your entire project. We identify it upfront.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">03</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Foundation &amp; Substrate Prep</h3>
            <p class="sp-step-body">Every masonry installation starts with the substrate. We verify structural capacity, install weep holes and flashing, and prep to code — work that's invisible once done but load-bearing.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Inspectors check flashing and weep hole installation before they check anything visible. Get this wrong and you're opening the wall after close.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">04</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Full Masonry Installation</h3>
            <p class="sp-step-body">Our crew installs the full scope — brick walls, stone facades, fireplaces, chimneys, retaining walls — per approved drawings, with daily progress photos shared with your builder.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> Builders need to see progress without being on site. Our photos give your GC visibility and let you catch anything before it's set in mortar.</p>
          </div>
        </div>
        <div class="sp-step">
          <div class="sp-step-num">05</div>
          <div class="sp-step-content">
            <h3 class="sp-step-title">Final Inspection &amp; Walk-Through</h3>
            <p class="sp-step-body">We complete a joint inspection with your builder before any final payments are released. Every punch list item is resolved before we close out. No open items, no arguments.</p>
            <p class="sp-step-why"><strong>Why it matters:</strong> The final walk-through is your leverage. We do it with you — not after you've already paid. That's the only walk-through that counts.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 5. WHY AMS ─── -->
  <section class="sp-why">
    <div class="sp-why-inner">
      <div class="sp-section-label">What Sets Us Apart</div>
      <h2 class="sp-section-h2">Why Chicagoland Builders<br><em>Choose AMS Over Anyone Else</em></h2>
      <div class="sp-why-grid">
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">01</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">We Show Up on Schedule</h3>
            <p class="sp-why-body">Masonry is on the critical path — every missed day pushes framing, roofing, and windows. We commit to a start date in writing and show up as agreed.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">02</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Full Scope Under One Contractor</h3>
            <p class="sp-why-body">Brick facade, stone accents, fireplace, chimney, retaining walls — we handle it all under one contract, one contact, one accountability line for your builder.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">03</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Free Project Planner Tool</h3>
            <p class="sp-why-body">Before you call us, use our free custom home masonry planner to scope your project — materials, timeline, and realistic cost ranges. No sign-up, no sales pressure. Just information.</p>
          </div>
        </div>
        <div class="sp-why-item">
          <div class="sp-why-num" aria-hidden="true">04</div>
          <div class="sp-why-content">
            <h3 class="sp-why-title">Family-Owned — You Deal With the Owners</h3>
            <p class="sp-why-body">Not a franchise, not a sub network — when you call AMS you reach the people doing the work, and the same crew that estimates is on your job site.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 6. TOOL EMBED ─── -->
  <section class="sp-tool" id="masonry-planner">
    <div class="sp-tool-inner">
      <div class="sp-tool-header">
        <div class="sp-section-label sp-section-label--light">Free Tool — No Sign-Up Required</div>
        <h2 class="sp-tool-h2">Free Custom Home Masonry<br><em>Project Planner</em></h2>
        <div class="sp-tool-warning-hook" aria-label="Planning checklist">
          <p class="sp-tool-warning-intro">Starting a custom home build? Know your masonry budget before the first contractor meeting.</p>
          <ul class="sp-tool-warning-list">
            <li>Full exterior brick or stone facade</li>
            <li>Fireplace, chimney, or limestone accents</li>
            <li>Retaining walls or outdoor masonry</li>
          </ul>
          <p class="sp-tool-warning-cta">Get a personalized scope, timeline, and cost range in 2 minutes. Free.</p>
        </div>
        <p class="sp-tool-sub">Your project type, material, and timeline → personalized masonry scope and Chicago 2026 cost range. Instant. Free.</p>
      </div>
      <div class="sp-tool-social">
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">600+</span>
          <span class="sp-tool-stat-label">Custom home projects scoped</span>
        </div>
        <div class="sp-tool-stat-sep"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">4.8★</span>
          <span class="sp-tool-stat-label">Average rating · 92 reviews</span>
        </div>
        <div class="sp-tool-stat-sep"></div>
        <div class="sp-tool-stat">
          <span class="sp-tool-stat-num">2 min</span>
          <span class="sp-tool-stat-label">To get your plan</span>
        </div>
      </div>
      <blockquote class="sp-tool-quote">
        <p>"Used the planner before our first meeting with the builder — came in knowing exactly what to ask for and what it should cost. AMS's actual quote was within 8% of the tool estimate."</p>
        <cite>— Michael R., Custom Home Build · Hinsdale, IL</cite>
      </blockquote>
      <div class="sp-tool-embed">
        <CustomHomeMasonryPlanner />
      </div>
      <p class="sp-tool-note">
        Cost ranges based on Chicagoland custom home masonry projects (2026). Your free on-site estimate from AMS will reflect your specific drawings, materials, and site conditions.
      </p>
      <div class="sp-tool-faq">
        <div class="sp-tool-faq-item">
          <h3 class="sp-tool-faq-q">Is this planner free to use?</h3>
          <p class="sp-tool-faq-a">Yes — completely free. No account or email required. You only share contact info if you want a detailed scope report sent to you.</p>
        </div>
        <div class="sp-tool-faq-item">
          <h3 class="sp-tool-faq-q">How accurate are the cost ranges?</h3>
          <p class="sp-tool-faq-a">The ranges reflect real 2026 Chicagoland custom home masonry project costs. They give you a reliable ballpark — typically within 15–25% of a formal quote. An on-site estimate from AMS is always the most accurate number.</p>
        </div>
        <div class="sp-tool-faq-item">
          <h3 class="sp-tool-faq-q">What should I do after running the planner?</h3>
          <p class="sp-tool-faq-a">If the scope and budget look right for your project, call us or <a href="/contact#form" class="sp-tool-faq-link">fill out our contact form</a> to schedule a free on-site estimate. We'll review your drawings and give you a written quote before any work begins.</p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HowTo",
        "name": "How to Plan a Custom Home Masonry Project in Chicagoland",
        "description": "Free custom home masonry project planner for Chicago-area homeowners and builders. Get a personalized scope, timeline, and cost range in 2 minutes.",
        "totalTime": "PT2M",
        "step": [
          { "@type": "HowToStep", "position": 1, "name": "Select your project type and material", "text": "Choose from full exterior masonry, front facade, fireplace and chimney, retaining walls, or mixed scope. Select your preferred material: brick, natural stone, limestone, or undecided." },
          { "@type": "HowToStep", "position": 2, "name": "Enter home size and timeline", "text": "Provide your home's square footage range and desired start timeline so the planner can tailor the scope and cost range to your project." },
          { "@type": "HowToStep", "position": 3, "name": "Get your personalized masonry plan", "text": "Receive a personalized scope of work, material recommendation, Chicago 2026 cost range, and project timeline — free, instant, downloadable as a PDF." }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is the custom home masonry planner free?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes — completely free. No account or email required. You only share contact info if you want your personalized PDF plan." }
          },
          {
            "@type": "Question",
            "name": "How accurate are the masonry cost ranges for custom homes in Chicago?",
            "acceptedAnswer": { "@type": "Answer", "text": "Cost ranges reflect real 2026 Chicagoland custom home masonry project costs — typically within 15–25% of a formal contractor quote. An on-site estimate from All Masonry Services is always the most accurate number." }
          },
          {
            "@type": "Question",
            "name": "What should I do after running the custom home masonry planner?",
            "acceptedAnswer": { "@type": "Answer", "text": "If the scope and budget look right, call All Masonry Services at 773-656-2107 or fill out the contact form to schedule a free on-site estimate. We'll review your drawings and provide a written quote before any work begins." }
          }
        ]
      }
    ]
  }</script>

  <!-- ─── 7. PROJECTS ─── -->
  <section class="sp-projects">
    <div class="sp-projects-inner">
      <div class="sp-section-label">Recent Work</div>
      <h2 class="sp-section-h2">Custom Home Masonry Projects<br><em>Across Chicagoland</em></h2>
      <div class="sp-projects-grid">
        <div class="sp-project-card">
          <div class="sp-project-img-wrap">
            <img src="/images/projects/kenilworth-custom-home-masonry-desktop.webp" alt="Full brick facade on custom home in Kenilworth" width="540" height="405" loading="lazy" decoding="async" />
          </div>
          <div class="sp-project-info">
            <span class="sp-project-location">Kenilworth, IL</span>
            <h3 class="sp-project-title">Full Brick Facade — New Custom Home</h3>
            <p class="sp-project-desc">Complete exterior brick installation on a 6,400 sq ft custom home. Full coordination with GC, passed all inspections first visit.</p>
            <a href="/projects/kenilworth-custom-home-masonry" class="sp-view-project-btn">VIEW PROJECT</a>
          </div>
        </div>
        <div class="sp-project-card">
          <div class="sp-project-img-wrap">
            <img src="/images/projects/evanston-custom-home-masonry-desktop.webp" alt="Natural stone and limestone accents on custom home in Evanston" width="540" height="405" loading="lazy" decoding="async" />
          </div>
          <div class="sp-project-info">
