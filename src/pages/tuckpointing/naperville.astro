---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import Footer from '../../components/Footer.astro';

const city       = "Naperville";
const slug       = "naperville";
const county     = "DuPage County";
const state      = "IL";
const neighborhoods = "Downtown Naperville Historic District, Naper Settlement area, Route 59 corridor";
const zipCodes   = "60540, 60563, 60564, 60565, 60566, 60567";
const siteUrl    = 'https://allmasonryservices.com';
const pageUrl    = `${siteUrl}/tuckpointing/${slug}`;

const nearbyCities = [
  { name: "Wheaton",         slug: "wheaton"         },
  { name: "Downers Grove",   slug: "downers-grove"   },
  { name: "Clarendon Hills", slug: "clarendon-hills" },
  { name: "Oak Brook",       slug: "oak-brook"       },
  { name: "Willowbrook",     slug: "willowbrook"     },
  { name: "Burr Ridge",      slug: "burr-ridge"      },
];

const services = [
  { name: "Tuckpointing & Repointing",   href: "/services/tuckpointing-repointing"   },
  { name: "Brick Installation",          href: "/services/brick-installation"         },
  { name: "Damaged Brick Replacement",   href: "/services/damaged-brick-replacement"  },
  { name: "Chimney Repair & Rebuilding", href: "/services/chimney-repair-rebuilding"  },
  { name: "Natural Stone & Limestone",   href: "/services/natural-stone-limestone"    },
  { name: "CMU Block Installation",      href: "/services/cmu-block-installation"     },
  { name: "Brick & Stone Veneers",       href: "/services/brick-stone-veneers"        },
  { name: "Custom Home Masonry",         href: "/services/custom-home-masonry"        },
  { name: "Commercial Masonry",          href: "/services/commercial-brick-stone"     },
  { name: "Chimney & Fireplace",         href: "/services/chimney-fireplace"          },
  { name: "Commercial Masonry Veneers",  href: "/services/commercial-masonry-veneers" },
];

const faqs = [
  {
    q: "How much does tuckpointing cost in Naperville, IL?",
    a: "Tuckpointing in Naperville varies by building type — historic downtown soft brick repair runs $14–$32 per linear foot; suburban engineered veneer repointing runs $10–$24. Most residential projects fall between $1,200 and $5,000. All Masonry Services provides free on-site estimates with written scope before any work begins."
  },
  {
    q: "What's the difference between Naperville's historic downtown brick and newer veneer homes?",
    a: "Historic downtown soft brick from the 1840s–1880s is fired at low temperatures and is destroyed by Portland cement — it needs flexible lime mortar. Newer suburban veneer is a manufactured product with different thermal characteristics requiring flexible mortar systems. These two materials are at opposite ends of repair complexity and require completely different approaches."
  },
  {
    q: "Can you repair engineered brick veneer on Naperville suburban homes?",
    a: "Yes. We assess the veneer system, identify failed vs. sound joints, select mortar with appropriate flexibility, and repoint systematically. Early tuckpointing prevents costly cavity wall remediation on DuPage County suburban homes."
  },
  {
    q: "Do you do chimney work in Naperville?",
    a: "Yes — from crown repair on 1990s suburban homes to chimney reconstruction on historic downtown buildings across zip codes 60540, 60563, 60564, 60565. We assess every chimney before recommending repair vs. rebuild, always starting with the most conservative intervention."
  },
  {
    q: "Are you licensed and insured for masonry work in Illinois?",
    a: "Yes — All Masonry Services is fully licensed and insured in Illinois, carrying liability and workers' compensation on every job in Naperville and DuPage County."
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `Tuckpointing in ${city}, ${state}`,
  "description": `All Masonry Services provides licensed, insured tuckpointing, brick repair, and mortar repointing across ${city} — family-owned since 2007.`,
  "url": pageUrl,
  "provider": {
    "@type": "LocalBusiness",
    "name": "All Masonry Services",
    "url": siteUrl,
    "telephone": "+17736562107",
    "address": { "@type": "PostalAddress", "addressLocality": "Chicago", "addressRegion": "IL", "addressCountry": "US" }
  },
  "areaServed": { "@type": "City", "name": city, "addressRegion": state },
  "serviceType": "Tuckpointing",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "description": "Free on-site estimate" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",         "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Tuckpointing", "item": `${siteUrl}/services/tuckpointing-repointing` },
    { "@type": "ListItem", "position": 3, "name": city,           "item": pageUrl }
  ]
};
---

<BaseLayout
  title={`Tuckpointing in ${city}, IL — Brick & Mortar Repair | All Masonry Services`}
  description="Expert tuckpointing & brick repair in Naperville, IL. Historic downtown soft brick, engineered veneer repair, chimney restoration. DuPage County. Free estimates. Call 773-656-2107."
  canonical={pageUrl}
  ogImage="/og-image.jpg"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .lp-hero { background: #1A1A1A; padding: 120px 0 80px; border-bottom: 1px solid #2D2D2D; }
  .lp-hero-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; }
  .lp-breadcrumb { font-family: 'Satoshi', sans-serif; font-size: 12px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 28px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .lp-breadcrumb a { color: rgba(255,255,255,0.4); text-decoration: none; transition: color 200ms ease; }
  .lp-breadcrumb a:hover { color: #D4A931; }
  .lp-breadcrumb a:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }
  .lp-breadcrumb-sep { color: rgba(255,255,255,0.2); }
  .lp-breadcrumb-current { color: #D4A931; }
  .lp-hero-label { display: inline-block; font-family: 'Satoshi', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #1A1A1A; background: #D4A931; padding: 4px 12px; margin-bottom: 20px; }
  .lp-hero h1 { font-family: 'Fraunces', serif; font-size: clamp(38px, 5vw, 68px); font-weight: 700; color: #fff; line-height: 1.05; margin-bottom: 20px; }
  .lp-hero h1 em { font-style: italic; font-weight: 400; color: #D4A931; }
  .lp-hero-sub { font-family: 'Satoshi', sans-serif; font-size: 17px; color: rgba(255,255,255,0.65); line-height: 1.75; max-width: 600px; margin-bottom: 36px; }
  .lp-hero-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 52px; }
  .lp-btn { font-family: 'Satoshi', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; padding: 13px 28px; min-height: 44px; border: 2px solid transparent; transition: background 200ms ease, border-color 200ms ease, color 200ms ease; white-space: nowrap; display: inline-flex; align-items: center; }
  .lp-btn--primary { background: #D4A931; color: #1A1A1A; border-color: #D4A931; }
  .lp-btn--primary:hover { background: #B8932A; border-color: #B8932A; }
  .lp-btn--ghost { background: transparent; color: #D4A931; border-color: #D4A931; }
  .lp-btn--ghost:hover { background: #D4A931; color: #1A1A1A; }
  .lp-btn:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }
  .lp-stats { display: flex; align-items: center; gap: 40px; flex-wrap: wrap; }
  .lp-stat-item { display: flex; flex-direction: column; gap: 3px; }
  .lp-stat-value { font-family: 'Fraunces', serif; font-size: 28px; font-weight: 700; color: #D4A931; line-height: 1; }
  .lp-stat-label { font-family: 'Satoshi', sans-serif; font-size: 11px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255,255,255,0.4); }
  .lp-stat-divider { width: 1px; height: 36px; background: #2D2D2D; }
  .lp-trust { background: #111; border-bottom: 1px solid #2D2D2D; padding: 18px 0; }
  .lp-trust-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; display: flex; align-items: center; flex-wrap: wrap; justify-content: space-between; gap: 12px; }
  .lp-trust-item { display: flex; align-items: center; gap: 8px; font-family: 'Satoshi', sans-serif; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255,255,255,0.5); padding: 6px 0; }
  .lp-trust-dot { width: 5px; height: 5px; background: #D4A931; flex-shrink: 0; }
  .lp-section { padding: 100px 0; }
  .lp-section-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; }
  .lp-section-label { font-family: 'Satoshi', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #D4A931; margin-bottom: 14px; }
  .lp-section-h2 { font-family: 'Fraunces', serif; font-size: clamp(28px, 3.5vw, 44px); font-weight: 700; color: #1A1A1A; line-height: 1.1; margin-bottom: 40px; }
  .lp-section-h2 em { font-style: italic; font-weight: 400; color: #D4A931; }
  .lp-section-h2--light { color: #fff; }
  .lp-two-col { display: grid; grid-template-columns: 1fr 360px; gap: 64px; align-items: start; }
  .lp-prose p { font-family: 'Satoshi', sans-serif; font-size: 16px; color: #3D3D3D; line-height: 1.8; margin-bottom: 20px; }
  .lp-prose p:last-child { margin-bottom: 0; }
  .lp-info-box { background: #1A1A1A; padding: 36px; border: 1px solid #2D2D2D; }
  .lp-info-box-title { font-family: 'Fraunces', serif; font-size: 18px; font-weight: 700; color: #D4A931; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid #2D2D2D; }
  .lp-info-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: 12px 0; border-bottom: 1px solid #2D2D2D; }
  .lp-info-row:last-child { border-bottom: none; padding-bottom: 0; }
  .lp-info-key { font-family: 'Satoshi', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255,255,255,0.4); flex-shrink: 0; }
  .lp-info-val { font-family: 'Satoshi', sans-serif; font-size: 13px; font-weight: 500; color: #fff; text-align: right; }
  .lp-info-val--gold { color: #D4A931; font-weight: 700; }
  .lp-info-val a { color: #D4A931; text-decoration: none; }
  .lp-profile { background: #F5F3EF; border-top: 1px solid #D8D2C8; }
  .lp-profile-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; background: #D8D2C8; margin-top: 40px; }
  .lp-profile-card { background: #F5F3EF; padding: 32px 28px; }
  .lp-profile-card-label { font-family: 'Satoshi', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #D4A931; margin-bottom: 10px; }
  .lp-profile-card-value { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 700; color: #1A1A1A; margin-bottom: 8px; }
  .lp-profile-card-desc { font-family: 'Satoshi', sans-serif; font-size: 13px; color: #4A4A4A; line-height: 1.65; }
  .lp-problems { background: #E8E4DC; border-top: 1px solid #D8D2C8; }
  .lp-problems-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; background: #D8D2C8; margin-top: 40px; }
  .lp-problem-card { background: #E8E4DC; padding: 32px 28px; }
  .lp-problem-card h3 { font-family: 'Fraunces', serif; font-size: 18px; font-weight: 700; color: #1A1A1A; margin-bottom: 12px; }
  .lp-problem-card p { font-family: 'Satoshi', sans-serif; font-size: 14px; color: #4A4A4A; line-height: 1.75; }
  .lp-problem-accent { width: 32px; height: 3px; background: #D4A931; margin-bottom: 16px; }
  .lp-services { background: #1A1A1A; }
  .lp-services-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; background: #2D2D2D; margin-top: 40px; }
  .lp-service-card { background: #1A1A1A; padding: 20px 24px; min-height: 44px; display: flex; align-items: center; gap: 14px; text-decoration: none; transition: background 200ms ease; }
  .lp-service-card:hover { background: #2D2D2D; }
  .lp-service-card:hover .lp-service-arrow { color: #D4A931; }
  .lp-service-card:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }
  .lp-service-num { font-family: 'Fraunces', serif; font-size: 12px; font-weight: 700; color: #D4A931; flex-shrink: 0; min-width: 22px; }
  .lp-service-name { font-family: 'Satoshi', sans-serif; font-size: 14px; font-weight: 600; color: #fff; flex: 1; }
  .lp-service-arrow { color: #2D2D2D; flex-shrink: 0; transition: color 200ms ease; }
  .lp-reviews { background: #F5F3EF; border-top: 1px solid #D8D2C8; }
  .lp-reviews-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 40px; }
  .lp-review-card { background: #fff; padding: 32px; border: 1px solid #D5CFC5; border-left: 3px solid #D4A931; }
  .lp-review-stars { font-size: 14px; color: #D4A931; letter-spacing: 2px; margin-bottom: 14px; }
  .lp-review-quote { font-family: 'Satoshi', sans-serif; font-size: 15px; color: #3D3D3D; line-height: 1.75; margin-bottom: 20px; font-style: normal; }
  .lp-review-author { font-family: 'Satoshi', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #1A1A1A; }
  .lp-review-location { font-family: 'Satoshi', sans-serif; font-size: 11px; color: #8B8070; margin-top: 3px; font-style: normal; }
  .lp-faq { background: #E8E4DC; border-top: 1px solid #D8D2C8; }
  .lp-faq-list { display: flex; flex-direction: column; gap: 2px; background: #D8D2C8; max-width: 840px; margin-top: 40px; }
  .lp-faq-item { background: #E8E4DC; }
  .lp-faq-q { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 24px; background: none; border: none; cursor: pointer; text-align: left; font-family: 'Satoshi', sans-serif; font-size: 15px; font-weight: 700; color: #1A1A1A; line-height: 1.4; transition: background 150ms ease; min-height: 44px; }
  .lp-faq-q:hover { background: #D8D2C8; }
  .lp-faq-q:focus-visible { outline: 2px solid #D4A931; outline-offset: -2px; }
  .lp-faq-q[aria-expanded="true"] { color: #D4A931; }
  .lp-faq-q[aria-expanded="true"] .lp-faq-icon { transform: rotate(45deg); }
  .lp-faq-icon { flex-shrink: 0; transition: transform 250ms ease; }
  .lp-faq-body { padding: 0 24px 20px; font-family: 'Satoshi', sans-serif; font-size: 15px; color: #4A4A4A; line-height: 1.75; }
  .lp-faq-body[hidden] { display: none; }
  .lp-nearby { background: #F5F3EF; border-top: 1px solid #D8D2C8; }
  .lp-nearby-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; background: #D8D2C8; margin-top: 40px; }
  .lp-nearby-card { background: #F5F3EF; padding: 20px 24px; min-height: 44px; display: flex; align-items: center; gap: 12px; text-decoration: none; transition: background 200ms ease; }
  .lp-nearby-card:hover { background: #E8E4DC; }
  .lp-nearby-card:hover .lp-nearby-arrow { color: #D4A931; }
  .lp-nearby-card:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }
  .lp-nearby-name { font-family: 'Satoshi', sans-serif; font-size: 14px; font-weight: 700; color: #1A1A1A; flex: 1; }
  .lp-nearby-sub { font-family: 'Satoshi', sans-serif; font-size: 11px; color: #8B8070; }
  .lp-nearby-arrow { color: #D8D2C8; flex-shrink: 0; transition: color 200ms ease; }
  .lp-back { background: #F5F3EF; padding: 32px 0; border-top: 1px solid #DDD9D0; }
  .lp-back-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; }
  .lp-back-link { font-family: 'Satoshi', sans-serif; font-size: 13px; font-weight: 600; letter-spacing: 0.04em; color: #1A1A1A; text-decoration: none; border-bottom: 1px solid #1A1A1A; padding-bottom: 1px; transition: color 200ms ease, border-color 200ms ease; }
  .lp-back-link:hover { color: #D4A931; border-color: #D4A931; }
  .lp-back-link:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }
  @media (max-width: 1100px) {
    .lp-hero-inner, .lp-trust-inner, .lp-section-inner { padding: 0 40px; }
    .lp-back-inner { padding: 0 40px; }
  }
  @media (max-width: 900px) {
    .lp-section { padding: 72px 0; }
    .lp-two-col { grid-template-columns: 1fr; gap: 40px; }
    .lp-reviews-grid { grid-template-columns: 1fr; gap: 20px; }
    .lp-profile-grid { grid-template-columns: 1fr; }
    .lp-problems-grid { grid-template-columns: 1fr; }
    .lp-nearby-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .lp-hero { padding: 100px 0 60px; }
    .lp-hero-inner, .lp-trust-inner, .lp-section-inner, .lp-back-inner { padding: 0 20px; }
    .lp-section { padding: 56px 0; }
    .lp-hero-actions { flex-direction: column; align-items: flex-start; }
    .lp-btn { width: 100%; justify-content: center; }
    .lp-stats { gap: 24px; }
    .lp-stat-divider { display: none; }
    .lp-trust-inner { gap: 10px; flex-direction: column; align-items: flex-start; }
    .lp-services-grid { grid-template-columns: 1fr; }
    .lp-nearby-grid { grid-template-columns: 1fr; }
  }
  </style>

  <!-- HERO -->
  <section class="lp-hero">
    <div class="lp-hero-inner">
      <nav class="lp-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="lp-breadcrumb-sep" aria-hidden="true">›</span>
        <a href="/service-areas">Service Areas</a>
        <span class="lp-breadcrumb-sep" aria-hidden="true">›</span>
        <span class="lp-breadcrumb-current">{city}</span>
      </nav>
      <div class="lp-hero-label">Local Masonry Experts</div>
      <h1>Tuckpointing in <em>{city}, IL</em></h1>
      <p class="lp-hero-sub">Naperville spans two masonry extremes: antique soft brick downtown near Naper Settlement and engineered veneers in DuPage County suburbs — each needing a completely different mortar formula to survive 90+ annual freeze-thaw cycles. All Masonry Services has handled both ends of that spectrum since 2007.</p>
      <div class="lp-hero-actions">
        <a href="/contact" class="lp-btn lp-btn--primary">Get a Free Estimate</a>
        <a href="tel:+17736562107" class="lp-btn lp-btn--ghost" aria-label="Call 773-656-2107">Call 773-656-2107</a>
      </div>
      <div class="lp-stats">
        <div class="lp-stat-item">
          <span class="lp-stat-value">19+</span>
          <span class="lp-stat-label">Years Experience</span>
        </div>
        <div class="lp-stat-divider"></div>
        <div class="lp-stat-item">
          <span class="lp-stat-value">500+</span>
          <span class="lp-stat-label">Homes Restored</span>
        </div>
        <div class="lp-stat-divider"></div>
        <div class="lp-stat-item">
          <span class="lp-stat-value" aria-label="4.8 star rating">4.8<svg width="14" height="14" viewBox="0 0 24 24" fill="#D4A931" aria-hidden="true" style="vertical-align:middle;margin-left:2px"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg></span>
          <span class="lp-stat-label">92 Google Reviews</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="lp-trust" role="list" aria-label="Trust indicators">
    <div class="lp-trust-inner">
      <div class="lp-trust-item" role="listitem"><span class="lp-trust-dot"></span>Licensed &amp; Insured in Illinois</div>
      <div class="lp-trust-item" role="listitem"><span class="lp-trust-dot"></span>Free On-Site Estimates</div>
      <div class="lp-trust-item" role="listitem"><span class="lp-trust-dot"></span>Mortar Color Matched</div>
      <div class="lp-trust-item" role="listitem"><span class="lp-trust-dot"></span>Family-Owned Since 2007</div>
      <div class="lp-trust-item" role="listitem"><span class="lp-trust-dot"></span>Workers' Comp Covered</div>
    </div>
  </div>

  <!-- WHY NAPERVILLE (main content + sidebar) -->
  <section class="lp-section lp-profile" style="background:#F5F3EF;">
    <div class="lp-section-inner">
      <div class="lp-section-label">Naperville Tuckpointing</div>
      <h2 class="lp-section-h2">Why Naperville Masonry <em>Requires Era-Specific Expertise</em></h2>
      <div class="lp-two-col">
        <div class="lp-prose">
          <p>Naperville's zip codes {zipCodes} split between two masonry extremes: antique soft brick from the 1840s–1880s near Naper Settlement — the most fragile material we work with, destroyed by Portland cement mortar — and 1980s–2000s engineered brick veneers that need flexible mortar systems to handle DuPage County's 90+ annual freeze-thaw cycles. One wrong mortar choice causes irreversible damage in both cases.</p>
          <p>Engineered veneer joint failure is more urgent than it looks: open joints let water into the cavity wall and cause structural damage before any exterior signs appear. We assess every building's era and material before prescribing mortar. Free estimates, written scope, licensed and insured tuckpointing and chimney repair across DuPage County since 2007.</p>
        </div>
        <aside class="lp-info-box" aria-label="Service details">
          <div class="lp-info-box-title">Service Details</div>
          <div class="lp-info-row">
            <span class="lp-info-key">Areas Served</span>
            <span class="lp-info-val">{neighborhoods}</span>
          </div>
          <div class="lp-info-row">
            <span class="lp-info-key">Zip Codes</span>
            <span class="lp-info-val">{zipCodes}</span>
          </div>
          <div class="lp-info-row">
            <span class="lp-info-key">County</span>
            <span class="lp-info-val">{county}</span>
          </div>
