const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Masonry Projects by All Masonry Services Inc — Chicagoland IL",
  "description": "Completed masonry projects across 19 Chicagoland cities including tuckpointing, brick installation, chimney repair, natural stone, and custom home masonry.",
  "url": `${siteUrl}/projects`,
  "numberOfItems": 25,
  "itemListElement": allProjects.map((p, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": p.title,
    "url": `${siteUrl}/projects/${p.slug}`
  }))
}
---

<BaseLayout
  title="Masonry Projects in Chicagoland IL — All Masonry Services Inc"
  description="Browse 25 completed masonry projects across 19 Chicagoland cities. Tuckpointing, brick installation, chimney repair, natural stone & more — all done by our own crew since 2007."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <!-- HERO -->
  <section class="proj-hero">
    <div class="proj-hero-inner">
      <span class="proj-badge">CASE STUDIES</span>
      <h1 class="proj-h1">Real Masonry Projects.<br /><em>Real Chicagoland Homes.</em></h1>
      <p class="proj-sub">Every project below completed by our own crew. No stock photos, no subcontractors — 19+ years of documented work across 19 Chicagoland cities.</p>
      <div class="proj-stats-row">
        <div class="proj-stat">
          <span class="proj-stat-num">25</span>
          <span class="proj-stat-label">Projects</span>
        </div>
        <div class="proj-stat">
          <span class="proj-stat-num">4.8&#9733;</span>
          <span class="proj-stat-label">Google Rating</span>
        </div>
        <div class="proj-stat">
          <span class="proj-stat-num">19+</span>
          <span class="proj-stat-label">Years Experience</span>
        </div>
        <div class="proj-stat">
          <span class="proj-stat-num">19</span>
          <span class="proj-stat-label">Cities Served</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECTS GRID -->
  <section class="proj-grid-section">
    <div class="proj-grid-inner">
      <span class="section-label">ALL PROJECTS</span>
      <h2 class="section-h2">Browse Our Work</h2>
      <div class="proj-grid">
        {allProjects.map(p => (
          <a href={"/projects/" + p.slug} class="proj-card">
            <div class="proj-card-img-wrap">
              <img
                src={imageMap[p.slug]?.imageUrl || '/images/project-brick-restoration.webp'}
                alt={imageMap[p.slug]?.imageAlt || p.title}
                loading="lazy"
                decoding="async"
                width="600"
                height="400"
              />
              <span class="proj-card-year">{p.year}</span>
            </div>
            <div class="proj-card-body">
              <div class="proj-card-tags">
                {p.tags.map(t => <span class="proj-tag">{t}</span>)}
              </div>
              <h3 class="proj-card-title">{p.title}</h3>
              <div class="proj-card-location">
                <span class="proj-loc-dot"></span>
                {p.city}, IL
              </div>
              <div class="proj-card-meta">
                {p.sqft && <span>{p.sqft}</span>}
                <span>{p.duration}</span>
              </div>
              <span class="proj-card-cta">View Case Study</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
  <Footer />
</BaseLayout>

<style>
  /* ── HERO ── */
  .proj-hero {
    background: #1A1A1A;
    padding: 100px 0;
  }

  .proj-hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 80px;
  }

  .proj-badge {
    display: inline-block;
    font-family: 'Satoshi', sans-serif;
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: #D4A931;
    color: #1A1A1A;
    padding: 4px 10px;
    border-radius: 0;
    margin-bottom: 24px;
  }

  .proj-h1 {
    font-family: 'Fraunces', serif;
    font-weight: 900;
    font-size: clamp(36px, 4vw, 52px);
    color: #ffffff;
    line-height: 1.1;
    margin: 0 0 20px 0;
  }

  .proj-h1 em {
    font-style: italic;
    color: #D4A931;
  }

  .proj-sub {
    font-family: 'Satoshi', sans-serif;
    font-weight: 400;
    font-size: 18px;
    color: #C0B9AE;
    max-width: 640px;
    line-height: 1.6;
    margin: 0 0 48px 0;
  }

  .proj-stats-row {
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
  }

  .proj-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .proj-stat-num {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 32px;
    color: #D4A931;
    line-height: 1;
  }

  .proj-stat-label {
    font-family: 'Satoshi', sans-serif;
    font-weight: 400;
    font-size: 13px;
    color: #9A9490;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ── GRID SECTION ── */
  .proj-grid-section {
    background: #F5F3EF;
    padding: 100px 0;
  }

  .proj-grid-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 80px;
  }

  .section-label {
    display: inline-block;
    font-family: 'Satoshi', sans-serif;
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #D4A931;
    margin-bottom: 12px;
  }

  .section-h2 {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: clamp(28px, 3vw, 36px);
    color: #1A1A1A;
    margin: 0 0 48px 0;
    line-height: 1.15;
  }

  .proj-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* ── CARDS ── */
  .proj-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #ffffff;
    border: 1px solid #D8D2C8;
    border-top: 3px solid #D4A931;
    border-radius: 0;
    transition: border 0.2s ease, box-shadow 0.2s ease;
  }

  .proj-card:hover {
    border: 2px solid #D4A931;
    border-top: 2px solid #D4A931;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  }

  .proj-card-img-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 2;
  }

  .proj-card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
    transition: transform 0.3s ease;
  }

  .proj-card:hover .proj-card-img-wrap img {
    transform: scale(1.03);
  }

  .proj-card-year {
    position: absolute;
    top: 12px;
    right: 12px;
    font-family: 'Satoshi', sans-serif;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: #1A1A1A;
    color: #D4A931;
    padding: 3px 8px;
    border-radius: 0;
  }

  .proj-card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .proj-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .proj-tag {
    font-family: 'Satoshi', sans-serif;
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #D4A931;
    border: 1px solid #D4A931;
    padding: 3px 8px;
    border-radius: 0;
    line-height: 1.4;
  }

  .proj-card-title {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 17px;
    color: #1A1A1A;
    line-height: 1.25;
    margin: 0;
  }

  .proj-card-location {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Satoshi', sans-serif;
    font-weight: 400;
    font-size: 13px;
    color: #4A4A4A;
  }

  .proj-loc-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: #D4A931;
    border-radius: 0;
    flex-shrink: 0;
  }

  .proj-card-meta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
