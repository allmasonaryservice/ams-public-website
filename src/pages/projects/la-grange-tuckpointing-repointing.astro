---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaService from '../../components/SchemaService.astro';
import SchemaFAQ from '../../components/SchemaFAQ.astro';
import Footer from '../../components/Footer.astro';

const siteUrl = 'https://allmasonryservices.com';
const pageUrl = siteUrl + '/projects/la-grange-tuckpointing-repointing';

const project = {
  slug: "la-grange-tuckpointing-repointing",
  citySlug: "la-grange",
  serviceSlug: "tuckpointing-repointing",
  city: "La Grange",
  county: "Cook County",
  neighborhood: "La Grange",
  serviceType: "Tuckpointing & Repointing",
  materialUsed: "Type S mortar, color-matched pigment blend, masonry sealant",
  year: "2026",
  sqft: "Varies by wall area",
  costRange: "$1,800–$4,500",
  duration: "2–5 days",
  warranty: "5-year labor warranty",
  title: "Tuckpointing & Repointing in La Grange, IL",
  seoTitle: "Tuckpointing La Grange IL | Masonry Repointing 2026",
  metaDescription: "Professional tuckpointing & repointing in La Grange, IL. Stop water damage before it starts. AMS — 19+ years, 500+ Chicagoland homes. Free estimate today.",
  h1: "La Grange Tuckpointing & Repointing: Stop Water Infiltration in Its Tracks This Season",
  blogTitle1: "Tuckpointing vs. Full Repointing: What La Grange Homeowners Need to Know",
  blogTitle2: "How Often Should La Grange Brick Homes Be Tuckpointed? A Season-by-Season Guide",
  problemHeading: "Crumbling Mortar Joints in La Grange Homes Are a Water Damage Disaster Waiting to Happen",
  problemBody: "La Grange's charming brick bungalows and two-flats were built to last, but mortar joints have a finite lifespan — typically 25–30 years — and many homes in the area are well past that mark. Once mortar begins to erode, every rainstorm and freeze-thaw cycle drives moisture deeper into the wall assembly, soaking insulation, rotting sill plates, and eventually reaching drywall and interior finishes. What starts as a $600 repointing job routinely becomes a $6,000 interior water damage repair when homeowners wait too long.",
  problemConsequences: [
    "Eroded mortar joints allow rainwater to wick into wall cavities, causing hidden mold and insulation failure behind finished walls",
    "Repeated freeze-thaw expansion splits brick faces and loosens entire sections of a wall, creating falling masonry hazards",
    "Unaddressed repointing needs surface clearly on home inspections, stalling La Grange real estate transactions"
  ],
  outcomeHeading: "Watertight Mortar Joints That Protect La Grange Homes for Decades",
  outcomeBody: "AMS tuckpointing crews chisel out deteriorated mortar to the correct depth, vacuum the joint clean, and pack in a color-matched mortar blend formulated for Chicago's climate extremes. The result is a weathertight joint that restores your wall's original water-shedding performance and stops freeze-thaw damage cold — all backed by our labor warranty.",
  processSteps: [
    {
      step: 1,
      title: "Mortar & Brick Condition Assessment",
      detail: "We probe every joint to map deterioration depth, test brick hardness, and select the correct mortar type — never harder than the brick — to prevent future spalling."
    },
    {
      step: 2,
      title: "Precision Joint Removal",
      detail: "Decayed mortar is removed to a minimum 3/4-inch depth using angle grinders and hand chisels, preserving intact brick edges and preventing over-cutting that widens joints."
    },
    {
      step: 3,
      title: "Color-Matched Mortar Application",
      detail: "We mix mortar on-site to match your existing joint color and profile, packing it in multiple lifts and tooling each joint to a tight weathertight finish."
    },
    {
      step: 4,
      title: "Cleanup & Protective Sealant Option",
      detail: "Work areas are cleaned, loose debris removed, and we offer a breathable masonry sealant to extend the life of the fresh mortar and shed water more effectively."
    }
  ],
  faqItems: [
    {
      question: "How do I know if my La Grange home needs tuckpointing or full brick replacement?",
      answer: "If mortar joints are crumbling but brick faces are intact, tuckpointing is the correct repair. If bricks are spalling, cracked through, or hollow-sounding when tapped, some units will need replacement alongside the repointing work."
    },
    {
      question: "Can tuckpointing be done in cold weather?",
      answer: "We work in temperatures down to 40°F with cold-weather mortar admixtures and insulated blankets. Below that threshold, we schedule work for warmer windows to ensure proper mortar curing and a lasting bond."
    },
    {
      question: "How long does tuckpointing last on a La Grange brick home?",
      answer: "Quality tuckpointing with correctly proportioned mortar typically lasts 20–30 years in Chicagoland conditions. Using a mortar that is too hard or too soft is the leading cause of premature joint failure."
    }
  ],
  fomoLine: "Every rain that hits deteriorating mortar in La Grange costs you money — schedule your AMS estimate before the next storm season.",
  tags: ["tuckpointing", "repointing", "la grange", "brick repair", "mortar", "chicagoland"],
};

const heroImage = { desktopUrl: "/images/projects/la-grange-tuckpointing-repointing-desktop.webp", mobileUrl: "/images/projects/la-grange-tuckpointing-repointing-mobile.webp", imageAlt: "Tuckpointing & Repointing project by All Masonry Services in La Grange, IL — Tuckpointing & Repointing in La Grange, IL" };

const breadcrumbSchema = { "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":siteUrl},{"@type":"ListItem","position":2,"name":"Projects","item":siteUrl+"/projects"},{"@type":"ListItem","position":3,"name":project.serviceType,"item":siteUrl+"/services/"+project.serviceSlug},{"@type":"ListItem","position":4,"name":project.city,"item":pageUrl}] };
const ratingSchema = { "@context":"https://schema.org","@type":"LocalBusiness","name":"All Masonry Services","url":siteUrl,"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.8","reviewCount":"92","bestRating":"5"} };

const howToSchema = { "@context": "https://schema.org", "@type": "HowTo", "name": "How We Completed This Masonry Project", "description": project.outcomeHeading, "step": project.processSteps.map((s, i) => ({ "@type": "HowToStep", "position": i + 1, "name": s.title, "text": s.detail })) };
---

<BaseLayout title={project.seoTitle} description={project.metaDescription} canonical={pageUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(ratingSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <SchemaService name={project.serviceType + " in " + project.city + ", IL"} description={project.metaDescription} url={pageUrl} provider="All Masonry Services" providerUrl={siteUrl} areaServed={project.city + ", IL"} serviceType={project.serviceType} />
  <SchemaFAQ items={project.faqItems} />

  <!-- BREADCRUMB -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="breadcrumb-inner">
      <a href="/">Home</a><span>/</span><a href="/projects">Projects</a><span>/</span><a href={"/services/"+project.serviceSlug}>{project.serviceType}</a><span>/</span><span>{project.city}</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="pp-hero">
    <div class="pp-hero-inner">
      <div class="pp-tags">{project.tags.map(t => <span class="pp-tag">{t}</span>)}</div>
      <h1 class="pp-h1">{project.h1}</h1>
      <p class="pp-hero-meta">Completed 2026 &nbsp;·&nbsp; {project.city}, {project.county}</p>
    </div>
    <div class="pp-hero-img">
      <picture>
        <source media="(max-width:600px)" srcset={heroImage.mobileUrl} type="image/webp" />
        <img src={heroImage.desktopUrl} alt={heroImage.imageAlt} width="750" height="422" loading="eager" fetchpriority="high" decoding="async" />
      </picture>
    </div>
  </section>

  <!-- STATS BAR -->
  <section class="pp-stats-bar">
    <div class="pp-stats-inner">
      <div class="pp-stat"><span class="pp-stat-val">{project.sqft}</span><span class="pp-stat-lbl">Project Area</span></div>
      <div class="pp-stat"><span class="pp-stat-val">{project.duration}</span><span class="pp-stat-lbl">Duration</span></div>
      <div class="pp-stat"><span class="pp-stat-val">{project.serviceType}</span><span class="pp-stat-lbl">Service Type</span></div>
      <div class="pp-stat"><span class="pp-stat-val">{project.year}</span><span class="pp-stat-lbl">Year Completed</span></div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="pp-problem">
    <div class="pp-problem-inner">
      <div class="pp-problem-left">
        <h2>{project.problemHeading}</h2>
        <p>{project.problemBody}</p>
      </div>
      <div class="pp-callout">
        <p class="pp-callout-header">If left untreated:</p>
        <ul>{project.problemConsequences.map(c => <li>{c}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="pp-process">
    <div class="pp-process-inner">
      <h2>How We Fixed It</h2>
      <div class="pp-steps">
        {project.processSteps.map(s => (
          <div class="pp-step">
            <span class="pp-step-num">0{s.step}</span>
            <h3>{s.title}</h3>
            <p>{s.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OUTCOME + DETAILS -->
  <section class="pp-outcome">
    <div class="pp-outcome-inner">
      <div class="pp-outcome-left">
        <h2>{project.outcomeHeading}</h2>
        <p>{project.outcomeBody}</p>
      </div>
      <div class="pp-details-card">
        <div class="pp-detail-row"><span class="pp-detail-label">Location</span><span>{project.city}, IL — {project.neighborhood}</span></div>
        <div class="pp-detail-row"><span class="pp-detail-label">Materials</span><span>{project.materialUsed}</span></div>
        <div class="pp-detail-row"><span class="pp-detail-label">Cost Range</span><span>{project.costRange}</span></div>
        <div class="pp-detail-row"><span class="pp-detail-label">Warranty</span><span>{project.warranty}</span></div>
        <div class="pp-detail-row"><span class="pp-detail-label">Completed</span><span>{project.year}</span></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="pp-faq">
    <div class="pp-faq-inner">
      <h2>Questions About This Project</h2>
      <div class="pp-faq-list">
        {project.faqItems.map(f => (
          <details class="pp-faq-item">
            <summary class="pp-faq-q">{f.question}</summary>
            <p class="pp-faq-a">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pp-cta">
    <div class="pp-cta-inner">
      <h2>Need Similar Work in {project.city}?</h2>
      <p>{project.fomoLine}</p>
      <div class="pp-cta-actions">
        <a href="/contact#form" class="pp-cta-btn">Request Free Estimate</a>
        <a href="tel:7736562107" class="pp-phone-btn" aria-label="Call All Masonry Services at 773-656-2107">773-656-2107</a>
      </div>
    </div>
  </section>

  <!-- NEARBY PROJECTS -->
  <section class="pp-nearby">
    <div class="pp-nearby-inner">
      <h2>Other Projects Near {project.city}</h2>
      <div class="pp-nearby-grid">
        <a href="/projects/western-springs-damaged-brick-replacement" class="pp-mini-card">
          <img src="/images/projects/western-springs-damaged-brick-replacement-desktop.webp" alt="Damaged Brick Replacement project in Western Springs, IL" width="600" height="400" loading="lazy" decoding="async" />
          <div class="pp-mini-card-body">
            <div class="pp-mini-tags"><span class="pp-mini-tag">Brick Replacement</span><span class="pp-mini-tag">Western Springs</span></div>
            <p class="pp-mini-title">Damaged Brick Replacement in Western Springs, IL</p>
            <p class="pp-mini-city">Western Springs, IL</p>
            <span class="pp-mini-cta">View Case Study</span>
          </div>
        </a>
        <a href="/projects/clarendon-hills-brick-stone-veneers" class="pp-mini-card">
          <img src="/images/projects/clarendon-hills-brick-stone-veneers-desktop.webp" alt="Brick & Stone Veneers project in Clarendon Hills, IL" width="600" height="400" loading="lazy" decoding="async" />
          <div class="pp-mini-card-body">
            <div class="pp-mini-tags"><span class="pp-mini-tag">Stone Veneers</span><span class="pp-mini-tag">Clarendon Hills</span></div>
            <p class="pp-mini-title">Brick &amp; Stone Veneers in Clarendon Hills, IL</p>
            <p class="pp-mini-city">Clarendon Hills, IL</p>
            <span class="pp-mini-cta">View Case Study</span>
          </div>
        </a>
        <a href="/projects/burr-ridge-chimney-repair-rebuilding" class="pp-mini-card">
          <img src="/images/projects/burr-ridge-chimney-repair-rebuilding-desktop.webp" alt="Chimney Repair & Rebuilding project in Burr Ridge, IL" width="600" height="400" loading="lazy" decoding="async" />
          <div class="pp-mini-card-body">
            <div class="pp-mini-tags"><span class="pp-mini-tag">Chimney Repair</span><span class="pp-mini-tag">Burr Ridge</span></div>
            <p class="pp-mini-title">Chimney Repair &amp; Rebuilding in Burr Ridge, IL</p>
            <p class="pp-mini-city">Burr Ridge, IL</p>
            <span class="pp-mini-cta">View Case Study</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- RELATED PROJECTS -->
  <section class="pp-related">
    <div class="pp-related-inner">
      <h2>More {project.serviceType} Projects</h2>
      <div class="pp-related-grid">
        <a href="/projects/chicago-tuckpointing-repointing" class="pp-mini-card">
          <img src="/images/projects/chicago-tuckpointing-repointing-desktop.webp" alt="Tuckpointing & Repointing project in Chicago, IL" width="600" height="400" loading="lazy" decoding="async" />
          <div class="pp-mini-card-body">
            <div class="pp-mini-tags"><span class="pp-mini-tag">Tuckpointing</span><span class="pp-mini-tag">Chicago</span></div>
            <p class="pp-mini-title">Chicago Tuckpointing &amp; Repointing</p>
            <p class="pp-mini-city">Chicago, IL</p>
            <span class="pp-mini-cta">View Case Study</span>
          </div>
        </a>
        <a href="/projects/elmhurst-tuckpointing-repointing" class="pp-mini-card">
          <img src="/images/projects/elmhurst-tuckpointing-repointing-desktop.webp" alt="Tuckpointing & Repointing project in Elmhurst, IL" width="600" height="400" loading="lazy" decoding="async" />
          <div class="pp-mini-card-body">
            <div class="pp-mini-tags"><span class="pp-mini-tag">Tuckpointing</span><span class="pp-mini-tag">Elmhurst</span></div>
            <p class="pp-mini-title">Elmhurst Tuckpointing &amp; Repointing</p>
            <p class="pp-mini-city">Elmhurst, IL</p>
            <span class="pp-mini-cta">View Case Study</span>
          </div>
        </a>
        <a href="/projects/winnetka-tuckpointing-repointing" class="pp-mini-card">
          <img src="/images/projects/winnetka-tuckpointing-repointing-desktop.webp" alt="Tuckpointing & Repointing project in Winnetka, IL" width="600" height="400" loading="lazy" decoding="async" />
          <div class="pp-mini-card-body">
            <div class="pp-mini-tags"><span class="pp-mini-tag">Tuckpointing</span><span class="pp-mini-tag">Winnetka</span></div>
            <p class="pp-mini-title">Tuckpointing &amp; Repointing in Winnetka, IL</p>
            <p class="pp-mini-city">Winnetka, IL</p>
            <span class="pp-mini-cta">View Case Study</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="pp-blog">
    <div class="pp-blog-inner">
      <h2>More on {project.serviceType} in Chicagoland</h2>
      <div class="pp-blog-grid">
        <a href="/blog" class="pp-blog-card"><h3>{project.blogTitle1}</h3><span class="pp-read-more">Read Article</span></a>
        <a href="/blog" class="pp-blog-card"><h3>{project.blogTitle2}</h3><span class="pp-read-more">Read Article</span></a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
/* ALL border-radius: 0px — NO EXCEPTIONS */
* { box-sizing: border-box; }

.breadcrumb { background: #1A1A1A; padding: 12px 0; }
.breadcrumb-inner { max-width:1280px; margin:0 auto; padding:0 80px; display:flex; gap:8px; align-items:center; font-family:'Satoshi',sans-serif; font-size:12px; }
.breadcrumb-inner a { color:#D4A931; text-decoration:none; }
.breadcrumb-inner span { color:#8B8070; }

.pp-hero { background:#F5F3EF; padding-top:60px; }
.pp-hero-inner { max-width:1280px; margin:0 auto; padding:0 80px 40px; }
.pp-tags { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px; }
.pp-tag { font-family:'Satoshi',sans-serif; font-size:10px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; color:#D4A931; border:1px solid #D4A931; padding:3px 8px; }
.pp-h1 { font-family:'Fraunces',serif; font-size:clamp(28px,3.5vw,44px); font-weight:900; color:#1A1A1A; line-height:1.15; margin:0 0 16px; }
.pp-hero-meta { font-family:'Satoshi',sans-serif; font-size:13px; color:#8B8070; }
.pp-hero-img img { width:100%; height:auto; display:block; border-top:3px solid #D4A931; }

.pp-stats-bar { background:#1A1A1A; padding:32px 0; }
.pp-stats-inner { max-width:1280px; margin:0 auto; padding:0 80px; display:grid; grid-template-columns:repeat(4,1fr); gap:0; }
.pp-stat { text-align:center; padding:0 20px; border-right:1px solid #2D2D2D; }
.pp-stat:last-child { border-right:none; }
.pp-stat-val { display:block; font-family:'Fraunces',serif; font-size:clamp(16px,2vw,22px); font-weight:700; color:#D4A931; }
.pp-stat-lbl { display:block; font-family:'Satoshi',sans-serif; font-size:10px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#8B8070; margin-top:4px; }

.pp-problem { background:#F5F3EF; padding:100px 0; }
.pp-problem-inner { max-width:1280px; margin:0 auto; padding:0 80px; display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:start; }
.pp-problem-left h2 { font-family:'Fraunces',serif; font-size:clamp(24px,2.5vw,32px); font-weight:700; color:#1A1A1A; margin:0 0 20px; }
.pp-problem-left p { font-family:'Satoshi',sans-serif; font-size:16px; color:#4A4A4A; line-height:1.75; margin:0; }
.pp-callout { background:#fff; border-left:3px solid #D4A931; border:1px solid #D8D2C8; border-left:3px solid #D4A931; padding:24px; }
.pp-callout-header { font-family:'Satoshi',sans-serif; font-size:11px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#D4A931; margin:0 0 12px; }
.pp-callout ul { margin:0; padding:0 0 0 16px; }
.pp-callout li { font-family:'Satoshi',sans-serif; font-size:14px; color:#4A4A4A; line-height:1.7; margin-bottom:8px; }

.pp-process { background:#E8E4DC; padding:100px 0; }
.pp-process-inner { max-width:1280px; margin:0 auto; padding:0 80px; }
.pp-process h2 { font-family:'Fraunces',serif; font-size:clamp(24px,2.5vw,32px); font-weight:700; color:#1A1A1A; margin:0 0 48px; }
.pp-steps { display:grid; grid-template-columns:repeat(2,1fr); gap:32px; }
.pp-step { background:#fff; border:1px solid #D8D2C8; border-top:3px solid #D4A931; padding:28px; }
.pp-step-num { font-family:'Fraunces',serif; font-size:32px; font-weight:900; color:#D4A931; display:block; margin-bottom:12px; }
.pp-step h3 { font-family:'Satoshi',sans-serif; font-size:13px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; color:#1A1A1A; margin:0 0 10px; }
.pp-step p { font-family:'Satoshi',sans-serif; font-size:14px; color:#4A4A4A; line-height:1.7; margin:0; }

.pp-outcome { background:#F5F3EF; padding:100px 0; }
.pp-outcome-inner { max-width:1280px; margin:0 auto; padding:0 80px; display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:start; }
.pp-outcome-left h2 { font-family:'Fraunces',serif; font-size:clamp(24px,2.5vw,32px); font-weight:700; color:#1A1A1A; margin:0 0 20px; }
.pp-outcome-left p { font-family:'Satoshi',sans-serif; font-size:16px; color:#4A4A4A; line-height:1.75; margin:0; }
.pp-details-card { background:#fff; border:1px solid #D8D2C8; border-top:3px solid #D4A931; padding:28px; }
.pp-detail-row { display:flex; justify-content:space-between; padding:12px 0; border-bottom:1px solid #D8D2C8; font-family:'Satoshi',sans-serif; font-size:13px; }
.pp-detail-row:last-child { border-bottom:none; }
.pp-detail-label { font-weight:700; color:#1A1A1A; text-transform:uppercase; font-size:10px; letter-spacing:0.06em; }

.pp-faq { background:#E8E4DC; padding:100px 0; }
.pp-faq-inner { max-width:800px; margin:0 auto; padding:0 80px; }
.pp-faq h2 { font-family:'Fraunces',serif; font-size:clamp(24px,2.5vw,32px); font-weight:700; color:#1A1A1A; margin:0 0 40px; }
.pp-faq-item { border:1px solid #D8D2C8; background:#fff; margin-bottom:8px; }
.pp-faq-item[open] { border-color:#D4A931; }
.pp-faq-q { font-family:'Satoshi',sans-serif; font-size:15px; font-weight:700; color:#1A1A1A; padding:20px 24px; cursor:pointer; list-style:none; }
.pp-faq-q::-webkit-details-marker { display:none; }
.pp-faq-a { font-family:'Satoshi',sans-serif; font-size:14px; color:#4A4A4A; line-height:1.75; padding:0 24px 20px; margin:0; }

.pp-cta { background:#1A1A1A; padding:100px 0; text-align:center; }
.pp-cta-inner { max-width:800px; margin:0 auto; padding:0 80px; }
.pp-cta h2 { font-family:'Fraunces',serif; font-size:clamp(28px,3vw,40px); font-weight:700; color:#fff; margin:0 0 16px; }
.pp-cta p { font-family:'Satoshi',sans-serif; font-size:16px; color:#8B8070; margin:0 0 32px; }
.pp-cta-actions { display:flex; gap:16px; justify-content:center; flex-wrap:wrap; }
.pp-cta-btn { display:inline-flex; align-items:center; height:52px; padding:0 28px; background:#D4A931; color:#1A1A1A; font-family:'Satoshi',sans-serif; font-size:13px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; text-decoration:none; border:2px solid #D4A931; }
.pp-cta-btn:hover { background:#B8932A; border-color:#B8932A; }
.pp-phone-btn { display:inline-flex; align-items:center; height:52px; padding:0 28px; background:transparent; color:#D4A931; font-family:'Satoshi',sans-serif; font-size:13px; font-weight:700; letter-spacing:0.06em; text-decoration:none; border:2px solid #D4A931; }
.pp-phone-btn:hover { background:#D4A931; color:#1A1A1A; }

.pp-nearby,.pp-related { background:#F5F3EF; padding:100px 0; }
.pp-related { background:#E8E4DC; }
.pp-nearby-inner,.pp-related-inner { max-width:1280px; margin:0 auto; padding:0 80px; }
.pp-nearby h2,.pp-related h2 { font-family:'Fraunces',serif; font-size:clamp(24px,2.5vw,32px); font-weight:700; color:#1A1A1A; margin:0 0 40px; }
