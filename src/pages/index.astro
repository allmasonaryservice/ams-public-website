---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSequence from '../components/HeroSequence.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import ServicesSection from '../components/ServicesSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ToolSectionMortar from '../components/ToolSectionMortar.astro';
import FreeToolsStrip from '../components/FreeToolsStrip.astro';
import RecentProjectsSection from '../components/RecentProjectsSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import ServiceAreasSection from '../components/ServiceAreasSection.astro';
import FAQSection from '../components/FAQSection.astro';
import CTABanner from '../components/CTABanner.astro';
