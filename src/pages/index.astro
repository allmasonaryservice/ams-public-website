>
  <HeroSequence />
  <WhyChooseUs />
  <ServicesSection />
  <AboutSection />
  <RecentProjectsSection />
  <ToolSectionMortar />
  <FreeToolsStrip />
  <TestimonialsSection />
  <ServiceAreasSection />
  <FAQSection />
  <CTABanner />
