---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import Footer from '../components/Footer.astro';

const siteUrl = 'https://allmasonryservices.com';
const pageUrl = `${siteUrl}/service-areas`;

const areas = [
  { name: "Hinsdale",        slug: "hinsdale",        region: "western",    lat: 41.8006, lng: -87.9284, county: "DuPage County" },
  { name: "Western Springs", slug: "western-springs", region: "western",    lat: 41.8089, lng: -87.9006, county: "Cook County"   },
  { name: "Elmhurst",        slug: "elmhurst",        region: "western",    lat: 41.8995, lng: -87.9401, county: "DuPage County" },
  { name: "Oak Brook",       slug: "oak-brook",       region: "western",    lat: 41.8320, lng: -87.9284, county: "DuPage County" },
  { name: "Burr Ridge",      slug: "burr-ridge",      region: "western",    lat: 41.7517, lng: -87.9195, county: "DuPage County" },
  { name: "Clarendon Hills", slug: "clarendon-hills", region: "western",    lat: 41.7978, lng: -87.9573, county: "DuPage County" },
  { name: "La Grange",       slug: "la-grange",       region: "western",    lat: 41.8056, lng: -87.8695, county: "Cook County"   },
  { name: "Willowbrook",     slug: "willowbrook",     region: "western",    lat: 41.7706, lng: -87.9401, county: "DuPage County" },
  { name: "Winnetka",        slug: "winnetka",        region: "northshore", lat: 42.1075, lng: -87.7359, county: "Cook County"   },
  { name: "Kenilworth",      slug: "kenilworth",      region: "northshore", lat: 42.0867, lng: -87.7159, county: "Cook County"   },
  { name: "Wilmette",        slug: "wilmette",        region: "northshore", lat: 42.0725, lng: -87.7273, county: "Cook County"   },
  { name: "Glencoe",         slug: "glencoe",         region: "northshore", lat: 42.1353, lng: -87.7584, county: "Cook County"   },
  { name: "Highland Park",   slug: "highland-park",   region: "northshore", lat: 42.1817, lng: -87.8003, county: "Lake County"   },
  { name: "Evanston",        slug: "evanston",        region: "northshore", lat: 42.0450, lng: -87.6877, county: "Cook County"   },
  { name: "Northbrook",      slug: "northbrook",      region: "northshore", lat: 42.1253, lng: -87.8270, county: "Cook County"   },
  { name: "Naperville",      slug: "naperville",      region: "dupage",     lat: 41.7508, lng: -88.1535, county: "DuPage County" },
  { name: "Wheaton",         slug: "wheaton",         region: "dupage",     lat: 41.8661, lng: -88.1070, county: "DuPage County" },
  { name: "Downers Grove",   slug: "downers-grove",   region: "dupage",     lat: 41.8081, lng: -88.0117, county: "DuPage County" },
  { name: "Chicago",         slug: "chicago",         region: "chicago",    lat: 41.8781, lng: -87.6298, county: "Cook County"   },
];

const regions = [
  { key: "western",    title: "Western Suburbs", tagline: "Tuckpointing & brick repair for colonial estates and historic brick homes — our core market since 2007.",          icon: "W", count: 8 },
  { key: "northshore", title: "North Shore",     tagline: "Chimney restoration, limestone work, and tuckpointing for premium lakefront estates and century-old stonework.",  icon: "N", count: 6 },
  { key: "dupage",     title: "DuPage Corridor", tagline: "Full masonry services in Naperville, Wheaton, and Downers Grove — brick repair, repointing, and stone work.",    icon: "D", count: 3 },
  { key: "chicago",    title: "Chicago",          tagline: "Tuckpointing and brick repair for greystones, two-flats, courtyard buildings, and commercial masonry blocks.",   icon: "C", count: 1 },
];

const services = [
  { name: "Tuckpointing & Repointing",   href: "/services/tuckpointing-repointing"  },
  { name: "Brick Installation",          href: "/services/brick-installation"        },
  { name: "Damaged Brick Replacement",   href: "/services/damaged-brick-replacement" },
  { name: "Chimney Repair & Rebuilding", href: "/services/chimney-repair-rebuilding" },
  { name: "Natural Stone & Limestone",   href: "/services/natural-stone-limestone"   },
  { name: "CMU Block Installation",      href: "/services/cmu-block-installation"    },
  { name: "Brick & Stone Veneers",       href: "/services/brick-stone-veneers"       },
  { name: "Custom Home Masonry",         href: "/services/custom-home-masonry"       },
  { name: "Commercial Masonry",          href: "/services/commercial-brick-stone"    },
  { name: "Chimney & Fireplace",         href: "/services/chimney-fireplace"         },
  { name: "Commercial Masonry Veneers",  href: "/services/commercial-masonry-veneers"},
];

const faqs = [
  { q: "How much does tuckpointing cost in Chicagoland?",                             a: "Tuckpointing in Chicagoland typically runs $8–$25 per linear foot — most single-family homes in Hinsdale, Winnetka, or Naperville fall between $800 and $3,500 for a full repoint. AMS provides free on-site estimates so you get an exact price before any work begins." },
  { q: "What masonry services do you offer across Chicagoland?",                      a: "We offer tuckpointing & repointing, brick installation, damaged brick replacement, chimney repair & rebuilding, natural stone & limestone work, CMU block installation, brick & stone veneers, custom home masonry, commercial masonry, chimney & fireplace restoration, and commercial masonry veneers — all available across all 19 service communities." },
  { q: "How do I know if my brick or mortar needs repair?",                           a: "Look for crumbling mortar joints, white staining (efflorescence), cracks along mortar lines, spalling brick, or water leaking through walls after rain. Chicagoland's freeze-thaw winters accelerate mortar decay — call 773-656-2107 for a free assessment." },
  { q: "Do you charge for travel to my area?",                                        a: "No. We provide free on-site estimates across all 19 communities — no travel fee, no obligation." },
  { q: "Do you serve areas not on this list?",                                        a: "We focus on the 19 communities listed, but may be able to accommodate nearby locations. Call us at 773-656-2107 to ask." },
  { q: "Are you licensed and insured in Illinois?",                                   a: "Yes. All Masonry Services is fully licensed and insured in the State of Illinois for all masonry work, including residential and commercial projects." },
  { q: "Do you handle both residential and commercial masonry across these areas?",   a: "Absolutely. We serve homeowners, property managers, and commercial clients throughout Chicagoland with tuckpointing, brick repair, chimney work, and stone restoration. Commercial assessments are also free." },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "All Masonry Services",
  "url": siteUrl,
  "telephone": "+17736562107",
  "email": "info@allmasonryservices.com",
  "foundingDate": "2007",
  "priceRange": "$$",
  "image": `${siteUrl}/og-image.jpg`,
  "description": "Licensed masonry contractor serving 19 Chicagoland communities since 2007.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Chicago",
    "addressRegion": "IL",
    "addressCountry": "US"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 41.8781, "longitude": -87.6298 },
  "areaServed": areas.map(a => ({ "@type": "City", "name": a.name, "addressRegion": "IL" })),
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.8", "reviewCount": "92", "bestRating": "5" },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "07:00", "closes": "18:00" }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": pageUrl }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const areasJson = JSON.stringify(areas.map(a => ({ name: a.name, slug: a.slug, lat: a.lat, lng: a.lng })));
---

<BaseLayout
  title="Chicagoland Masonry Service Areas — All 19 Communities | All Masonry Services"
  description="All Masonry Services covers 19 Chicagoland communities — Hinsdale, Winnetka, Naperville, Chicago and more. Free estimates, licensed & insured since 2007."
  canonical={pageUrl}
  ogImage="/og-image.jpg"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* ── HERO ── */
  .sa-hero { background: #1A1A1A; border-bottom: 1px solid #2D2D2D; }
  .sa-hero-inner { max-width: 1280px; margin: 0 auto; padding: 120px 80px 80px; }
  .sa-breadcrumb {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    font-family: 'Satoshi', sans-serif; font-size: 12px; font-weight: 500;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: rgba(255,255,255,0.35); margin-bottom: 28px;
  }
  .sa-breadcrumb a { color: rgba(255,255,255,0.35); text-decoration: none; transition: color 200ms ease; }
  .sa-breadcrumb a:hover { color: #D4A931; }
  .sa-breadcrumb a:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }
  .sa-breadcrumb-sep { color: rgba(255,255,255,0.2); }
  .sa-breadcrumb-current { color: #D4A931; }
  .sa-hero-label {
    display: inline-block; font-family: 'Satoshi', sans-serif; font-size: 10px;
    font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: #1A1A1A; background: #D4A931; padding: 4px 12px; margin-bottom: 20px;
  }
  .sa-hero h1 {
    font-family: 'Fraunces', serif; font-size: clamp(40px, 5.5vw, 72px);
    font-weight: 700; color: #fff; line-height: 1.05; margin-bottom: 20px;
  }
  .sa-hero h1 em { font-style: italic; font-weight: 400; color: #D4A931; }
  .sa-hero-sub {
    font-family: 'Satoshi', sans-serif; font-size: 17px; color: rgba(255,255,255,0.6);
    line-height: 1.75; max-width: 600px; margin-bottom: 36px;
  }
  .sa-hero-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 52px; }
  .sa-btn {
    display: inline-flex; align-items: center; font-family: 'Satoshi', sans-serif;
    font-weight: 700; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase;
    text-decoration: none; padding: 13px 28px; min-height: 44px;
    border: 2px solid transparent; transition: background 200ms ease, border-color 200ms ease, color 200ms ease;
    white-space: nowrap;
  }
  .sa-btn--primary { background: #D4A931; color: #1A1A1A; border-color: #D4A931; }
  .sa-btn--primary:hover { background: #B8932A; border-color: #B8932A; }
  .sa-btn--ghost { background: transparent; color: #D4A931; border-color: #D4A931; }
  .sa-btn--ghost:hover { background: #D4A931; color: #1A1A1A; }
  .sa-btn:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }
  .sa-hero-stats { display: flex; align-items: center; gap: 40px; flex-wrap: wrap; }
  .sa-stat { display: flex; flex-direction: column; gap: 3px; }
  .sa-stat-value { font-family: 'Fraunces', serif; font-size: 28px; font-weight: 700; color: #D4A931; line-height: 1; }
  .sa-stat-label { font-family: 'Satoshi', sans-serif; font-size: 10px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.35); }
  .sa-stat-divider { width: 1px; height: 36px; background: #2D2D2D; }
  .sa-hero-trust { background: #111; border-top: 1px solid #2D2D2D; }
  .sa-hero-trust-inner {
    max-width: 1280px; margin: 0 auto; padding: 18px 80px;
    display: flex; align-items: center; flex-wrap: wrap; gap: 20px; justify-content: space-between;
  }
  .sa-trust-item {
    display: flex; align-items: center; gap: 8px; font-family: 'Satoshi', sans-serif;
    font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    color: rgba(255,255,255,0.45);
  }
  .sa-trust-dot { width: 5px; height: 5px; background: #D4A931; flex-shrink: 0; }

  /* ── MAP ── */
  .samap { background: #E8E4DC; padding: 100px 0; border-top: 1px solid #D8D2C8; }
  .samap-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; }
  .samap-header { margin-bottom: 56px; }
  .samap-label {
    display: inline-block; font-family: 'Satoshi', sans-serif; font-size: 11px;
    font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: #D4A931; margin-bottom: 16px;
  }
  .samap-header h2 {
    font-family: 'Fraunces', serif; font-size: clamp(30px, 3.5vw, 44px);
    font-weight: 700; color: #1A1A1A; line-height: 1.15; margin-bottom: 14px;
  }
  .samap-header h2 em { font-style: italic; font-weight: 400; color: #D4A931; }
  .samap-sub { font-family: 'Satoshi', sans-serif; font-size: 16px; color: #4A4A4A; line-height: 1.75; max-width: 540px; }
  .samap-layout { display: grid; grid-template-columns: 1fr 300px; gap: 40px; align-items: start; }
  .samap-map-wrap { position: relative; }
  #sapage-map { width: 100%; height: 520px; border: 2px solid #1A1A1A; background: #2D2D2D; }
  .samap-sidebar { position: sticky; top: 120px; }
  .samap-sidebar-label {
    font-family: 'Satoshi', sans-serif; font-size: 10px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: #D4A931;
    margin: 0 0 12px; border-bottom: 1px solid #D8D2C8; padding-bottom: 10px;
  }
  .samap-list {
    list-style: none; margin: 0 0 20px; padding: 0;
    max-height: 420px; overflow-y: auto;
    scrollbar-width: thin; scrollbar-color: #D4A931 #E8E4DC;
  }
  .samap-list::-webkit-scrollbar { width: 3px; }
  .samap-list::-webkit-scrollbar-thumb { background: #D4A931; }
  .samap-item { display: flex; align-items: center; gap: 8px; padding: 0; border-bottom: 1px solid #D8D2C8; }
  .samap-item:last-child { border-bottom: none; }
  .samap-dot { width: 6px; height: 6px; background: #D4A931; flex-shrink: 0; }
  .samap-city-link {
    display: flex; align-items: center; min-height: 44px; flex: 1;
    font-family: 'Satoshi', sans-serif; font-size: 13px; color: #1A1A1A;
    text-decoration: none; transition: color 200ms ease; line-height: 1;
  }
  .samap-city-link:hover { color: #D4A931; }
  .samap-city-link:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }
  .samap-cta {
    display: flex; align-items: center; justify-content: center;
    min-height: 44px; font-family: 'Satoshi', sans-serif; font-size: 11px; font-weight: 700;
    letter-spacing: 0.05em; text-transform: uppercase; color: #1A1A1A;
    background: #D4A931; border: 2px solid #D4A931; padding: 10px 14px;
    text-decoration: none; text-align: center; transition: background 200ms ease;
  }
  .samap-cta:hover { background: #B8932A; border-color: #B8932A; }
  .samap-cta:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }

  /* ── REGIONS ── */
  .sa-regions { background: #F5F3EF; padding: 100px 0; border-top: 1px solid #D8D2C8; }
  .sa-regions-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; }
  .sa-regions-header { margin-bottom: 56px; }
  .sa-regions-label {
    display: inline-block; font-family: 'Satoshi', sans-serif; font-size: 11px;
    font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: #D4A931; margin-bottom: 16px;
  }
  .sa-regions-header h2 {
    font-family: 'Fraunces', serif; font-size: clamp(30px, 3.5vw, 44px);
    font-weight: 700; color: #1A1A1A; line-height: 1.15; margin-bottom: 14px;
  }
  .sa-regions-header h2 em { font-style: italic; font-weight: 400; color: #D4A931; }
  .sa-regions-sub { font-family: 'Satoshi', sans-serif; font-size: 16px; color: #4A4A4A; line-height: 1.75; max-width: 540px; }
  .sa-regions-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; background: #D8D2C8; }
  .sa-region-card { background: #F5F3EF; padding: 36px 28px; display: flex; flex-direction: column; gap: 12px; }
  .sa-region-icon {
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; background: #1A1A1A; color: #D4A931;
    font-family: 'Fraunces', serif; font-size: 20px; font-weight: 700; flex-shrink: 0;
  }
  .sa-region-title { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 700; color: #1A1A1A; line-height: 1.2; }
  .sa-region-tagline { font-family: 'Satoshi', sans-serif; font-size: 14px; color: #4A4A4A; line-height: 1.6; }
  .sa-region-count {
    font-family: 'Satoshi', sans-serif; font-size: 11px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; color: #D4A931;
    padding-top: 4px; border-top: 1px solid #D8D2C8;
  }
  .sa-region-cities { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 2px; }
  .sa-region-cities li a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 4px 0;
    font-family: 'Satoshi', sans-serif; font-size: 13px; color: #D4A931;
    text-decoration: underline; text-underline-offset: 3px;
    text-decoration-color: rgba(212,169,49,0.4); transition: text-decoration-color 200ms ease;
  }
  .sa-region-cities li a:hover { text-decoration-color: #D4A931; }
  .sa-region-cities li a:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }

  /* ── CITIES GRID ── */
  .sa-cities { background: #E8E4DC; padding: 100px 0; border-top: 1px solid #D8D2C8; }
  .sa-cities-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; }
  .sa-cities-header { margin-bottom: 56px; }
  .sa-cities-label {
    display: inline-block; font-family: 'Satoshi', sans-serif; font-size: 11px;
    font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: #D4A931; margin-bottom: 16px;
  }
  .sa-cities-header h2 {
    font-family: 'Fraunces', serif; font-size: clamp(30px, 3.5vw, 44px);
    font-weight: 700; color: #1A1A1A; line-height: 1.15; margin-bottom: 14px;
  }
  .sa-cities-header h2 em { font-style: italic; font-weight: 400; color: #D4A931; }
  .sa-cities-sub { font-family: 'Satoshi', sans-serif; font-size: 16px; color: #4A4A4A; line-height: 1.75; max-width: 540px; }
  .sa-cities-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; background: #D8D2C8; }
  .sa-city-card {
    background: #E8E4DC; padding: 20px; min-height: 44px; display: flex; align-items: center;
    gap: 12px; text-decoration: none; transition: background 200ms ease;
  }
  .sa-city-card:hover { background: #D8D2C8; }
  .sa-city-card:hover .sa-city-arrow { color: #D4A931; }
  .sa-city-card:focus-visible { outline: 2px solid #D4A931; outline-offset: 2px; }
  .sa-city-name { font-family: 'Satoshi', sans-serif; font-size: 15px; font-weight: 700; color: #1A1A1A; flex: 1; }
  .sa-city-county { font-family: 'Satoshi', sans-serif; font-size: 11px; color: #6A6A6A; font-weight: 500; }
  .sa-city-arrow { color: #D8D2C8; flex-shrink: 0; transition: color 200ms ease; }

  /* ── WHY AMS ── */
  .sa-why { background: #1A1A1A; padding: 100px 0; }
  .sa-why-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; }
  .sa-why-header { margin-bottom: 56px; }
  .sa-why-label {
    display: inline-block; font-family: 'Satoshi', sans-serif; font-size: 11px;
    font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: #D4A931; margin-bottom: 16px;
  }
  .sa-why-header h2 { font-family: 'Fraunces', serif; font-size: clamp(30px, 3.5vw, 44px); font-weight: 700; color: #fff; line-height: 1.15; }
  .sa-why-header h2 em { font-style: italic; font-weight: 400; color: #D4A931; }
  .sa-why-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; background: #2D2D2D; }
  .sa-why-card {
    background: #1A1A1A; padding: 36px 28px; display: flex; flex-direction: column;
    gap: 14px; border-top: 2px solid transparent; transition: border-color 200ms ease;
  }
  .sa-why-card:hover { border-color: #D4A931; }
  .sa-why-num { font-family: 'Fraunces', serif; font-size: 36px; font-weight: 700; color: #2D2D2D; line-height: 1; }
  .sa-why-card h3 { font-family: 'Fraunces', serif; font-size: 20px; font-weight: 700; color: #fff; line-height: 1.2; }
  .sa-why-card p { font-family: 'Satoshi', sans-serif; font-size: 14px; color: rgba(255,255,255,0.55); line-height: 1.75; }

  /* ── SERVICES GRID ── */
  .sa-services { background: #F5F3EF; padding: 100px 0; border-top: 1px solid #D8D2C8; }
  .sa-services-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; }
  .sa-services-header { margin-bottom: 56px; }
  .sa-services-label {
    display: inline-block; font-family: 'Satoshi', sans-serif; font-size: 11px;
    font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: #D4A931; margin-bottom: 16px;
  }
  .sa-services-header h2 {
    font-family: 'Fraunces', serif; font-size: clamp(30px, 3.5vw, 44px);
    font-weight: 700; color: #1A1A1A; line-height: 1.15; margin-bottom: 14px;
  }
  .sa-services-header h2 em { font-style: italic; font-weight: 400; color: #D4A931; }
  .sa-services-sub { font-family: 'Satoshi', sans-serif; font-size: 16px; color: #4A4A4A; line-height: 1.75; max-width: 540px; }
