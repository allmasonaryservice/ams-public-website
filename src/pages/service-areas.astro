  <style is:global>
  .sa-tooltip {
    background: #1A1A1A !important; color: #D4A931 !important;
    border: 1px solid #D4A931 !important; border-radius: 0 !important;
    font-family: 'Satoshi', sans-serif !important; font-size: 11px !important;
    font-weight: 700 !important; letter-spacing: 0.05em !important;
    padding: 4px 8px !important; box-shadow: none !important; white-space: nowrap !important;
  }
  .sa-tooltip::before { border-top-color: #D4A931 !important; }
  #sapage-map .leaflet-control-zoom a {
    background: #1A1A1A !important; color: #D4A931 !important;
    border: 1px solid #D4A931 !important; border-radius: 0 !important;
  }
  #sapage-map .leaflet-control-zoom a:hover {
    background: #D4A931 !important; color: #1A1A1A !important;
  }
  #sapage-map .leaflet-control-zoom { border: none !important; }
  </style>

  <script is:inline define:vars={{ areasJson }}>
  (function () {
    var AREAS = JSON.parse(areasJson);

    /* ── MAP ── */
    function initSaPageMap() {
      var mapEl = document.getElementById('sapage-map');
      if (!mapEl || !window.L) return;
      var L = window.L;
      if (window.__saPageMap) { try { window.__saPageMap.remove(); } catch(e) {} window.__saPageMap = null; }
      if (mapEl._leaflet_id) { delete mapEl._leaflet_id; }
      var map = L.map('sapage-map', { center: [41.95, -87.85], zoom: 10, zoomControl: true, scrollWheelZoom: false, attributionControl: false });
      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', { maxZoom: 19 }).addTo(map);
      var goldIcon = L.divIcon({
        className: '',
        html: '<div style="width:12px;height:12px;background:#D4A931;border:2px solid #1A1A1A;"></div>',
        iconSize: [12, 12], iconAnchor: [6, 6],
      });
      AREAS.forEach(function (a) {
        L.marker([a.lat, a.lng], { icon: goldIcon })
          .bindTooltip(a.name, { permanent: false, direction: 'top', offset: [0, -10], className: 'sa-tooltip' })
          .on('click', function () { window.location.href = '/tuckpointing/' + a.slug; })
          .addTo(map);
      });
      window.__saPageMap = map;
    }

    function loadLeafletAndInit() {
      if (window.L) { initSaPageMap(); return; }
      var script = document.createElement('script');
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      script.onload = initSaPageMap;
      document.head.appendChild(script);
    }

    var mapSection = document.getElementById('samap-section');
    if (mapSection) {
      if (window.L) {
        initSaPageMap();
      } else {
        var obs = new IntersectionObserver(function (entries) {
          if (entries[0].isIntersecting) { obs.disconnect(); loadLeafletAndInit(); }
        }, { rootMargin: '200px' });
        obs.observe(mapSection);
      }
    }

    document.addEventListener('astro:page-load', function () {
      if (window.L && document.getElementById('sapage-map')) { initSaPageMap(); }
    });

    /* ── FAQ ── */
    document.querySelectorAll('.sa-faq-q').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var idx = this.getAttribute('data-faq');
        var body = document.getElementById('faq-body-' + idx);
        var open = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', open ? 'false' : 'true');
        body.hidden = open;
      });
    });
  })();
  </script>

