---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Masonry FAQ — 100+ Questions Answered for Chicagoland Homeowners | All Masonry Services"
  description="Every tuckpointing, brick repair, chimney, and masonry question Chicagoland homeowners ask — answered by the crew that's fixed 500+ homes since 2007. Free estimates."
  canonical="https://allmasonryservices.com/faq"
>

  <!-- ═══ HERO ═══ -->
  <section class="fqs-hero" aria-label="FAQ hero">
    <div class="fqs-container">
      <div class="fqs-hero-badges">
        <span class="fqs-badge fqs-badge--gold">&#9733; 4.8 &middot; 92 Reviews</span>
        <span class="fqs-badge fqs-badge--outline">19+ Years</span>
        <span class="fqs-badge fqs-badge--outline">Licensed &amp; Insured</span>
      </div>
      <h1 class="fqs-hero-h1">Every Masonry Question<br /><em>Chicagoland Homeowners Ask.</em><br />Answered.</h1>
      <p class="fqs-hero-sub">Stop guessing what's wrong with your brick. 100+ questions answered by the crew that's fixed 500+ Chicagoland homes since 2007.</p>
      <div class="fqs-hero-stats">
        <div class="fqs-stat"><span class="fqs-stat-num">100+</span><span class="fqs-stat-lbl">Q&amp;A</span></div>
        <div class="fqs-stat-div" aria-hidden="true"></div>
        <div class="fqs-stat"><span class="fqs-stat-num">16</span><span class="fqs-stat-lbl">Services</span></div>
        <div class="fqs-stat-div" aria-hidden="true"></div>
        <div class="fqs-stat"><span class="fqs-stat-num">19</span><span class="fqs-stat-lbl">Cities</span></div>
        <div class="fqs-stat-div" aria-hidden="true"></div>
        <div class="fqs-stat"><span class="fqs-stat-num">Free</span><span class="fqs-stat-lbl">Estimates</span></div>
      </div>
    </div>
  </section>

  <!-- ═══ TRUST STRIP ═══ -->
  <section class="fqs-trust" aria-label="Trust signals">
    <div class="fqs-container fqs-trust-inner">
      <div class="fqs-trust-item">
        <span class="fqs-trust-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" stroke-linecap="square"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        </span>
        <div><span class="fqs-trust-title">No Subcontractors</span><span class="fqs-trust-desc">Our crew on every job</span></div>
      </div>
      <div class="fqs-trust-div" aria-hidden="true"></div>
      <div class="fqs-trust-item">
        <span class="fqs-trust-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" stroke-linecap="square"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </span>
        <div><span class="fqs-trust-title">Free Written Estimates</span><span class="fqs-trust-desc">No verbal-only quotes</span></div>
      </div>
      <div class="fqs-trust-div" aria-hidden="true"></div>
      <div class="fqs-trust-item">
        <span class="fqs-trust-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" stroke-linecap="square"><rect x="3" y="4" width="18" height="18" rx="0" ry="0"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </span>
        <div><span class="fqs-trust-title">19+ Years Experience</span><span class="fqs-trust-desc">Serving Chicagoland since 2007</span></div>
      </div>
      <div class="fqs-trust-div" aria-hidden="true"></div>
      <div class="fqs-trust-item">
        <span class="fqs-trust-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D4A931" stroke-width="2" stroke-linecap="square"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </span>
        <div><span class="fqs-trust-title">Licensed &amp; Insured</span><span class="fqs-trust-desc">Fully covered on every project</span></div>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ BODY ═══ -->
  <section class="fqs-body" aria-label="Frequently asked questions">
    <div class="fqs-container fqs-body-wrap">

      <!-- SIDEBAR -->
      <nav class="fqs-sidebar" aria-label="FAQ categories">
        <a href="#common-problems" class="sidebar-link active">Common Problems</a>
        <a href="#tuckpointing" class="sidebar-link">Tuckpointing</a>
        <a href="#brick-repair" class="sidebar-link">Brick Repair</a>
        <a href="#chimney-repair" class="sidebar-link">Chimney Repair</a>
        <a href="#masonry-repair" class="sidebar-link">Masonry Repair</a>
        <a href="#concrete-services" class="sidebar-link">Concrete Services</a>
        <a href="#stone-masonry" class="sidebar-link">Stone Masonry</a>
        <a href="#power-washing" class="sidebar-link">Power Washing</a>
        <a href="#commercial-masonry" class="sidebar-link">Commercial Masonry</a>
        <a href="#historic-restoration" class="sidebar-link">Historic Restoration</a>
        <a href="#limestone-restoration" class="sidebar-link">Limestone Restoration</a>
        <a href="#lintel-repair" class="sidebar-link">Lintel Repair</a>
        <a href="#parapet-wall-repair" class="sidebar-link">Parapet Wall Repair</a>
        <a href="#retaining-wall-repair" class="sidebar-link">Retaining Wall Repair</a>
        <a href="#brick-paving" class="sidebar-link">Brick Paving</a>
        <a href="#masonry-waterproofing" class="sidebar-link">Masonry Waterproofing</a>
        <a href="#foundation-repair" class="sidebar-link">Foundation Repair</a>
        <a href="#gap-stoop-repair" class="sidebar-link">Gap &amp; Stoop Repair</a>
        <a href="#free-tools" class="sidebar-link">Free Tools</a>
        <a href="#how-we-work" class="sidebar-link">How We Work</a>
        <a href="#chicago" class="sidebar-link">Chicago</a>
        <a href="#hinsdale" class="sidebar-link">Hinsdale</a>
        <a href="#winnetka" class="sidebar-link">Winnetka</a>
        <a href="#evanston" class="sidebar-link">Evanston</a>
        <a href="#oak-brook" class="sidebar-link">Oak Brook</a>
        <a href="#wilmette" class="sidebar-link">Wilmette</a>
        <a href="#kenilworth" class="sidebar-link">Kenilworth</a>
        <a href="#glencoe" class="sidebar-link">Glencoe</a>
        <a href="#highland-park" class="sidebar-link">Highland Park</a>
        <a href="#northbrook" class="sidebar-link">Northbrook</a>
        <a href="#elmhurst" class="sidebar-link">Elmhurst</a>
        <a href="#western-springs" class="sidebar-link">Western Springs</a>
        <a href="#la-grange" class="sidebar-link">La Grange</a>
        <a href="#naperville" class="sidebar-link">Naperville</a>
        <a href="#downers-grove" class="sidebar-link">Downers Grove</a>
        <a href="#burr-ridge" class="sidebar-link">Burr Ridge</a>
        <a href="#clarendon-hills" class="sidebar-link">Clarendon Hills</a>
        <a href="#willowbrook" class="sidebar-link">Willowbrook</a>
        <a href="#wheaton" class="sidebar-link">Wheaton</a>
      </nav>

      <!-- FAQ SECTIONS -->
      <div class="fqs-sections">

        <!-- COMMON PROBLEMS -->
        <section class="fqs-section" id="common-problems" aria-label="Common masonry problems">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Common Masonry Problems &mdash; What's Happening to Your Brick</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">My mortar joints are crumbling. How urgent is it?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Urgent &mdash; every Chicago winter makes it worse. Freeze-thaw forces water into failing joints, expanding them with every cycle. Tuckpointing now costs 3&ndash;5&times; less than the structural repair you'll need after two more winters. If you can scrape mortar out with a key, call today.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">There's white powder on my brick. Should I be worried?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Yes &mdash; that's efflorescence, and it's a water migration signal, not just a stain. Mineral salts reach the surface because water is moving through your masonry. We find the source, fix it, then address the staining &mdash; so it doesn't return in six months.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">I see cracks forming between my brick and mortar. What does that mean?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>It means the bond has failed and water has a direct path inside. In Chicagoland, that crack will be 3&times; wider by spring. Repointing now seals it before the next freeze-thaw cycle turns a $400 repair into a $3,000 wall rebuild. <a href="/services/masonry-repair" class="fqs-inline-link">Learn about masonry repair</a>.</p>
            </div>
          </div>
        </section>

        <!-- TUCKPOINTING -->
        <section class="fqs-section" id="tuckpointing" aria-label="Tuckpointing FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Tuckpointing FAQ &mdash; Chicago, North Shore &amp; Western Suburbs</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">What exactly is tuckpointing and do I actually need it?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Tuckpointing means removing deteriorated mortar and packing fresh mortar to spec &mdash; it's the single most important maintenance job on any masonry structure. If your mortar is more than 25 years old in Chicagoland, it's likely failing whether you can see it or not.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">How much does tuckpointing cost in Chicago?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Tuckpointing in Chicago typically runs $8&ndash;$25 per linear foot depending on access, joint depth, and mortar condition. Full facade work on a 3-flat runs $3,000&ndash;$12,000. We provide written estimates after a free on-site assessment &mdash; we don't quote over photos.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">How long does tuckpointing last in Chicago's climate?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Done correctly with matched mortar composition, tuckpointing holds 20&ndash;30 years in Chicagoland. Done incorrectly &mdash; wrong mortar hardness, wrong joint profile &mdash; it fails in 3&ndash;5 years and damages the surrounding brick. We match original composition and profile every time. <a href="/services/tuckpointing" class="fqs-inline-link">Learn about tuckpointing</a>.</p>
            </div>
          </div>
        </section>

        <!-- BRICK REPAIR -->
        <section class="fqs-section" id="brick-repair" aria-label="Brick repair FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Brick Repair FAQ &mdash; Hinsdale, Oak Park &amp; Chicagoland</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">One brick fell out. Can I just replace that one brick?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Possibly &mdash; but a single failed brick almost always signals a larger moisture or settling pattern nearby. We assess the surrounding structure before touching anything, then match the brick color, size, and mortar blend so the repair is invisible.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">My brick is spalling (surface flaking off). Is it structural?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Spalling is a freeze-thaw problem and it escalates fast. Once the face of a brick breaks away, water enters the porous core and the damage accelerates through every winter cycle. Early spalling repair is cosmetic. Late-stage spalling becomes a full wythe replacement &mdash; 10&times; the cost.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">Can you match old brick that's no longer manufactured?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Yes &mdash; we source salvage brick and regional suppliers who carry historic grades. On 1920s&ndash;1960s homes across Oak Park, Hinsdale, and the North Shore, we've matched dozens of discontinued profiles. The repair should be invisible, not a patch job. <a href="/services/brick-repair" class="fqs-inline-link">Learn about brick repair</a>.</p>
            </div>
          </div>
        </section>

        <!-- CHIMNEY REPAIR -->
        <section class="fqs-section" id="chimney-repair" aria-label="Chimney repair FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Chimney Repair FAQ &mdash; Chicago &amp; North Shore Homeowners</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">My chimney cap is cracked. How serious is that?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Very serious &mdash; a cracked chimney cap is the #1 water entry point for your flue. Most homeowners ignore it because it looks minor from the ground. A $400 cap repair now prevents a $6,000&ndash;$10,000 chimney rebuild in 2&ndash;3 years. We see this progression on homes across Winnetka, Evanston, and Chicago every season.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">Do I need a full chimney rebuild or just repairs?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Usually repairs &mdash; we give you an honest scope, not the most expensive option. Crown repair, flashing replacement, and tuckpointing the chimney stack covers most cases. Full rebuilds above the roofline are needed when bricks have shifted, the liner is compromised, or water damage has penetrated the structure.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">When is the best time to repair a chimney in Chicago?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Late summer through fall &mdash; before the freeze-thaw season begins. Mortar cures best above 40&deg;F and needs time to fully set before the first freeze. Spring is also good if you missed fall. Never delay into winter &mdash; one freeze-thaw cycle in a compromised chimney can push a repair into a rebuild. <a href="/services/chimney-repair" class="fqs-inline-link">Learn about chimney repair</a>.</p>
            </div>
          </div>
        </section>

        <!-- MASONRY REPAIR -->
        <section class="fqs-section" id="masonry-repair" aria-label="Masonry repair FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Masonry Repair FAQ &mdash; Structural &amp; Cosmetic Work in Chicagoland</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">How do I know if my masonry damage is structural or cosmetic?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>If cracks run diagonally, walls bow outward, or mortar is missing in multiple joints in the same area &mdash; it's structural. Hairline cracks in a single location are usually cosmetic. We assess both and tell you honestly which category you're in &mdash; no upselling.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">What's the difference between cosmetic and structural masonry repair?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Cosmetic repair addresses surface deterioration &mdash; spalling, staining, efflorescence, isolated joint failure. Structural repair addresses load-bearing failure &mdash; bowing walls, failed lintels, foundation cracks, or chimney separation. The cost difference is significant. Knowing which you have before calling any contractor is why we built our free diagnostic tools.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">Will my insurance cover masonry repair?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Sometimes &mdash; sudden damage from storms, falling objects, or vehicle impact is typically covered. Gradual deterioration from deferred maintenance is not. We provide detailed written documentation of damage scope and cause that you can submit to your insurer directly. <a href="/services/masonry-repair" class="fqs-inline-link">Learn about masonry repair</a>.</p>
            </div>
          </div>
        </section>

        <!-- CONCRETE SERVICES -->
        <section class="fqs-section" id="concrete-services" aria-label="Concrete services FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Concrete Services FAQ &mdash; Chicago &amp; Western Suburbs</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">My concrete driveway has cracks. Repair or replace?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Depends on the crack pattern. Hairline cracks under 1/4" wide with no vertical displacement &mdash; repair and seal. Wide cracks, significant heaving, or crumbling edges &mdash; replacement is more cost-effective long-term. We give you an honest assessment, not a default recommendation to replace everything.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">Can concrete be poured in Chicago winters?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>We don't pour in freezing temperatures &mdash; concrete cures through a chemical process that stops below 40&deg;F. We use heated enclosures for late-season pours when needed, but scheduling concrete work April through October gives you the best result and eliminates cold-weather risk.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">How long does concrete last in Chicagoland?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Properly poured and sealed concrete lasts 30&ndash;50 years in Chicago's climate. The enemy is water infiltration and freeze-thaw cycling, which is why joint sealing and surface sealing matter. We include sealing recommendations with every concrete project. <a href="/services/concrete-services" class="fqs-inline-link">Learn about concrete services</a>.</p>
            </div>
          </div>
        </section>

        <!-- STONE MASONRY -->
        <section class="fqs-section" id="stone-masonry" aria-label="Stone masonry FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Stone Masonry FAQ &mdash; Limestone, Bluestone &amp; Natural Stone in Chicagoland</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">Can you repair natural stone without replacing it?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>In most cases, yes. Stone is far more durable than the mortar around it &mdash; most stone masonry repair is repointing failed joints, not replacing the stone itself. When stone is cracked or spalled, we match the original material and profile as closely as possible.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">I have a limestone facade. What do I need to know?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Limestone is common on Chicago and North Shore homes built between 1890 and 1950. It's soft, it stains, and it reacts badly to Portland-heavy mortar. We use lime-based mortars that flex with the stone instead of locking against it &mdash; the wrong mortar accelerates limestone deterioration.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">What's the cost of stone masonry repair in Chicago?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Stone repair ranges from $500 for isolated joint repair to $15,000+ for full facade repointing on a large historic structure. Material sourcing is the variable &mdash; salvage matching limestone or bluestone takes time but is the only way to make the repair invisible. <a href="/services/stone-masonry" class="fqs-inline-link">Learn about stone masonry</a>.</p>
            </div>
          </div>
        </section>

        <!-- POWER WASHING -->
        <section class="fqs-section" id="power-washing" aria-label="Power washing FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Power Washing FAQ &mdash; Brick &amp; Masonry Cleaning in Chicagoland</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">Is power washing safe for brick and masonry?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>At the wrong pressure, no &mdash; high PSI strips the face from soft brick and drives water into joints. We use low-pressure soft washing for masonry &mdash; typically under 500 PSI &mdash; which removes dirt, algae, and staining without damaging the surface or compromising mortar joints.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">Will power washing remove efflorescence from my brick?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Washing removes the white deposit, but without fixing the water source, it returns within months. We combine soft washing with a masonry-specific cleaning solution and then address the underlying water migration &mdash; so you're not washing the same wall every spring.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">How often should I have my masonry cleaned?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Every 3&ndash;5 years for most Chicagoland homes, or after any major water event. North-facing walls and areas under overhanging trees accumulate algae and moisture faster. Regular cleaning also lets us spot early mortar failure before it becomes expensive. <a href="/services/power-washing" class="fqs-inline-link">Learn about power washing</a>.</p>
            </div>
          </div>
        </section>

        <!-- COMMERCIAL MASONRY -->
        <section class="fqs-section" id="commercial-masonry" aria-label="Commercial masonry FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Commercial Masonry FAQ &mdash; Chicago Office, Retail &amp; Multi-Family Buildings</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">Do you work on commercial buildings and multi-family properties?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Yes &mdash; we work on 2-flats through mid-rise commercial buildings. We're experienced with occupied buildings, working around business hours, and coordinating with property managers. Our crew handles commercial scope without subcontracting any part of the work.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">What commercial masonry services do you provide?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Full facade tuckpointing, brick replacement, lintel repair, parapet wall restoration, chimney work, concrete flatwork, and historic restoration. We provide detailed written scopes and timelines &mdash; required for commercial property management and insurance documentation.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">How do you handle commercial projects with tenants in the building?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>We schedule around occupancy, use dust containment where required, and coordinate access with your property manager directly. We've worked on occupied 3-flats and commercial storefronts throughout Chicago and the western suburbs without disrupting business operations. <a href="/services/commercial-masonry" class="fqs-inline-link">Learn about commercial masonry</a>.</p>
            </div>
          </div>
        </section>

        <!-- HISTORIC RESTORATION -->
        <section class="fqs-section" id="historic-restoration" aria-label="Historic restoration FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Historic Masonry Restoration FAQ &mdash; Pre-War Homes &amp; Landmark Buildings</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">Why does historic masonry require different techniques?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Pre-1950 masonry used softer brick and lime-based mortar designed to flex and breathe. Modern Portland cement mortar is harder than historic brick &mdash; it locks the wall rigid, cracks the surrounding brick, and traps moisture inside. We use period-appropriate materials because the wrong repair causes more damage than the original problem.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">Do you work with historic preservation requirements?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Yes &mdash; we understand Illinois historic preservation standards and have worked on properties subject to local landmark review. If your home or building is in a historic district, we can advise on what materials and methods are acceptable before you apply for permits.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">Can you match 100-year-old mortar and brick on a North Shore estate?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Yes &mdash; this is one of our specialties. We've matched original mortar profiles and brick grades on homes built as far back as 1892 across Winnetka, Kenilworth, Lake Forest, and Glencoe. The repair should be invisible in 6 months as the materials weather to match. <a href="/services/historic-restoration" class="fqs-inline-link">Learn about historic restoration</a>.</p>
            </div>
          </div>
        </section>

        <!-- LIMESTONE RESTORATION -->
        <section class="fqs-section" id="limestone-restoration" aria-label="Limestone restoration FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Limestone Restoration FAQ &mdash; Chicago &amp; North Shore Historic Properties</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">My limestone steps are crumbling at the edges. What's happening?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Edge spalling on limestone steps is a freeze-thaw problem &mdash; water infiltrates the porous stone, freezes, and breaks away the face. Once started, it accelerates with every winter. Early repair is a consolidation and fill. Late-stage means step replacement. Don't wait another season.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">Can you restore the color and surface of stained limestone?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Yes &mdash; we use pH-neutral masonry cleaners designed for limestone (never acid-based, which etches the surface). For deep staining, poultice treatment pulls contamination out of the porous stone. Full color restoration isn't always possible on heavily weathered limestone, but we'll give you an honest assessment before starting.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">How do you repair cracked limestone without replacing it?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>For stable cracks without movement, we use lime-based consolidant and matching limestone dust fill. For active cracks showing ongoing movement, we address the underlying structural issue first &mdash; otherwise the repair fails within a season. Patching active cracks without fixing the cause is money wasted. <a href="/services/limestone-restoration" class="fqs-inline-link">Learn about limestone restoration</a>.</p>
            </div>
          </div>
        </section>

        <!-- LINTEL REPAIR -->
        <section class="fqs-section" id="lintel-repair" aria-label="Lintel repair FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Lintel Repair FAQ &mdash; Chicago Window &amp; Door Opening Masonry</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">What is a lintel and how do I know if mine is failing?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>A lintel is the structural beam &mdash; steel, stone, or concrete &mdash; that spans your window and door openings and carries the masonry above. Failing lintels show as diagonal cracks radiating from the corners of openings, or bricks that are visibly dropping or separating above windows. This is structural &mdash; don't wait.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">How much does lintel replacement cost in Chicago?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Steel lintel replacement typically runs $800&ndash;$2,500 per opening depending on size and access. The masonry above needs to be carefully shored, the failed lintel removed, and the opening rebuilt after the new lintel is set. Ignoring a failed lintel can result in masonry collapse above the opening.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">Can you replace a lintel without tearing out all the surrounding brick?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>In most cases, yes &mdash; we carefully remove only the brick immediately above the opening, replace the lintel, and rebuild the surrounding masonry to match. The repair is typically invisible within a season as the new mortar weathers to match. <a href="/services/lintel-repair" class="fqs-inline-link">Learn about lintel repair</a>.</p>
            </div>
          </div>
        </section>

        <!-- PARAPET WALL REPAIR -->
        <section class="fqs-section" id="parapet-wall-repair" aria-label="Parapet wall repair FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Parapet Wall Repair FAQ &mdash; Chicago Flat-Roof Buildings</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">My parapet wall is leaning. How serious is that?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Extremely serious &mdash; a leaning parapet is a falling masonry risk. Parapet walls on Chicago flat-roof buildings are exposed to freeze-thaw from both sides and are often the first masonry on a building to fail. A leaning parapet requires immediate assessment. This is a life-safety issue.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">Why do parapet walls fail so often in Chicago?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Parapet walls are fully exposed &mdash; no roof overhang protection, freeze-thaw on all sides, and often the last masonry on a building to be maintained. Most parapet failures we see on Chicago 2-flats and 3-flats are the result of 10&ndash;20 years of deferred tuckpointing finally reaching structural failure.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">What does parapet wall repair involve?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Depending on severity: tuckpointing and cap repair for early-stage deterioration, partial rebuilding for leaning or separated sections, or full parapet rebuild for collapsed or severely compromised walls. We assess, give you a written scope, and rebuild to match the original profile. <a href="/services/parapet-wall-repair" class="fqs-inline-link">Learn about parapet wall repair</a>.</p>
            </div>
          </div>
        </section>

        <!-- RETAINING WALL REPAIR -->
        <section class="fqs-section" id="retaining-wall-repair" aria-label="Retaining wall repair FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Retaining Wall Repair FAQ &mdash; Chicago &amp; Western Suburbs</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">My retaining wall is bulging outward. What's causing it?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Hydrostatic pressure &mdash; water building up behind the wall with nowhere to drain. Bulging means the wall is approaching failure. Left unaddressed, it will collapse. We assess drainage first, then determine whether the wall can be repaired or needs to be rebuilt with proper drainage installed behind it.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">Can a bulging retaining wall be pushed back and repaired?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Only if the structural integrity is intact and the movement is recent. Once masonry has shifted significantly, the mortar bonds are broken and the wall needs to be taken down and rebuilt with corrected drainage. A wall that's collapsed once will collapse again without fixing the drainage cause.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">What's the lifespan of a properly built masonry retaining wall?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>40&ndash;60 years with proper drainage and periodic tuckpointing. The two killers are water behind the wall (no weep holes or drainage aggregate) and deferred mortar maintenance. We build retaining walls with drainage aggregate backfill and weep holes standard. <a href="/services/retaining-wall-repair" class="fqs-inline-link">Learn about retaining wall repair</a>.</p>
            </div>
          </div>
        </section>

        <!-- BRICK PAVING -->
        <section class="fqs-section" id="brick-paving" aria-label="Brick paving FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Brick Paving FAQ &mdash; Chicago Driveways, Patios &amp; Walkways</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">My brick paver driveway is sinking in sections. What's the fix?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Sunken pavers are almost always a base failure &mdash; the compacted gravel base has settled or washed out. The pavers come up, base is re-graded and recompacted, and pavers go back down. If the pavers themselves are intact, this is relatively straightforward and far cheaper than full replacement.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">Can brick pavers handle Chicago winters?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Yes &mdash; properly installed clay brick pavers are more freeze-thaw resistant than concrete because they flex as a system rather than cracking as a slab. The key is proper base preparation and joint sand that locks the system together. Poorly installed pavers will shift and sink within 2&ndash;3 winters.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">How do you match existing brick pavers for repair?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>We maintain relationships with salvage suppliers who carry discontinued paver grades. For recent installations, we can often source from the same manufacturer. For older installations, salvage matching is the only option &mdash; and we've matched 80-year-old Chicago street-grade pavers before. <a href="/services/brick-paving" class="fqs-inline-link">Learn about brick paving</a>.</p>
            </div>
          </div>
        </section>

        <!-- MASONRY WATERPROOFING -->
        <section class="fqs-section" id="masonry-waterproofing" aria-label="Masonry waterproofing FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Masonry Waterproofing FAQ &mdash; Chicago &amp; Chicagoland Homes</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">Should I waterproof my brick exterior?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>It depends on the product and your specific situation. Breathable silane/siloxane sealers are appropriate for most Chicagoland brick &mdash; they repel water while allowing vapor to escape. Film-forming sealers trap moisture inside and accelerate spalling. Never let a contractor apply a film sealer to your historic brick.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">Will waterproofing stop my basement from getting wet?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Exterior waterproofing is one component of a wet basement solution, but rarely the only one. We assess whether water is entering through wall permeation, failed joints, or at the footing level &mdash; the fix depends on the source. Applying sealer to a wall with failed mortar joints is money wasted.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">How long does masonry waterproofing last?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Quality silane/siloxane sealers last 7&ndash;10 years in Chicago's climate before reapplication. We apply after thorough cleaning and after any mortar repair is complete &mdash; sealing over failing joints locks the problem in. <a href="/services/masonry-waterproofing" class="fqs-inline-link">Learn about masonry waterproofing</a>.</p>
            </div>
          </div>
        </section>

        <!-- FOUNDATION REPAIR -->
        <section class="fqs-section" id="foundation-repair" aria-label="Foundation repair FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Foundation &amp; Basement Masonry FAQ &mdash; Chicago Block &amp; Brick Foundations</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">I see cracks in my foundation wall. How serious is it?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Depends on the crack type. Hairline vertical cracks are usually shrinkage &mdash; low concern. Horizontal cracks in block foundations indicate lateral pressure &mdash; serious, act immediately. Stair-step cracks in brick foundations indicate differential settlement &mdash; assess urgently. We look at crack width, direction, and whether it's active before recommending any repair.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">Can a cracked masonry foundation be repaired without underpinning?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>In most cases, yes. Crack injection, wall anchors, and carbon fiber straps can stabilize a foundation without the disruption and cost of underpinning. We assess first and recommend the minimum effective intervention &mdash; not the most expensive option.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">How do I know if my foundation crack is getting worse?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Mark the ends of the crack with pencil and the date. Check it monthly. If it's growing &mdash; especially if it's widening at the top &mdash; it's active and needs immediate assessment. Stable cracks that haven't moved in 12+ months are typically old settlement that's complete. Active cracks are a different situation. <a href="/services/foundation-repair" class="fqs-inline-link">Learn about foundation repair</a>.</p>
            </div>
          </div>
        </section>

        <!-- GAP & STOOP REPAIR -->
        <section class="fqs-section" id="gap-stoop-repair" aria-label="Gap and stoop repair FAQ">
          <div class="fqs-head">
            <div class="fqs-accent" aria-hidden="true"></div>
            <h2 class="fqs-h2">Gap &amp; Stoop Repair FAQ &mdash; Chicago Front Steps &amp; Entry Masonry</h2>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">01</span>
              <span class="fq-q-text">There's a growing gap between my front steps and the house. What's happening?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>The stoop is settling away from the foundation &mdash; this is extremely common on Chicago homes. The steps are on their own footing, which moves independently from the house foundation. The gap opens every year. Left unaddressed, it becomes a water entry point directly against your foundation wall.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">02</span>
              <span class="fq-q-text">Can the gap between my stoop and house be just filled and sealed?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>Temporarily. Filling the gap without addressing the settling just delays the problem &mdash; the sealant tears open within 1&ndash;2 winters as movement continues. The permanent fix is tying the stoop back to the structure or rebuilding on an improved footing. We tell you which applies to your situation.</p>
            </div>
          </div>
          <div class="fq-item">
            <button class="fq-trigger" type="button" aria-expanded="false">
              <span class="fq-num" aria-hidden="true">03</span>
              <span class="fq-q-text">My front steps are pulling away and crumbling. Repair or replace?</span>
              <span class="fq-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></span>
            </button>
            <div class="fq-answer" hidden>
              <p>If the structure is sound but surface is damaged &mdash; repair. If the footing has failed, the steps have significant settlement, or multiple bricks are loose &mdash; replacement is the better long-term value. A rebuilt stoop done correctly lasts 40+ years. A patched failing stoop is a bill you'll pay again in 3&ndash;5 years. <a href="/services/gap-stoop-repair" class="fqs-inline-link">Learn about gap and stoop repair</a>.</p>
            </div>
          </div>
        </section>

